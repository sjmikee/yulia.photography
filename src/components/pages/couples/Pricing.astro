---
import { localeFromPath, translatedPath } from '~/i18n/routes';
import { couplesMessages } from '~/i18n/couples';
import { getCouples } from '~/lib/couples';
const locale = localeFromPath(Astro.url.pathname);
const t = couplesMessages('pricing', locale);
const link = (path: string) => translatedPath(path, locale) ?? path;
const {
  packages: couplesPackages,
  journey: couplesJourney,
  service: couplesService,
  whatsapp: couplesWhatsApp,
  cards: couplesPricingCards,
} = getCouples(locale);
const couplesGalleryImages = getCouplesGalleryImages(locale);
const hero = couplesGalleryImages[0];
const couplesFeaturedImages = couplesGalleryImages.slice(0, 3);
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import PackageComparison from '~/components/photoshoots/PackageComparison.astro';
import PricingCards from '~/components/ui/PricingCards.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { getCouplesGalleryImages } from '~/lib/couples-gallery';
// Keep the established pricing URL, title and H1.
const metadata = {
  title: t('metaTitle'),
  description: t('metaDescription', couplesPackages.map((p) => p.price).join(', ')),
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/couples_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: link('/pricing'), name: t('pricesLabel') },
  { url: link('/pricing/couples'), name: t('pageLabel') },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={couplesService} />
  <LeadTracking service="couples">
    <HeroText
      tagline={t('tagline')}
      title={t('title')}
      subtitle={t('subtitle', couplesPackages[0].price)}
      content={t('introduction')}
      callToAction={{ text: t('compareAction'), href: '#packages' }}
      callToAction2={{
        text: t('dateAction'),
        href: couplesWhatsApp(),
        target: '_blank',
        'data-lead-source': 'couples-pricing-hero',
      }}
    />
    <Breadcrumbs
      items={[
        { label: t('homeLabel'), href: link('/') },
        { label: t('pricesBreadcrumb'), href: link('/pricing') },
        { label: t('pageBreadcrumb') },
      ]}
    />
    <section class="mx-auto max-w-4xl space-y-4 px-4 py-8">
      <h2 class="text-2xl font-bold">{t('overviewTitle')}</h2>
      <p>
        <strong
          >{t('pricePrefix')}
          {couplesPackages[0].price}
          {t('priceSeparator')}{couplesPackages[2].price}
          {t('currencySentence')}</strong
        >
        {t('choiceIntro')}
      </p>
      <p>{t('locationIntro')}</p>
    </section>
    <Journey journey={couplesJourney} current="pricing" />
    <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
      <h2 class="mb-4 text-center text-3xl font-bold">{t('packagesTitle')}</h2>
      <p class="mb-8 text-center">{t('packagesNote')}</p>
      <PackageComparison
        packages={[...couplesPackages].reverse()}
        label={t('comparisonLabel')}
        caption={t('comparisonCaption')}
      />
      <div class="mt-8"><PricingCards prices={couplesPricingCards} /></div>
    </section>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-2xl font-bold">{t('selectionTitle')}</h2>
      <p>
        <strong>{t('basicName')}</strong>
        {t('basicBody')}
        <strong>{t('classicName')}</strong>
        {t('classicBody')}
        <strong>{t('premiumName')}</strong>
        {t('premiumBody')}
      </p>
      <p>{t('choiceBody')}</p>
      <h2 class="text-2xl font-bold">{t('inclusionsTitle')}</h2>
      <p>{t('inclusionsBody')}</p>
      <p>{t('exclusionsBody')}</p>
      <p>
        {t('servicePrompt')}
        <a class="font-semibold underline" href={link('/services/couples-photography')}>{t('serviceLink')}</a>.
      </p>
    </section>
    <section id="booking" class="scroll-mt-28 mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">{t('bookingTitle')}</h2>
      <ol class="list-decimal space-y-4 ps-6">
        <li><strong>{t('planningTitle')}</strong> {t('planningBody')}</li>
        <li><strong>{t('depositTitle')}</strong> {t('depositBody')}</li>
        <li>
          <strong>{t('deliveryTitle')}</strong>
          {t('deliveryBody')}
        </li>
      </ol>
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">{t('changesTitle')}</h3>
        <p>{t('changesBody')}</p>
      </div>
    </section>
    <section class="mx-auto max-w-5xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">{t('galleryTitle')}</h2>
      <p>{t('galleryIntro')}</p>
      <Gallery images={couplesFeaturedImages} />
      <p>
        <a class="font-semibold underline" href={link('/gallery/couples')}>{t('galleryLink')}</a> · <a
          class="underline"
          href={link('/about')}>{t('aboutLink')}</a
        >
      </p>
    </section>
    <section id="reviews" class="mx-auto max-w-3xl px-4 py-10">
      <h2 class="mb-4 text-3xl font-bold">{t('reviewTitle')}</h2>
      <p class="mb-6 text-sm text-muted">{t('reviewNote')}</p>
      <blockquote class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <p>{t('reviewQuote')}</p><footer class="mt-4 font-semibold">{t('reviewName')}</footer>
      </blockquote>
    </section>
    <FAQs
      title={t('faqTitle')}
      columns={2}
      items={[
        {
          title: t('experienceQuestion'),
          description: t('experienceAnswer'),
        },
        {
          title: t('studioQuestion'),
          description: t('studioAnswer'),
        },
        {
          title: t('quantityQuestion'),
          description: t(
            'quantityAnswer',
            couplesPackages[0].photos,
            couplesPackages[1].photos,
            couplesPackages[2].photos
          ),
        },
        {
          title: t('deliveryQuestion'),
          description: t('deliveryAnswer'),
        },
        {
          title: t('giftQuestion'),
          description: t('giftAnswer'),
        },
        {
          title: t('depositQuestion'),
          description: t('depositAnswer'),
        },
      ]}
    />
    <p class="mx-auto max-w-4xl px-4 text-center">
      {t('intimatePrompt')}
      <a class="underline" href={link('/pricing/couples-intimate')}>{t('intimateLink')}</a>.
    </p>
    <Journey journey={couplesJourney} current="pricing" cta />
  </LeadTracking>
</Layout>
