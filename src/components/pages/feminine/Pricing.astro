---
import { localeFromPath, translatedPath } from '~/i18n/routes';
import { feminineMessages } from '~/i18n/feminine';
import { getFeminine } from '~/lib/feminine';
import { getFeminineGallery } from '~/lib/feminine-gallery';
const locale = localeFromPath(Astro.url.pathname);
const t = feminineMessages('pricing', locale);
const link = (path: string) => translatedPath(path, locale) ?? path;
const {
  packages: femininePackages,
  journey: feminineJourney,
  service: feminineService,
  whatsapp: feminineWhatsApp,
  cards: femininePricingCards,
} = getFeminine(locale);
const { featured: feminineFeaturedImages } = getFeminineGallery(locale);
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import PackageComparison from '~/components/photoshoots/PackageComparison.astro';
import PricingCards from '~/components/ui/PricingCards.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import preview from '~/assets/feminine_gallery/feminine_pricing.jpg';
const metadata = {
  title: t('metaTitle', femininePackages[0].price),
  description: t('metaDescription', femininePackages.map((p) => p.price).join(', ')),
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/feminine_gallery/feminine_pricing.jpg',
        width: preview.width,
        height: preview.height,
        alt: t('previewAlt'),
      },
    ],
  },
};
const breadcrumbs = [
  { url: link('/pricing'), name: t('pricesLabel') },
  { url: link('/pricing/feminine'), name: t('pageLabel') },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={feminineService} />
  <HeroText
    tagline={t('tagline')}
    title={t('title')}
    subtitle={t('subtitle', femininePackages[0].price)}
    content={t('introduction')}
    callToAction={{ text: t('compareAction'), href: '#packages' }}
    callToAction2={{ text: t('dateAction'), href: feminineWhatsApp(), target: '_blank' }}
  />
  <Breadcrumbs
    items={[
      { label: t('homeLabel'), href: link('/') },
      { label: t('pricesBreadcrumb'), href: link('/pricing') },
      { label: t('pageBreadcrumb') },
    ]}
  />
  <section class="mx-auto max-w-4xl space-y-5 px-4 py-8 text-start">
    <h2 class="text-2xl font-bold">{t('overviewTitle')}</h2>
    <p>
      <strong
        >{t('pricePrefix')}
        {femininePackages[0].price}
        {t('priceSeparator')}{femininePackages[2].price}
        {t('currency')}</strong
      >
      {t('quantitiesIntro')}
      {femininePackages[0].photos}
      {t('basicPhotosSuffix')}
      {femininePackages[1].photos}
      {t('classicPhotosSuffix')}{femininePackages[2].photos}
      {t('premiumPhotosSuffix')}
    </p>
    <p>{t('styleBody')}</p>
    <p>
      {t('galleryPrompt')}
      <a class="font-semibold underline" href={link('/gallery/feminine')}>{t('galleryLink')}</a>
      {t('servicePrompt')}
      <a class="font-semibold underline" href={link('/services/feminine-photography')}>{t('serviceLink')}</a>.
    </p>
  </section>
  <Journey journey={feminineJourney} current="pricing" />
  <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-4 text-center text-3xl font-bold">{t('packagesTitle')}</h2>
    <p class="mb-8 text-center">{t('packagesNote')}</p>
    <PackageComparison
      packages={[...femininePackages].reverse()}
      label={t('comparisonLabel')}
      caption={t('comparisonCaption')}
    />
    <div class="mt-8"><PricingCards prices={femininePricingCards} /></div>
  </section>
  <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
    <h2 class="text-2xl font-bold">{t('selectionTitle')}</h2>
    <p>
      <strong>{t('basicName')}</strong>
      {t('basicBody')}
      <strong>{t('classicName')}</strong>
      {t('classicBody')}
      <strong>{t('premiumName')}</strong>
      {t('premiumBody')}
    </p>
    <h2 class="text-2xl font-bold">{t('inclusionsTitle')}</h2>
    <p>{t('inclusionsBody')}</p>
    <p>{t('exclusionsBody')}</p>
    <h2 class="text-2xl font-bold">{t('comparisonTitle')}</h2>
    <p>{t('comparisonBody')}</p>
    <h2 class="text-2xl font-bold">{t('processTitle')}</h2>
    <p>{t('processBody')}</p>
  </section>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h2 class="mb-4 text-3xl font-bold">{t('galleryTitle')}</h2>
    <div class="grid gap-5 sm:grid-cols-3">
      {
        feminineFeaturedImages.map(({ image, alt }) => (
          <figure>
            <Image
              src={image}
              alt={alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 310px, (min-width: 640px) 30vw, 92vw"
              loading="lazy"
              class="aspect-[4/5] w-full rounded-2xl object-cover"
            />
          </figure>
        ))
      }
    </div>
    <p class="mt-6">
      <a class="font-semibold underline" href={link('/gallery/feminine')}>{t('allGalleryLink')}</a> · <a
        class="underline"
        href={link('/about')}>{t('aboutLink')}</a
      >
    </p>
  </section>
  <FAQs
    title={t('faqTitle')}
    columns={1}
    items={[
      {
        title: t('studioQuestion'),
        description: t('studioAnswer'),
      },
      {
        title: t('deliveryQuestion'),
        description: t('deliveryAnswer'),
      },
      {
        title: t('depositQuestion'),
        description: t('depositAnswer'),
      },
      {
        title: t('guidanceQuestion'),
        description: t('guidanceAnswer'),
      },
      {
        title: t('clothingQuestion'),
        description: t('clothingAnswer'),
      },
      {
        title: t('locationQuestion'),
        description: t('locationAnswer'),
      },
    ]}
  />
  <Journey journey={feminineJourney} current="pricing" cta />
</Layout>
