---
import { localeFromPath, translatedPath } from '~/i18n/routes';
import { infoMessages } from '~/i18n/info';
const locale = localeFromPath(Astro.url.pathname);
const t = infoMessages('contact', locale);
const link = (path: string) => translatedPath(path, locale) ?? path;
const whatsapp = 'https://wa.me/972525836940?text=' + encodeURIComponent(t('inquiry'));
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Button from '~/components/ui/Button.astro';
import { homeMessages } from '~/i18n/home';
const home = homeMessages('home', locale);
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';

const metadata = {
  title: t('metaTitle'),
  description: t('metaDescription'),
  ignoreTitleTemplate: true,
};

const breadcrumbs = [{ url: link('/contact'), name: t('breadcrumbName') }];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <HeroText title={t('heading')} subtitle={home('ctaSubtitle')} />
  <section class="contact-panel" aria-label={t('methods')}>
    <div class="contact-primary">
      <h2>{t('whatsapp')}</h2>
      <p>{home('location')}</p>
      <Button variant="primary" href={whatsapp} target="_blank" icon="tabler:brand-whatsapp">{home('inquire')}</Button>
    </div>
    <div class="contact-alternatives">
      <div><h2>{t('phone')}</h2><a href="tel:+972525836940" dir="ltr">052-583-6940</a></div>
      <div><h2>{t('email')}</h2><a href="mailto:contact@yulia.photography" dir="ltr">contact@yulia.photography</a></div>
      <div class="contact-social">
        <a href="https://instagram.com/koren_yulia/" target="_blank" rel="noopener noreferrer">{t('instagram')}</a>
        <a href="https://www.facebook.com/profile.php?id=61577756080400" target="_blank" rel="noopener noreferrer"
          >{t('facebook')}</a
        >
      </div>
    </div>
  </section>
  <Breadcrumbs items={[{ label: t('home'), href: link('/') }, { label: t('breadcrumbLabel') }]} />
</Layout>
<style>
  .contact-panel {
    max-width: 1000px;
    margin: 2rem auto 4rem;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .contact-primary {
    background: var(--site-surface);
    padding: 3rem;
    border-radius: 3px;
  }
  h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .contact-primary p {
    margin-bottom: 2rem;
    color: var(--aw-color-text-muted);
  }
  .contact-alternatives {
    align-self: center;
    display: grid;
    gap: 2rem;
  }
  .contact-alternatives h2 {
    font-size: 1rem;
    color: var(--aw-color-text-muted);
    margin-bottom: 0.5rem;
  }
  .contact-alternatives a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 5px;
    overflow-wrap: anywhere;
  }
  .contact-social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  @media (max-width: 699px) {
    .contact-panel {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 1rem;
    }
    .contact-primary {
      padding: 2rem;
    }
  }
</style>
