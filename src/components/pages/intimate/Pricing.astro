---
import { localeFromPath, translatedPath } from '~/i18n/routes';
import { intimateMessages } from '~/i18n/intimate';
import { getIntimate } from '~/lib/couples-intimate';
const locale = localeFromPath(Astro.url.pathname);
const t = intimateMessages('pricing', locale);
const link = (path: string) => translatedPath(path, locale) ?? path;
const {
  packages: intimatePackages,
  journey: intimateJourney,
  service: intimateService,
  whatsapp: intimateWhatsApp,
  cards: intimatePricingCards,
} = getIntimate(locale);
const couplesFeaturedImages = getCouplesGalleryImages(locale).slice(0, 3);
const hero = couplesFeaturedImages[0];
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import PackageComparison from '~/components/photoshoots/PackageComparison.astro';
import PricingCards from '~/components/ui/PricingCards.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { getCouplesGalleryImages } from '~/lib/couples-gallery';
// Keep the established pricing URL, title and H1 while improving the buying information.
const metadata = {
  title: t('metaTitle'),
  description: t('metaDescription', intimatePackages.map((p) => p.price).join(', ')),
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/couples_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: link('/pricing'), name: t('pricesLabel') },
  { url: link('/pricing/couples-intimate'), name: t('pageLabel') },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={intimateService} />
  <LeadTracking service="couples_intimate">
    <HeroText
      tagline={t('tagline')}
      title={t('title')}
      subtitle={t('subtitle', intimatePackages[0].price)}
      content={t('introduction')}
      callToAction={{ text: t('compareAction'), href: '#packages' }}
      callToAction2={{
        text: t('dateAction'),
        href: intimateWhatsApp(),
        target: '_blank',
        'data-lead-source': 'intimate-hero',
      }}
    />
    <Breadcrumbs
      items={[
        { label: t('homeLabel'), href: link('/') },
        { label: t('pricesBreadcrumb'), href: link('/pricing') },
        { label: t('pageBreadcrumb') },
      ]}
    />
    <section class="mx-auto max-w-4xl space-y-4 px-4 py-8">
      <h2 class="text-2xl font-bold">{t('overviewTitle')}</h2>
      <p>
        <strong
          >{t('pricePrefix')}
          {intimatePackages[0].price}
          {t('priceSeparator')}{intimatePackages[2].price}
          {t('currencySentence')}</strong
        >
        {t('choiceIntro')}
      </p>
      <p>{t('locationIntro')}</p>
    </section>
    <Journey journey={intimateJourney} current="pricing" />
    <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
      <h2 class="mb-4 text-center text-3xl font-bold">{t('packagesTitle')}</h2>
      <p class="mb-8 text-center">{t('packagesNote')}</p>
      <PackageComparison
        packages={[...intimatePackages].reverse()}
        label={t('comparisonLabel')}
        caption={t('comparisonCaption')}
      />
      <div class="mt-8"><PricingCards prices={intimatePricingCards} /></div>
    </section>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-2xl font-bold">{t('selectionTitle')}</h2>
      <p>
        <strong>{t('basicName')}</strong>
        {t('basicBody')}
        <strong>{t('classicName')}</strong>
        {t('classicBody')}
        <strong>{t('premiumName')}</strong>
        {t('premiumBody')}
      </p>
      <h2 class="text-2xl font-bold">{t('inclusionsTitle')}</h2>
      <p>{t('inclusionsBody')}</p>
      <p>{t('exclusionsBody')}</p>
      <h2 class="text-2xl font-bold">{t('controlTitle')}</h2>
      <p>{t('controlBody')}</p>
      <p>
        {t('servicePrompt')}
        <a class="font-semibold underline" href={link('/services/intimate-couples-photography')}>{t('serviceLink')}</a>.
      </p>
      <h2 class="text-2xl font-bold">{t('processTitle')}</h2>
      <p>{t('processBody')}</p>
    </section>
    <section class="mx-auto max-w-5xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">{t('galleryTitle')}</h2>
      <p>{t('galleryIntro')}</p>
      <Gallery images={couplesFeaturedImages} />
      <p>
        <a class="font-semibold underline" href={link('/gallery/couples')}>{t('galleryLink')}</a> · <a
          class="underline"
          href={link('/about')}>{t('aboutLink')}</a
        >
      </p>
    </section>
    <section id="reviews" class="mx-auto max-w-3xl px-4 py-10">
      <h2 class="mb-4 text-3xl font-bold">{t('reviewTitle')}</h2>
      <p class="mb-6 text-sm text-muted">{t('reviewNote')}</p>
      <blockquote class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <p>{t('reviewQuote')}</p>
        <footer class="mt-4 font-semibold">{t('reviewName')}</footer>
      </blockquote>
    </section>
    <FAQs
      title={t('faqTitle')}
      columns={1}
      items={[
        {
          title: t('nudityQuestion'),
          description: t('nudityAnswer'),
        },
        {
          title: t('studioQuestion'),
          description: t('studioAnswer'),
        },
        {
          title: t('deliveryQuestion'),
          description: t('deliveryAnswer'),
        },
        {
          title: t('depositQuestion'),
          description: t('depositAnswer'),
        },
        {
          title: t('weatherQuestion'),
          description: t('weatherAnswer'),
        },
        {
          title: t('clothingQuestion'),
          description: t('clothingAnswer'),
        },
        {
          title: t('bookingQuestion'),
          description: t('bookingAnswer'),
        },
        {
          title: t('galleryQuestion'),
          description: t('galleryAnswer'),
        },
      ]}
    />
    <Journey journey={intimateJourney} current="pricing" cta />
  </LeadTracking>
</Layout>
