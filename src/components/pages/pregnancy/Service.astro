---
import { localeFromPath, translatedPath } from '~/i18n/routes';
import { pregnancyMessages } from '~/i18n/pregnancy';
import { getPregnancy, pregnancyChildSupplement } from '~/lib/pregnancy';
const locale = localeFromPath(Astro.url.pathname);
const t = pregnancyMessages('service', locale);
const link = (path: string) => translatedPath(path, locale) ?? path;
const {
  packages: pregnancyPackages,
  journey: pregnancyJourney,
  service: pregnancyService,
  whatsapp: pregnancyWhatsApp,
} = getPregnancy(locale);
import Layout from '~/layouts/PageLayout.astro';
import ImageSection from '~/components/photoshoots/ImageSection.astro';
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import hero from '~/assets/images/services/pregnancy-hero.jpg';
import beach from '~/assets/images/services/pregnancy-10.jpg';
import couple from '~/assets/images/services/pregnancy-7.jpg';
import detail from '~/assets/images/services/pregnancy-5.jpg';
import osher_review from '~/assets/reviewers/osher_review.jpg';

const metadata = {
  title: t('metaTitle'),
  description: t('metaDescription', pregnancyPackages[0].price),
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/images/services/pregnancy-hero.jpg',
        width: hero.width,
        height: hero.height,
        alt: t('metaImageAlt'),
      },
    ],
  },
};
const breadcrumbs = [
  { url: link('/services'), name: t('servicesLabel') },
  { url: link('/services/pregnancy-photography'), name: t('serviceLabel') },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={pregnancyService} />
  <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-8 md:grid-cols-2 md:gap-12 md:py-12">
    <div>
      <p class="mb-3 font-semibold text-accent">{t('byline')}</p>
      <h1 class="mb-5 text-4xl font-bold leading-tight md:text-5xl">
        {t('heroTitle')}<br /><span class="text-accent">{t('heroAccent')}</span>
      </h1>
      <p class="mb-5 text-xl leading-relaxed">{t('heroIntroduction')}</p>
      <p class="mb-6">
        {t('heroParticipation')}
        <strong>{t('startingPricePrefix')}{pregnancyPackages[0].price} {t('currencySentence')}</strong>
      </p>
      <div class="flex flex-wrap gap-3">
        <Button variant="primary" class="w-full" href={pregnancyWhatsApp()} target="_blank" icon="tabler:brand-whatsapp"
          >{t('dateAction')}</Button
        >
        <Button class="w-full" href={link('/gallery/pregnancy')}>{t('galleryAction')}</Button>
      </div>
      <p class="mt-5">
        <a href={link('/pricing/pregnancy')} class="underline underline-offset-4">{t('pricingAction')}</a>
      </p>
    </div>
    <Image
      src={hero}
      alt={t('heroImageAlt')}
      widths={[400, 640, 900, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-2xl object-cover"
    />
  </section>
  <Breadcrumbs
    items={[
      { label: t('homeLabel'), href: link('/') },
      { label: t('servicesBreadcrumb'), href: link('/services') },
      { label: t('serviceBreadcrumb') },
    ]}
  />
  <Journey journey={pregnancyJourney} current="service" />

  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="mb-8 text-3xl font-bold">{t('processTitle')}</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">{t('introductionTitle')}</h3><p>{t('introductionBody')}</p>
      </div>
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">{t('guidanceTitle')}</h3><p>{t('guidanceBody')}</p>
      </div>
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">{t('deliveryTitle')}</h3><p>{t('deliveryBody')}</p>
      </div>
    </div>
    <p class="mt-6"><a href={link('/about')} class="underline">{t('aboutLink')}</a></p>
  </section>

  <ImageSection image={couple} alt={t('coupleImageAlt')} imageFirst={true}>
    <h2 class="text-3xl font-bold">{t('locationsTitle')}</h2>
    <p>
      <strong>{t('natureEmphasis')}</strong>
      {t('natureBody')}
      <strong>{t('seaEmphasis')}</strong>
      {t('seaBody')}
    </p>
    <p>{t('locationsBody')}</p>
    <p>{t('studioBody')}</p>
    <a href={link('/gallery/pregnancy')} class="inline-block font-semibold underline">{t('galleryLink')}</a>
  </ImageSection>

  <ImageSection image={beach} alt={t('beachImageAlt')} imageFirst={false}>
    <h2 class="text-3xl font-bold">{t('participantsTitle')}</h2>
    <h3 class="text-xl font-bold">{t('soloTitle')}</h3>
    <p>{t('soloStory')}</p>
    <p>{t('soloGuidance')}</p>
    <h3 class="text-xl font-bold">{t('partnerTitle')}</h3>
    <p>{t('partnerBody')}</p>
    <p>{t('childrenBody', pregnancyChildSupplement)}</p>
    <h3 class="text-xl font-bold">{t('clothingTitle')}</h3>
    <p>{t('clothingBody')}</p>
  </ImageSection>

  <section class="mx-auto max-w-4xl space-y-5 px-4 py-12" id="preparation" style="scroll-margin-top: 7rem">
    <h2 class="text-3xl font-bold">{t('preparationTitle')}</h2>
    <p>{t('timingBody')}</p>
    <h3 class="text-xl font-bold">{t('outfitTitle')}</h3>
    <p>{t('outfitBody')}</p>
    <ul class="list-disc space-y-2 ps-6">
      <li>{t('bringWater')}</li>
      <li>{t('bringClothes')}</li>
      <li>{t('bringAccessory')}</li>
    </ul>
    <p>{t('preparationClosing')}</p>
    <Image
      src={detail}
      alt={t('detailImageAlt')}
      widths={[400, 800, 1200]}
      sizes="(min-width: 900px) 850px, 100vw"
      loading="lazy"
      class="max-h-96 w-full rounded-2xl object-cover"
    />
  </section>
  <section
    class="bg-gray-50 dark:bg-slate-900 py-16 px-6 intersect-once motion-safe:intersect:animate-fade motion-safe:opacity-0 intersect-quarter"
    id="reviews"
  >
    <h2 class="text-3xl font-bold text-center mb-10">{t('reviewsTitle')}</h2>
    <div class="grid md:grid-cols-2 gap-6 max-w-6xl mx-auto">
      <blockquote
        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow intersect-once motion-safe:intersect:animate-fade motion-safe:opacity-0 intersect-quarter"
      >
        <p>
          <span class="text-yellow-400 text-lg">★★★★★</span>
          <br />
          {t('osherReview')}
        </p>
        <footer class="mt-4 font-bold flex items-center">
          <Image
            src={osher_review}
            alt={t('osherImageAlt')}
            class="w-10 h-10 rounded-full mr-3"
            width={40}
            height={40}
          />
          <span class="mx-2">{t('osherName')}</span>
        </footer>
      </blockquote>
      <blockquote
        class="bg-white dark:bg-slate-800 p-6 rounded-2xl shadow intersect-once motion-safe:intersect:animate-fade motion-safe:opacity-0 intersect-quarter"
      >
        <p>
          <span class="text-yellow-400 text-lg">★★★★★</span>
          <br />
          {t('zehavaReview')}
        </p>
        <footer class="mt-4 font-bold flex items-center">
          <span class="mx-2">{t('zehavaName')}</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <section class="mx-auto max-w-4xl space-y-4 px-4 py-12 text-center">
    <h2 class="text-3xl font-bold">{t('priceSummaryTitle')}</h2>
    <p>
      {t('priceRangePrefix')}
      {pregnancyPackages[0].price}
      {t('priceRangeSeparator')}{pregnancyPackages[2].price}
      {t('priceSummaryPhotos')}
      {pregnancyPackages[0].photos}
      {t('basicSuffix')}
      {pregnancyPackages[1].photos}
      {t('classicSuffix')}{pregnancyPackages[2].photos}
      {t('premiumSuffix')}
    </p>
    <Button href={link('/pricing/pregnancy')}>{t('compareAction')}</Button>
  </section>
  <FAQs
    title={t('faqTitle')}
    columns={2}
    items={[
      {
        title: t('experienceQuestion'),
        description: t('experienceAnswer'),
      },
      {
        title: t('soloQuestion'),
        description: t('soloAnswer'),
      },
      {
        title: t('clothingQuestion'),
        description: t('clothingAnswer'),
      },
      {
        title: t('weatherQuestion'),
        description: t('weatherAnswer'),
      },
    ]}
  />
  <Journey journey={pregnancyJourney} current="service" cta />
</Layout>
