---
import { pregnancyLinks, pregnancyPackages } from '~/lib/pregnancy';
const site = Astro.site ?? new URL('https://yulia.photography');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': new URL(`${pregnancyLinks.service}#service`, site).href,
  name: 'צילומי הריון בטבע ובים בחולון ובמרכז',
  serviceType: 'צילומי הריון',
  url: new URL(pregnancyLinks.service, site).href,
  provider: { '@id': new URL('/#business', site).href },
  areaServed: ['חולון', 'מרכז הארץ'],
  offers: pregnancyPackages.map((p) => ({
    '@type': 'Offer',
    name: p.title,
    price: p.price,
    priceCurrency: 'ILS',
    description: `${p.photos} תמונות בעריכה מלאה וגלריה דיגיטלית בצילומי חוץ. משך צילום משוער: ${p.duration}. ילדים וסטודיו בתוספת תשלום.`,
    url: new URL(`${pregnancyLinks.pricing}#${p.id}`, site).href,
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
