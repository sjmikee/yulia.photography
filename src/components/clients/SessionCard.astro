---
import {
  deliveryDeadline,
  deliveryLabel,
  displayDay,
  isCancelled,
  stepsFor,
  type Payment,
  type Workflow,
  type Client,
  type Session,
} from '~/lib/client-workflow';
import { durationOptions, sessionDurationHours } from '~/lib/session-duration';
import WorkflowFields from './WorkflowFields.astro';
import { Icon } from 'astro-icon/components';
import AdvanceStage from './AdvanceStage.astro';
interface Props {
  session: Session;
  client: Client;
  payments: Payment[];
}
const { session: s, client, payments } = Astro.props;
const w: Workflow = s.workflow || {};
const duration = sessionDurationHours(s);
const sessionPayments = payments.filter((p) => Number(p.session_id) === Number(s.id));
const steps = stepsFor(s, sessionPayments);
const cancelled = isCancelled(s);
const deadline = deliveryDeadline(s);
const delivered = steps.some((step) => step.key === 'delivered' && step.done);
const next = cancelled ? undefined : steps.find((step) => !step.done);
const current = next?.key;
const position = steps.findIndex((step) => step.key === current);
const after = steps[position + 1];
const receipt = sessionPayments.find((p) => p.stage === (current === 'deposit_receipt' ? 'deposit' : 'balance'));
const base = `client_id=${client.id}&session_id=${s.id}&phone=${encodeURIComponent(client.phone)}`;
const wa = `https://wa.me/${client.phone.replace(/^0/, '972')}`;
const review = `${wa}?text=${encodeURIComponent('אשמח אם תכתבו לי ביקורת ❤️\nhttps://g.page/r/CfFq0GZG4TgjEBE/review')}`;
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jerusalem' }).format(new Date());
---

<article
  id={`session-${s.id}`}
  class="panel"
  data-session-card
  data-session-id={s.id}
  data-current-step={current}
  data-contract-signed={s.contract_signed ? 'true' : 'false'}
  data-name={client.name}
  data-phone={client.phone}
  data-email={client.email || ''}
  data-type={s.session_type}
  data-wa={wa}
>
  <header class="relative mb-6">
    <div data-session-actions class="absolute top-0 left-0 z-10">
      <button
        type="button"
        data-session-actions-toggle
        class="inline-flex size-12 items-center justify-center rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900"
        aria-label={`אפשרויות סשן ${s.id}`}
        title="אפשרויות סשן"
        aria-expanded="false"
        aria-controls={`session-menu-${s.id}`}
      >
        <Icon name="tabler:dots-vertical" class="size-6" aria-hidden="true" />
      </button>
      <div
        data-session-actions-menu
        id={`session-menu-${s.id}`}
        hidden
        class="absolute top-full left-0 mt-2 w-52 rounded-lg border border-gray-200 bg-white p-1 shadow-lg"
      >
        <button
          type="button"
          data-session-status-open
          class={`flex w-full items-center gap-2 rounded-md px-3 py-2.5 text-start text-sm hover:bg-gray-100 ${cancelled ? 'text-gray-800' : 'text-red-700'}`}
          aria-expanded="false"
          aria-controls={`session-status-${s.id}`}
        >
          <Icon name={cancelled ? 'tabler:restore' : 'tabler:circle-x'} class="size-5" aria-hidden="true" />
          {cancelled ? 'החזרת הסשן לפעילות' : 'ביטול הסשן'}
        </button>
      </div>
    </div>
    <div class="pl-14">
      <h2 class="text-2xl font-bold mb-2">צילומי {s.session_type}</h2>
      <p class="text-gray-600">
        סשן #{s.id} · חבילה {s.package_type} · מחיר ₪{s.session_price} · נותר לתשלום ₪{s.to_pay}
      </p>
      {
        w.scheduled && (
          <p class="text-gray-600 mt-2">
            {w.scheduled.replace('T', ' · ')}
            {w.location && ` · ${w.location}`}
          </p>
        )
      }
      {cancelled && <p class="mt-3 font-bold text-red-700">הסשן בוטל · {w.cancellation_reason}</p>}
      {
        !cancelled && deadline && (
          <p
            data-delivery-deadline
            class={`mt-3 ${!delivered && deadline < today ? 'text-red-700 font-bold' : 'text-gray-700'}`}
          >
            מסירת תמונות עד {displayDay(deadline)}
            {!delivered && ` · ${deliveryLabel(deadline, today)}`}
          </p>
        )
      }
      {
        !cancelled && !deadline && (
          <p data-delivery-deadline class="mt-3 text-amber-800">
            יש לשמור את מועד הצילומים כדי לחשב מסירה בתוך 14 ימים.
          </p>
        )
      }
    </div>
  </header>
  <form
    data-session-status-form
    id={`session-status-${s.id}`}
    hidden
    method="POST"
    action="/api/client_workflow"
    class="mb-6 rounded-xl bg-gray-50 p-4 space-y-4"
  >
    <WorkflowFields clientId={client.id} sessionId={s.id} action={cancelled ? 'restore' : 'cancel'} />
    <h3 class="font-bold">{cancelled ? 'החזרת הסשן לפעילות' : 'ביטול הסשן'}</h3>
    {
      cancelled ? (
        <p>הסשן יחזור לרשימת העבודה עם ההתקדמות, התשלומים והמועד הקיימים. בדקי שהמועד עדיין מתאים.</p>
      ) : (
        <>
          <label>
            סיבת הביטול
            <textarea name="reason" maxlength="1000" required />
          </label>
          <p>הסשן יוסר מהעבודה הפעילה. החוזה, התשלומים והיתרה יישמרו. ביטול אינו מבצע החזר כספי או מבטל קבלות.</p>
        </>
      )
    }
    <div class="flex flex-wrap gap-3">
      <button class={`btn-secondary ${cancelled ? '' : 'text-red-700'}`} name="confirm" value="1"
        >{cancelled ? 'אישור החזרה לפעילות' : 'אישור ביטול הסשן'}</button
      >
      <button type="button" data-session-status-close class="btn-secondary">סגירה</button>
    </div>
  </form>
  {
    w.calendar_needs_update === '1' && (
      <aside class="rounded-xl bg-amber-50 p-4 mb-5">
        <p class="font-bold">נדרש עדכון ביומן Google</p>
        <p>יש {cancelled ? 'לבטל' : 'לעדכן'} את האירוע הקיים ביומן. השינוי באתר אינו מעדכן אותו אוטומטית.</p>
        <a class="underline block my-3" href="https://calendar.google.com/calendar/u/0/r">
          פתיחת היומן
        </a>
        <form method="POST" action="/api/client_workflow">
          <WorkflowFields clientId={client.id} sessionId={s.id} action="calendar_updated" />
          <button class="btn-secondary">עדכנתי את האירוע ביומן</button>
        </form>
      </aside>
    )
  }
  {
    !cancelled && (
      <section class="rounded-2xl bg-gray-50 p-5 sm:p-8 mb-6 space-y-5" aria-label="השלב הנוכחי">
        <div>
          <p class="text-sm text-gray-500 mb-2">{next ? `שלב ${position + 1} מתוך ${steps.length}` : 'הסשן הושלם'}</p>
          <h3 class="text-2xl font-bold">{next?.label || 'עוד זיכרונות יפים נמסרו ❤️'}</h3>
        </div>
        {current === 'contract_sent' && (
          <>
            <p>פרטי הלקוח והסשן כבר מוכנים. בחרי אישור פרסום והמשיכי לשליחה בוואטסאפ.</p>
            <a class="btn-primary w-full" href={`/clients/send_contract?${base}`}>
              המשך לשליחת חוזה
            </a>
          </>
        )}
        {current === 'signed' && (
          <>
            <p>
              אחרי שליחת הקישור בוואטסאפ, מחכים לחתימה. העמוד בודק את החתימה אוטומטית ויעבור לשלב התשלום כשהחוזה ייחתם.
            </p>
            <a class="btn-primary w-full" href={`/clients/${client.id}#session-${s.id}`}>
              בדיקת חתימה והמשך לתשלום
            </a>
            <a class="block text-center underline" href={`/clients/send_contract?${base}`}>
              פתיחת מסך החוזה שוב
            </a>
          </>
        )}
        {(current === 'deposit' || current === 'balance') && (
          <>
            <p>
              {current === 'deposit'
                ? 'לאחר קבלת ₪100 לסגירת התאריך, המשיכי ישירות להפקת הקבלה.'
                : `לאחר קבלת היתרה בסך ₪${s.to_pay}, המשיכי להפקת הקבלה.`}
            </p>
            {Number(s.to_pay) >= (current === 'deposit' ? 100 : 0) && Number(s.to_pay) > 0 ? (
              <form method="POST" action="/api/client_workflow" class="space-y-4">
                <WorkflowFields clientId={client.id} sessionId={s.id} action="payment" />
                <input type="hidden" name="stage" value={current} />
                <input type="hidden" name="amount" value={current === 'deposit' ? 100 : s.to_pay} />
                <label>
                  מתי התקבל התשלום?
                  <input type="date" name="paid_on" value={today} required />
                </label>
                <button class="btn-primary w-full" name="continue" value="receipt">
                  קיבלתי ₪{current === 'deposit' ? 100 : s.to_pay} — להפקת קבלה
                </button>
                <button class="btn-secondary w-full" name="continue" value="done">
                  קיבלתי תשלום והקבלה טופלה — המשך
                </button>
                <p class="text-sm text-gray-600">סימון ידני יעדכן את היתרה וישלים את שלב הקבלה, בלי להפיק קבלה באתר.</p>
              </form>
            ) : (
              <p>אין יתרה לרישום תשלום זה. אם התשלום כבר נרשם בעבר, אין לרשום אותו שוב.</p>
            )}
          </>
        )}
        {(current === 'deposit_receipt' || current === 'balance_receipt') && (
          <>
            {receipt?.receipt_status === 'processing' ? (
              <>
                <p role="status">הקבלה בטיפול. אם התהליך נעצר, יש לבדוק ב־Morning לפני הפקה נוספת.</p>
                <a class="btn-primary w-full" href={`/clients/${client.id}#session-${s.id}`}>
                  בדיקת מצב הקבלה והמשך
                </a>
              </>
            ) : receipt ? (
              <>
                <p>התשלום נשמר. הסכום והתאריך כבר מולאו בקבלה.</p>
                <a class="btn-primary w-full" href={`/clients/send_reciept?payment_id=${receipt.id}`}>
                  המשך להפקת קבלה
                </a>
                <form method="POST" action="/api/client_workflow">
                  <WorkflowFields clientId={client.id} sessionId={s.id} action="receipt_done" />
                  <input type="hidden" name="stage" value={receipt.stage} />
                  <button class="btn-secondary w-full">הקבלה טופלה — המשך</button>
                </form>
              </>
            ) : (
              <p>לא נמצאה קבלה לתשלום זה. תשלומים ישנים שכבר נוכו מהיתרה דורשים בדיקת היסטוריה לפני רישום נוסף.</p>
            )}
          </>
        )}
        {current === 'calendar_added' && (
          <>
            <p>שמרי את פרטי הצילומים ופתחי אירוע מוכן ביומן.</p>
            <form data-calendar-form method="POST" action="/api/client_workflow" class="grid sm:grid-cols-2 gap-4">
              <WorkflowFields clientId={client.id} sessionId={s.id} action="details" />
              <>
                <input type="hidden" name="notes" value={w.notes || ''} />
                <input type="hidden" name="pixieset" value={w.pixieset || ''} />
              </>
              <label>
                תאריך ושעה (שעון ישראל)
                <input type="datetime-local" name="scheduled" value={w.scheduled} required />
              </label>
              <label>
                משך
                <select name="duration">
                  {durationOptions.map((n) => (
                    <option value={n} selected={duration === n}>
                      {n} שעות
                    </option>
                  ))}
                </select>
              </label>
              <label class="sm:col-span-2">
                מיקום
                <input name="location" value={w.location} maxlength="500" />
              </label>
              <button class={`${w.scheduled ? 'btn-secondary' : 'btn-primary'} sm:col-span-2`}>
                שמירת הפרטים ופתיחת היומן
              </button>
            </form>
            <div data-calendar-confirm hidden={!w.scheduled}>
              <AdvanceStage
                clientId={client.id}
                sessionId={s.id}
                step="calendar_added"
                label="שמרתי ביומן — המשך ליום הצילומים"
              />
            </div>
          </>
        )}
        {current === 'shoot_done' && (
          <>
            <p>הכול מוכן ליום הצילומים. בסיום הסשן, המשיכי לתשלום היתרה.</p>
            <AdvanceStage
              clientId={client.id}
              sessionId={s.id}
              step="shoot_done"
              label="הצילומים הסתיימו — המשך לתשלום"
            />
          </>
        )}
        {current === 'editing_done' && (
          <>
            <p>עכשיו נשאר לערוך את התמונות. כשהכול מוכן, המשיכי להעלאה ולמסירה.</p>
            <AdvanceStage
              clientId={client.id}
              sessionId={s.id}
              step="editing_done"
              label="סיימתי לערוך — המשך למסירת התמונות"
            />
          </>
        )}
        {current === 'delivered' && (
          <>
            <p>העלי תמונות מוקטנות ל־Pixieset ותמונות מלאות ל־MyAirBridge, ואז הכיני הודעה עם שני הקישורים.</p>
            <div class="flex flex-wrap gap-3">
              <>
                <a class="btn-secondary" href="https://pixieset.com/" target="_blank" rel="noopener noreferrer">
                  פתיחת Pixieset
                </a>
                <a class="btn-secondary" href="https://www.myairbridge.com/" target="_blank" rel="noopener noreferrer">
                  פתיחת MyAirBridge
                </a>
              </>
            </div>
            <form data-delivery method="POST" action="/api/client_workflow" class="space-y-4">
              <WorkflowFields clientId={client.id} sessionId={s.id} action="delivery" />
              <label>
                קישור לגלריית Pixieset
                <input name="pixieset" type="url" dir="ltr" value={w.pixieset} placeholder="https://" required />
              </label>
              <label>
                קישור זמני ל־MyAirBridge
                <input data-airbridge type="url" dir="ltr" placeholder="https://" autocomplete="off" required />
              </label>
              <p class="text-sm text-gray-600">
                קישור MyAirBridge לא נשמר. ההודעה מזכירה להוריד את התמונות בתוך שלושה ימים מההעלאה.
              </p>
              <button class={`${w.delivery_prepared || w.pixieset ? 'btn-secondary' : 'btn-primary'} w-full`}>
                שמירת הגלריה ופתיחת הודעה בוואטסאפ
              </button>
            </form>
            <div data-delivery-confirm hidden={!w.delivery_prepared && !w.pixieset}>
              <AdvanceStage
                clientId={client.id}
                sessionId={s.id}
                step="delivered"
                label="שלחתי את הקישורים — המשך לבקשת ביקורת"
              />
            </div>
          </>
        )}
        {current === 'review_requested' && (
          <>
            <p>התמונות נמסרו! אפשר לשלוח הודעה מוכנה עם קישור לביקורת בגוגל.</p>
            <a class="btn-secondary w-full" href={review} rel="noopener noreferrer">
              פתיחת בקשת ביקורת בוואטסאפ
            </a>
            <AdvanceStage
              clientId={client.id}
              sessionId={s.id}
              step="review_requested"
              label="שלחתי בקשת ביקורת — סיום הסשן"
            />
          </>
        )}
        {!next && (
          <a
            class="btn-primary w-full"
            href={`/clients/add_session?client_id=${client.id}&phone=${encodeURIComponent(client.phone)}`}
          >
            יצירת סשן נוסף ללקוח
          </a>
        )}
        <p data-action-error role="alert" hidden class="text-red-700" />
        <a data-external-fallback class="underline" rel="noopener noreferrer" hidden>
          פתיחת הקישור שהוכן
        </a>
        {next && after && <p class="text-sm text-gray-500">לאחר מכן: {after.label}</p>}
      </section>
    )
  }
  <details class="mb-5">
    <summary>התקדמות הסשן · {steps.filter((step) => step.done).length} מתוך {steps.length} שלבים הושלמו</summary>
    <ol class="grid sm:grid-cols-2 gap-3 mt-4">
      {
        steps.map((step) => (
          <li class={step.done ? 'text-green-700' : 'text-gray-600'}>
            {step.done ? '✓' : '○'} {step.key === 'signed' && step.done ? 'החוזה נחתם' : step.label}
          </li>
        ))
      }
    </ol>
  </details>
  {
    !cancelled && (
      <details class="mb-5">
        <summary>עריכת פרטי הסשן</summary>
        <form data-session-details method="POST" action="/api/client_workflow" class="grid sm:grid-cols-2 gap-4 mt-4">
          <WorkflowFields clientId={client.id} sessionId={s.id} action="details" />

          <p class="sm:col-span-2">לשינוי מועד הצילומים, פתחי את אפשרות שינוי המועד בהמשך.</p>
          <label>
            משך
            <select name="duration">
              {durationOptions.map((n) => (
                <option value={n} selected={duration === n}>
                  {n} שעות
                </option>
              ))}
            </select>
          </label>
          <label>
            מיקום
            <input name="location" value={w.location} maxlength="500" />
          </label>
          <label>
            גלריית Pixieset
            <input name="pixieset" type="url" dir="ltr" value={w.pixieset} placeholder="https://" />
          </label>
          <label class="sm:col-span-2">
            הערות
            <textarea name="notes" maxlength="10000">
              {w.notes}
            </textarea>
          </label>
          <button class="btn-secondary sm:col-span-2">שמירת פרטים</button>
        </form>
      </details>
    )
  }
  <details class="mb-5">
    <summary>תשלומים וקבלות</summary>
    <p class="my-4">יתרה לתשלום: ₪{s.to_pay}. תשלומים ישנים שכבר נוכו מהיתרה אין לרשום שוב.</p>
    {
      sessionPayments.map((p) => (
        <div class="border-b border-gray-200 py-3">
          <p>
            {p.stage === 'deposit' ? 'סגירת תאריך' : 'יתרת התשלום'} · ₪{p.amount} · {p.paid_on.slice(0, 10)}
          </p>
          {p.receipt_status === 'issued' && !p.receipt_url ? (
            <p class="text-gray-600 mt-2">הקבלה סומנה כטופלה ידנית.</p>
          ) : p.receipt_status === 'issued' ? (
            <div class="flex flex-wrap gap-4 mt-2">
              <a class="underline" href={p.receipt_url} rel="noopener noreferrer">
                פתיחת קבלה
              </a>
              <a
                class="underline"
                href={`${wa}?text=${encodeURIComponent(`הקבלה שלך מוכנה ❤️\n${p.receipt_url}`)}`}
                rel="noopener noreferrer"
              >
                שליחת קבלה בוואטסאפ
              </a>
            </div>
          ) : p.receipt_status === 'pending' ? (
            <a class="btn-secondary mt-2" href={`/clients/send_reciept?payment_id=${p.id}`}>
              הפקת קבלה
            </a>
          ) : (
            <p>הקבלה בטיפול או דורשת בדיקה ב־Morning.</p>
          )}
        </div>
      ))
    }
  </details>
  {
    !cancelled && (
      <details>
        <summary>תיקון שלב שסומן בטעות</summary>
        <p class="text-sm text-gray-600 mt-3">
          תיקון הסימון משנה את התקדמות הסשן בלבד. הוא לא משנה יתרה, רושם תשלום, מפיק קבלה או משנה את החוזה החתום.
        </p>
        <p data-toggle-status role="status" aria-live="polite" class="text-sm mt-2" />
        <div class="mt-4 divide-y divide-gray-200">
          {steps.map((step) => (
            <form
              method="POST"
              action="/api/client_workflow"
              data-stage-toggle
              class="flex gap-4 items-center justify-between py-3"
            >
              <WorkflowFields clientId={client.id} sessionId={s.id} action="correction" />
              <input type="hidden" name="step" value={step.key} />
              <input type="hidden" name="done" value={step.done ? '0' : '1'} />
              <span id={`stage-${s.id}-${step.key}`}>{step.label}</span>
              <button
                type="submit"
                role="switch"
                aria-checked={step.done ? 'true' : 'false'}
                aria-labelledby={`stage-${s.id}-${step.key}`}
                class="stage-switch"
              >
                <span />
              </button>
            </form>
          ))}
        </div>
      </details>
    )
  }
  {
    !cancelled && (
      <details class="mt-5">
        <summary>שינוי מועד הסשן</summary>
        {w.previous_scheduled && (
          <p class="mt-3 text-gray-600">מועד קודם: {w.previous_scheduled.replace('T', ' · ')}</p>
        )}
        <form method="POST" action="/api/client_workflow" class="mt-4 space-y-4">
          <WorkflowFields clientId={client.id} sessionId={s.id} action="reschedule" />
          <input type="hidden" name="previous_scheduled" value={w.scheduled || ''} />
          <label>
            מועד חדש (שעון ישראל)
            <input type="datetime-local" name="scheduled" value={w.scheduled} required />
          </label>
          <p class="text-sm text-gray-600">
            מועד מסירת התמונות יעודכן ל־14 ימים לאחר התאריך החדש. יש לעדכן גם את האירוע הקיים ביומן Google.
          </p>
          <button class="btn-secondary" name="confirm" value="1">
            אישור ושמירת המועד החדש
          </button>
        </form>
      </details>
    )
  }
</article>
<style>
  .stage-switch {
    width: 51px;
    height: 31px;
    border-radius: 999px;
    background: #9ca3af;
    padding: 3px;
    flex-shrink: 0;
    border: 0;
    direction: ltr;
    transition: background 0.18s;
  }
  .stage-switch span {
    display: block;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 1px 3px #0003;
    transition: transform 0.18s;
  }
  .stage-switch[aria-checked='true'] {
    background: #248a3d;
  }
  .stage-switch[aria-checked='true'] span {
    transform: translateX(20px);
  }
  .stage-switch:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 3px;
  }
  .stage-switch:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  @media (prefers-reduced-motion: reduce) {
    .stage-switch,
    .stage-switch span {
      transition: none;
    }
  }
</style>
<script>
  import { focusClientField } from '~/lib/focus-client-field';
  import { openClientApp } from '~/lib/client-app-links';
  import { safeWebUrl, deliveryDeadline, displayDay, deliveryLabel } from '~/lib/client-workflow';
  const initialized = new WeakSet();
  function init() {
    const selected = document.getElementById(location.hash.slice(1));
    if (selected?.parentElement instanceof HTMLDetailsElement) selected.parentElement.open = true;
    document.querySelectorAll<HTMLElement>('[data-session-card]').forEach((card) => {
      if (initialized.has(card)) return;
      initialized.add(card);
      const actions = card.querySelector<HTMLElement>('[data-session-actions]')!;
      const toggle = card.querySelector<HTMLButtonElement>('[data-session-actions-toggle]')!;
      const menu = card.querySelector<HTMLElement>('[data-session-actions-menu]')!;
      const statusOpen = card.querySelector<HTMLButtonElement>('[data-session-status-open]')!;
      const statusForm = card.querySelector<HTMLFormElement>('[data-session-status-form]')!;
      const closeMenu = () => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      };
      toggle.addEventListener('click', (event) => {
        menu.hidden = !menu.hidden;
        toggle.setAttribute('aria-expanded', String(!menu.hidden));
        if (!menu.hidden && event.detail === 0) statusOpen.focus();
      });
      actions.addEventListener('focusout', (event) => {
        if (event.relatedTarget && !actions.contains(event.relatedTarget as Node)) closeMenu();
      });
      actions.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
          toggle.focus();
        }
      });
      statusOpen.addEventListener('click', () => {
        closeMenu();
        statusForm.hidden = false;
        statusOpen.setAttribute('aria-expanded', 'true');
        focusClientField(statusForm.querySelector<HTMLElement>('textarea, button'));
      });
      const closeStatus = () => {
        statusForm.hidden = true;
        statusForm.reset();
        statusOpen.setAttribute('aria-expanded', 'false');
        toggle.focus();
      };
      statusForm.querySelector('[data-session-status-close]')!.addEventListener('click', closeStatus);
      statusForm.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeStatus();
      });

      card.querySelectorAll<HTMLFormElement>('[data-stage-toggle]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = form.querySelector<HTMLButtonElement>('button')!;
          const status = card.querySelector<HTMLElement>('[data-toggle-status]')!;
          const switches = card.querySelectorAll<HTMLButtonElement>('[data-stage-toggle] button');
          const previous = button.getAttribute('aria-checked');
          switches.forEach((item) => {
            item.disabled = true;
          });
          button.setAttribute('aria-checked', previous === 'true' ? 'false' : 'true');
          status.textContent = 'שומרת…';
          let saved = false;
          try {
            const response = await fetch('/api/client_workflow', {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: new FormData(form),
            });
            if (!response.ok || !(await response.json()).saved) throw new Error('Save failed');
            saved = true;
            const page = await fetch(location.href, { cache: 'no-store' });
            if (!page.ok) throw new Error('Refresh failed');
            const doc = new DOMParser().parseFromString(await page.text(), 'text/html');
            const replacement = doc.getElementById(card.id);
            if (!replacement) throw new Error('Missing session');
            // Preserve expanded sections and unsaved session details while updating the workflow.
            card.querySelectorAll('details').forEach((details, index) => {
              const target = replacement.querySelectorAll('details')[index];
              if (target) target.open = details.open;
            });
            const oldDetails = card.querySelector<HTMLFormElement>('[data-session-details]');
            const newDetails = replacement.querySelector<HTMLFormElement>('[data-session-details]');
            if (oldDetails && newDetails) newDetails.replaceWith(oldDetails);
            card.replaceWith(replacement);
            init();
            replacement.querySelector<HTMLElement>('[data-toggle-status]')!.textContent = 'נשמר';
            replacement
              .querySelector<HTMLButtonElement>(`button[aria-labelledby="${button.getAttribute('aria-labelledby')}"]`)
              ?.focus({ preventScroll: true });
          } catch {
            if (!saved) button.setAttribute('aria-checked', previous!);
            else form.querySelector<HTMLInputElement>('[name="done"]')!.value = previous === 'true' ? '1' : '0';
            status.textContent = saved
              ? 'הסימון נשמר, אך התצוגה לא עודכנה. רענני לעדכון ההתקדמות.'
              : 'השמירה נכשלה. נסי שוב.';
          } finally {
            switches.forEach((item) => {
              item.disabled = false;
            });
          }
        });
      });
      const error = card.querySelector<HTMLElement>('[data-action-error]')!;
      const fallback = card.querySelector<HTMLAnchorElement>('[data-external-fallback]')!;
      async function saveAndOpen(form: HTMLFormElement, target: string, confirm: string) {
        const button = form.querySelector<HTMLButtonElement>('button')!;
        button.disabled = true;
        error.hidden = true;
        try {
          const response = await fetch('/api/client_workflow', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          if (!response.ok || !(await response.json()).saved) throw new Error('Save failed');
          const scheduled = new FormData(form).get('scheduled');
          if (typeof scheduled === 'string') {
            const deadline = deliveryDeadline({ workflow: { scheduled } });
            const label = card.querySelector<HTMLElement>('[data-delivery-deadline]');
            if (deadline && label) {
              label.className = 'mt-3 text-gray-700';
              label.textContent = `מסירת תמונות עד ${displayDay(deadline)} · ${deliveryLabel(deadline)}`;
            }
          }
          fallback.href = target;
          fallback.hidden = false;
          card.querySelector<HTMLElement>(confirm)!.hidden = false;
          button.classList.replace('btn-primary', 'btn-secondary');
          openClientApp(target, card.querySelector<HTMLElement>('[aria-label="השלב הנוכחי"]'));
        } catch {
          error.textContent = 'לא ניתן לשמור כרגע. נסי שוב; השלב הבא עדיין לא סומן.';
          error.hidden = false;
        } finally {
          button.disabled = false;
        }
      }
      card.querySelector<HTMLFormElement>('[data-calendar-form]')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const data = new FormData(form);
        const start = String(data.get('scheduled'));
        const end = new Date(Date.parse(start + 'Z') + Number(data.get('duration')) * 3600000)
          .toISOString()
          .slice(0, 19);
        const format = (date: string) => date.replace(/[-:]/g, '');
        const params = new URLSearchParams({
          action: 'TEMPLATE',
          text: `${card.dataset.type} - ${card.dataset.name}`,
          dates: `${format(start + ':00')}/${format(end)}`,
          ctz: 'Asia/Jerusalem',
          location: String(data.get('location') || ''),
          details: `לקוח: ${card.dataset.name}\nטלפון: ${card.dataset.phone}`,
          add: [card.dataset.email, 'sjmikee@gmail.com'].filter(Boolean).join(','),
        });
        void saveAndOpen(form, `https://calendar.google.com/calendar/render?${params}`, '[data-calendar-confirm]');
      });
      card.querySelector<HTMLFormElement>('[data-delivery]')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        try {
          const link = safeWebUrl(form.querySelector<HTMLInputElement>('[data-airbridge]')!.value);
          const pixieset = safeWebUrl(new FormData(form).get('pixieset'));
          const message = `היי ${card.dataset.name}! התמונות שלך מוכנות ❤️\n\nגלריה לצפייה ותמונות לנייד:\n${pixieset}\n\nתמונות בגודל מלא:\n${link}\n\nחשוב להוריד את התמונות המלאות בתוך 3 ימים ממועד ההעלאה, לפני שהקישור יפוג.`;
          void saveAndOpen(form, `${card.dataset.wa}?text=${encodeURIComponent(message)}`, '[data-delivery-confirm]');
        } catch {
          error.textContent = 'יש להזין שני קישורי HTTPS תקינים.';
          error.hidden = false;
        }
      });
      if (card.dataset.currentStep === 'signed' && card.dataset.contractSigned !== 'true') {
        let checking = false;
        let dirty = false;
        const onInput = () => {
          dirty = true;
        };
        document.addEventListener('input', onInput);
        async function checkSignature() {
          if (!card.isConnected) {
            clearInterval(interval);
            window.removeEventListener('focus', checkSignature);
            document.removeEventListener('input', onInput);
            return;
          }
          if (checking || dirty || document.hidden) return;
          if (card.parentElement instanceof HTMLDetailsElement && !card.parentElement.open) return;
          checking = true;
          try {
            const response = await fetch(`/api/session_status?session_id=${card.dataset.sessionId}`);
            if (response.ok && (await response.json()).signed) location.reload();
          } catch {
            /* The refresh link remains available. */
          } finally {
            checking = false;
          }
        }
        const interval = window.setInterval(checkSignature, 20000);
        window.addEventListener('focus', checkSignature);
        document.addEventListener(
          'astro:before-swap',
          () => {
            clearInterval(interval);
            window.removeEventListener('focus', checkSignature);
            document.removeEventListener('input', onInput);
          },
          { once: true }
        );
      }
    });
  }
  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLElement>('[data-session-actions]').forEach((actions) => {
      if (actions.contains(event.target as Node)) return;
      actions.querySelector<HTMLElement>('[data-session-actions-menu]')!.hidden = true;
      actions.querySelector('[data-session-actions-toggle]')!.setAttribute('aria-expanded', 'false');
    });
  });
  init();
  document.addEventListener('astro:page-load', init);
</script>
