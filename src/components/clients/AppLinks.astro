<script>
  import { openClientApp } from '~/lib/client-app-links';
  document.addEventListener('click', (event) => {
    if (
      !location.pathname.startsWith('/clients') ||
      event.defaultPrevented ||
      event.button !== 0 ||
      event.metaKey ||
      event.ctrlKey ||
      event.shiftKey ||
      event.altKey
    )
      return;
    const anchor = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
    if (!anchor || anchor.dataset.clientWebFallback || anchor.target === '_blank') return;
    const url = new URL(anchor.href);
    if (url.hostname !== 'wa.me' && url.hostname !== 'calendar.google.com') return;
    event.preventDefault();
    openClientApp(anchor.href, anchor.closest<HTMLElement>('section, article, main'));
  });
  document.addEventListener('client:open-app', (event) => {
    if (!location.pathname.startsWith('/clients')) return;
    const { url } = (event as CustomEvent<{ url: string }>).detail;
    openClientApp(url, document.getElementById('contractNext'));
  });
</script>
