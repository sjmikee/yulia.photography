---
import { localeFromPath } from '~/i18n/routes';
import { ui } from '~/i18n/ui';
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import type { Price } from '~/types';
interface Props {
  prices: Price[];
}
const { prices } = Astro.props;
const labels = ui(localeFromPath(Astro.url.pathname));
---

<div class="package-grid">
  {
    prices?.map(
      ({ title, subtitle, price, period, items, callToAction, hasRibbon = false, ribbonTitle, id, highlight }) =>
        price != null && (
          <article
            id={id}
            class:list={[
              'package intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
              { 'package-featured': hasRibbon },
            ]}
          >
            {hasRibbon && ribbonTitle && <p class="package-recommendation">{ribbonTitle}</p>}
            {title && <h3>{title}</h3>}
            <p class="package-price">
              <span>{price}</span> {labels.currency}
            </p>
            {period && <p class="package-period">{period}</p>}
            {highlight && <p class="package-highlight">{highlight}</p>}
            {subtitle && <p class="package-subtitle">{subtitle}</p>}
            {items && (
              <ul>
                {items.map(
                  ({ description, icon, classes }) =>
                    description && (
                      <li>
                        <Icon name={icon || 'tabler:check'} aria-hidden="true" />
                        <span class={classes?.description}>{description}</span>
                      </li>
                    )
                )}
              </ul>
            )}
            {callToAction && (
              <div class="package-action">
                {typeof callToAction === 'string' ? (
                  <Fragment set:html={callToAction} />
                ) : (
                  callToAction.href && <Button variant={hasRibbon ? 'primary' : 'secondary'} {...callToAction} />
                )}
              </div>
            )}
          </article>
        )
    )
  }
</div>
<style>
  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    width: 100%;
  }
  .package {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--site-border, #d8ddda);
    border-radius: 10px;
    background: var(--aw-color-bg-page);
    text-align: start;
  }
  .package-featured {
    border-color: var(--aw-color-accent);
    background: color-mix(in srgb, var(--aw-color-accent) 3%, var(--aw-color-bg-page));
  }
  .package-recommendation {
    font-size: 0.75rem;
    position: absolute;
    top: -0.75rem;
    inset-inline-start: 1.5rem;
    background: var(--aw-color-accent);
    color: white;
    padding: 0.15rem 0.65rem;
    border-radius: 2px;
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }
  .package-price {
    margin: 1rem 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .package-price span {
    font-size: 2.6rem;
    font-weight: 500;
    line-height: 1.2;
  }
  .package-period,
  .package-subtitle {
    font-size: 0.9rem;
    color: var(--aw-color-text-muted);
  }
  .package-highlight {
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  ul {
    list-style: none;
    padding: 1.5rem 0;
    margin: 1.25rem 0 0;
    border-top: 1px solid var(--site-border, #d8ddda);
  }
  li {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.65;
  }
  li svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }
  .package-action {
    margin-top: auto;
    padding-top: 0.75rem;
  }
  .package-action :global(.btn) {
    width: 100%;
  }
  @media (max-width: 899px) {
    .package-grid {
      grid-template-columns: 1fr;
      max-width: 600px;
      margin: auto;
      gap: 1.75rem;
    }
    .package {
      padding: 1.5rem;
    }
  }
</style>
