---
import Button from './Button.astro';
import type { CallToAction } from '~/types';
interface Props {
  id?: string;
  title: string;
  description: string;
  action: CallToAction;
  phone?: { href: string; label: string };
}
const { id, title, description, action, phone } = Astro.props;
---

<section id={id} class="contact-invitation">
  <h2>{title}</h2>
  <p>{description}</p>
  <Button variant="primary" {...action} />
  {
    phone && (
      <a class="contact-phone" href={phone.href}>
        {phone.label}
      </a>
    )
  }
</section>
