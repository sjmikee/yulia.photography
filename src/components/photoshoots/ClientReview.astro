---
import { Icon } from 'astro-icon/components';
import { clientReviews, googleProfileUrl, sessionLabels } from '~/i18n/client-reviews';
import { localeFromPath } from '~/i18n/routes';

interface Props {
  reviewer: keyof typeof clientReviews;
}

const { reviewer } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const review = clientReviews[reviewer];
const translation = locale === 'he' ? 'תרגום מרוסית' : 'перевод с иврита';
const ratingLabel = locale === 'he' ? `${review.rating} מתוך 5 כוכבים` : `${review.rating} из 5 звёзд`;
---

<figure id="reviews" class="review-card">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
    <span class="review-stars" role="img" aria-label={ratingLabel}>
      <span aria-hidden="true">{'★'.repeat(review.rating)}</span>
    </span>
    <a class="review-link" href={googleProfileUrl}>
      {locale === 'he' ? 'לביקורות בגוגל' : 'Отзывы в Google'}
      <Icon name="tabler:external-link" width={15} height={15} aria-hidden="true" />
    </a>
  </div>
  <blockquote class="review-quote"><p>{review[locale]}</p></blockquote>
  <figcaption class="review-author">
    <bdi class="font-semibold text-heading">{review.name}</bdi>
    <span>{sessionLabels[review.session][locale]}</span>
    {locale !== review.original && <small>{translation}</small>}
  </figcaption>
</figure>

<style>
  .review-card {
    width: min(calc(100% - 2rem), 44rem);
    margin: 1.5rem auto;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--site-border);
    border-radius: var(--site-radius-panel, 10px);
    background: color-mix(in srgb, var(--aw-color-bg-page) 45%, white);
    box-shadow: 0 4px 18px rgb(35 50 55 / 5%);
    text-align: start;
  }
  :global(.dark) .review-card {
    background: var(--site-surface);
  }
  .review-stars {
    color: #a36a10;
    font:
      1.125rem/1.2 system-ui,
      sans-serif;
    letter-spacing: 0.08em;
  }
  :global(.dark) .review-stars {
    color: #f2c16a;
  }
  .review-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 1.75rem;
    color: var(--aw-color-text-muted);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .review-link:hover {
    color: var(--aw-color-text-heading);
  }
  .review-quote {
    margin-block: 0.75rem 1.125rem;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    font-weight: 400;
    line-height: 1.6;
    white-space: pre-line;
    letter-spacing: normal;
    color: var(--aw-color-text-heading);
  }
  .review-author {
    display: grid;
    gap: 0.125rem;
    border-block-start: 1px solid var(--site-border);
    padding-block-start: 0.875rem;
    color: var(--aw-color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .review-author bdi {
    justify-self: start;
    font-size: 1rem;
  }
</style>
