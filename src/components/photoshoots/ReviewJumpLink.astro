---
import { clientReviews } from '~/i18n/client-reviews';
import { localeFromPath } from '~/i18n/routes';

interface Props {
  reviewer: keyof typeof clientReviews;
}
const locale = localeFromPath(Astro.url.pathname);
const rating = clientReviews[Astro.props.reviewer].rating;
---

<a href="#reviews" class="mt-2 inline-flex min-h-8 items-center gap-2 text-sm">
  <span class="text-amber-700 dark:text-amber-300" aria-hidden="true">{'★'.repeat(rating)}</span>
  <span class="underline underline-offset-4"
    >{locale === 'he' ? 'לקריאת חוות הדעת מגוגל' : 'Прочитать отзыв из Google'}</span
  >
</a>
