---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  image: ImageMetadata;
  alt: string;
  imageFirst?: boolean;
}
const { image, alt, imageFirst = true } = Astro.props;
---

<section class="mx-auto grid max-w-5xl items-center gap-8 px-4 py-12 md:grid-cols-2">
  <Image
    src={image}
    alt={alt}
    widths={[400, 640, 900]}
    sizes="(min-width: 768px) 45vw, 100vw"
    loading="lazy"
    class:list={['w-full rounded-2xl', { 'order-2': !imageFirst }]}
  />
  <div class="space-y-4"><slot /></div>
</section>
