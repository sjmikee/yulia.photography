---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'photoswipe/style.css';
interface Props {
  layout?: 'masonry' | 'grid';
  images: Array<{ image: ImageMetadata; alt: string }>;
}
const { images, layout = 'masonry' } = Astro.props;
const photos = await Promise.all(
  images.map(async ({ image, alt }) => ({
    image,
    alt,
    full: await getImage({ src: image, width: Math.min(1800, image.width) }),
  }))
);
---

<photoshoot-gallery
  class:list={[
    layout === 'grid' ? 'grid grid-cols-2 gap-4 md:grid-cols-4' : 'block columns-2 gap-4 space-y-4 md:columns-3',
  ]}
>
  {
    photos.map(({ image, alt, full }) => (
      <a
        href={full.src}
        data-pswp-width={full.attributes.width}
        data-pswp-height={full.attributes.height}
        aria-label={`הגדלת תמונה: ${alt}`}
        class="block break-inside-avoid overflow-hidden rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        <Image
          src={image}
          alt={alt}
          widths={[240, 400, 640, 800]}
          sizes={
            layout === 'grid'
              ? '(min-width: 1024px) 240px, (min-width: 768px) 23vw, 46vw'
              : '(min-width: 1152px) 360px, (min-width: 768px) 31vw, 46vw'
          }
          loading="lazy"
          class:list={[
            'w-full transition duration-300 hover:scale-[1.02] motion-reduce:transition-none',
            layout === 'grid' ? 'aspect-[2/3] h-full object-cover' : 'h-auto',
          ]}
        />
      </a>
    ))
  }
</photoshoot-gallery>
<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  class PhotoshootGallery extends HTMLElement {
    lightbox?: PhotoSwipeLightbox;
    connectedCallback() {
      if (this.lightbox) return;
      this.lightbox = new PhotoSwipeLightbox({
        gallery: this,
        children: 'a',
        pswpModule: () => import('photoswipe'),
        closeTitle: 'סגירה',
        zoomTitle: 'הגדלה',
        arrowPrevTitle: 'התמונה הקודמת',
        arrowNextTitle: 'התמונה הבאה',
        errorMsg: 'לא ניתן לטעון את התמונה כרגע.',
      });
      this.lightbox.init();
    }
    disconnectedCallback() {
      this.lightbox?.destroy();
      this.lightbox = undefined;
    }
  }
  if (!customElements.get('photoshoot-gallery')) customElements.define('photoshoot-gallery', PhotoshootGallery);
</script>

<style>
  :global(.pswp__counter) {
    direction: ltr;
  }
</style>
