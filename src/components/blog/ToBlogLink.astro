---
import { Icon } from 'astro-icon/components';
import { getBlogPermalink } from '~/utils/permalinks';
import { localeFromPath } from '~/i18n/routes';
import { blogLink } from '~/i18n/blog';
const locale = localeFromPath(Astro.url.pathname);
const isRussian = locale === 'ru';

import Button from '~/components/ui/Button.astro';

const textDirection = isRussian ? 'ltr' : 'rtl';
---

<div class="mx-auto px-6 sm:px-6 max-w-3xl pt-8 md:pt-4 pb-12 md:pb-20">
  <Button variant="secondary" class="px-3 md:px-3" href={blogLink(getBlogPermalink(), locale)}>
    {
      textDirection === 'rtl' ? (
        <Icon name="tabler:chevron-right" class="w-5 h-5 mr-1 -ml-1.5 rtl:-mr-1.5 rtl:ml-1" />
      ) : (
        <Icon name="tabler:chevron-left" class="w-5 h-5 mr-1 -ml-1.5 rtl:-mr-1.5 rtl:ml-1" />
      )
    }
    {isRussian ? 'К статьям' : 'חזרה לבלוג'}
  </Button>
</div>
