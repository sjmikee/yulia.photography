---
import { localeFromPath } from '~/i18n/routes';
import { ui } from '~/i18n/ui';
const labels = ui(localeFromPath(Astro.url.pathname));
---

<button
  aria-label={labels.top}
  id="scrollToTop"
  tabindex="-1"
  aria-hidden="true"
  class="z-50 fixed bottom-35 right-6 p-3 bg-gray-800/30 w-13 text-white rounded-lg shadow-md border border-white/80 backdrop-blur-sm transition-[transform,opacity] motion-reduce:transition-none transform scale-0 opacity-0 pointer-events-none focus-visible:outline-hidden focus-visible:ring-3 focus-visible:ring-primary dark:focus-visible:ring-gray-200 ease-in duration-200"
>
  <span class="sr-only">{labels.top}</span> ↑
</button>

<style>
  :global(body:has(#header.expanded)) #scrollToTop {
    display: none;
  }
</style>
