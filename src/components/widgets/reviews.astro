---
import { localeFromPath } from '~/i18n/routes';
import { homeMessages } from '~/i18n/home';
const locale = localeFromPath(Astro.url.pathname);
const t = homeMessages('reviews', locale);
import { Image } from 'astro:assets';

import tali_review from '~/assets/reviewers/tali_review.jpg';
import ira_review from '~/assets/reviewers/ira_review.jpg';
import cristina_review from '~/assets/reviewers/cristina_review.jpg';
import WidgetWrapper from '../ui/WidgetWrapper.astro';
---

<!-- המלצות -->
<section class="bg-gray-50 dark:bg-slate-900 py-16 px-6" id="reviews">
  <WidgetWrapper>
    <h2 class="text-3xl font-bold text-center mb-10 dark:text-white">{t('title')}</h2>
    <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      <blockquote
        class="bg-white dark:bg-slate-700 p-6 rounded-2xl shadow intersect-once motion-safe:intersect:animate-fade motion-safe:opacity-0 intersect-quarter"
      >
        <p class="dark:text-gray-200">
          <span class="text-yellow-400 text-lg">★★★★★</span>
          <br />
          {t('cristinaStart')}
          <strong>{t('cristinaEmphasis')}</strong>
          {t('cristinaEnd')}
        </p>
        <footer class="mt-4 font-bold flex items-center">
          <Image src={cristina_review} alt="" class="w-10 h-10 rounded-full mr-3" width={40} height={40} />
          <span class="mx-2 dark:text-gray-200"> {t('cristinaName')}</span>
        </footer>
      </blockquote>
      <blockquote
        class="bg-white dark:bg-slate-700 p-6 rounded-2xl shadow intersect-once motion-safe:intersect:animate-fade motion-safe:opacity-0 intersect-quarter"
      >
        <p class="dark:text-gray-200">
          <span class="text-yellow-400 text-lg">★★★★★</span>
          <br />
          {t('iraStart')}
          <strong>{t('iraEmphasis')}</strong>
          {t('iraMiddle')}
          <strong>{t('iraClosingEmphasis')}</strong>{t('iraEnd')}
        </p>
        <footer class="mt-4 font-bold flex items-center">
          <Image src={ira_review} alt="" class="w-10 h-10 rounded-full mr-3" width={40} height={40} />
          <span class="mx-2 dark:text-gray-200"> {t('iraName')}</span>
        </footer>
      </blockquote>
      <blockquote
        class="bg-white dark:bg-slate-700 p-6 rounded-2xl shadow intersect-once motion-safe:intersect:animate-fade motion-safe:opacity-0 intersect-quarter"
      >
        <p class="dark:text-gray-200">
          <span class="text-yellow-400 text-lg">★★★★★</span>
          <br />
          {t('taliStart')}
          <strong>{t('taliEmphasis')}</strong>
          {t('taliEnd')}
        </p>
        <footer class="mt-4 font-bold flex items-center">
          <Image src={tali_review} alt="" class="w-10 h-10 rounded-full mr-3" width={40} height={40} />
          <span class="mx-2 dark:text-gray-200"> {t('taliName')}</span>
        </footer>
      </blockquote>
    </div>
  </WidgetWrapper>
</section>
