---
import type { ContentType } from '~/types';
import type { ImageMetadata } from 'astro';
interface Props extends ContentType {
  images?: Array<{ src: ImageMetadata; alt: string }>;
}
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '../ui/WidgetWrapper.astro';
import 'photoswipe/style.css';

const { 
  title,
  subTitle,
  text,
  images = [],

  id,
  isDark,
  classes,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`text-center max-w-7xl mx-auto ${classes?.container ?? ''}`}
  bg={bg}
>
    <h1 class="mb-2 font-bold text-5xl tracking-tight text-heading dark:text-white"><div set:text={title} /></h1>
    <h2 class="mb-2 font-bold text-lg tracking-tight text-accent dark:text-white"><div set:text={subTitle} /></h2>

    
    <div data-gallery-grid class="columns-2 md:columns-4 gap-4 space-y-4">
        {images.map((image) => (
            <a href={image.src.src} data-pswp-width={image.src.width} data-pswp-height={image.src.height}>
            {
            <Image
                class="w-full rounded-lg shadow"
                width={image.src.width}
                height={image.src.height}
                loading="eager"
                {...image}
            />
            }
            </a>
        ))}
    </div>

    <h3 class="my-4 w-full font-normal text-muted dark:text-gray-200"><div set:text={text} /></h3>
    
    <hr class="mt-10 sm:mt-20 h-px border-t-0 bg-transparent bg-linear-to-r from-transparent via-accent to-transparent opacity-50 dark:via-neutral-400" />
</WidgetWrapper>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  function initGalleries() {
    document.querySelectorAll<HTMLElement>('[data-gallery-grid]').forEach((gallery) => {
      if (gallery.dataset.initialized) return;
      gallery.dataset.initialized = 'true';
      const lightbox = new PhotoSwipeLightbox({
        gallery,
        children: 'a',
        pswpModule: () => import('photoswipe'),
      });
      lightbox.init();
      document.addEventListener('astro:before-swap', () => lightbox.destroy(), { once: true });
    });
  }
  document.addEventListener('astro:page-load', initGalleries);
  initGalleries();
</script>
