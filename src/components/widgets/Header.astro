---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import LanguageSwitch from '~/components/common/LanguageSwitch.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import { localeFromPath } from '~/i18n/routes';
import { ui } from '~/i18n/ui';
interface MenuLink {
  text?: string;
  href?: string;
  links?: MenuLink[];
}
interface Props {
  links?: MenuLink[];
  actions?: unknown[];
  position?: string;
  isSticky?: boolean;
  showToggleTheme?: boolean;
  showInstagramLink?: boolean;
}
const { links = [], isSticky = false, showToggleTheme = false, showInstagramLink = false } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const labels = ui(locale);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const home = locale === 'ru' ? '/ru' : '/';
const inquiry = locale === 'ru' ? 'Обсудить съёмку' : 'בואו נדבר';
const message =
  locale === 'ru' ? 'Здравствуйте, Юлия! Хочу обсудить фотосессию.' : 'היי יוליה, אשמח לשמוע על סשן צילום.';
---

<site-navigation class:list={['site-header', { 'is-sticky': isSticky }]}>
  <header class="header-inner">
    <a class="brand" href={home} aria-label={locale === 'ru' ? 'Главная' : labels.home}><Logo /></a>
    <div class="mobile-language">
      <LanguageSwitch />{
        showInstagramLink && (
          <a
            class="instagram-link"
            href="https://www.instagram.com/koren_yulia/"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="tabler:brand-instagram" aria-hidden="true" />
          </a>
        )
      }
    </div>
    <button
      class="menu-toggle"
      type="button"
      aria-label={labels.menu}
      aria-expanded="false"
      aria-controls="site-navigation-menu"
    >
      <Icon name="tabler:menu-2" class="menu-icon" aria-hidden="true" />
      <Icon name="tabler:x" class="close-icon" aria-hidden="true" />
    </button>
    <nav id="site-navigation-menu" aria-label={labels.navigation}>
      <ul class="nav-links">
        {
          links.map(({ text, href, links: children }) => (
            <li>
              {children?.length ? (
                <details class="nav-group">
                  <summary>
                    {text}
                    <Icon name="tabler:chevron-down" aria-hidden="true" />
                  </summary>
                  <ul class="nav-children">
                    {href && (
                      <li>
                        <a href={href} aria-current={current === href ? 'page' : undefined}>
                          {locale === 'ru' ? `Все: ${text}` : `לכל ${text}`}
                        </a>
                      </li>
                    )}
                    {children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={current === child.href ? 'page' : undefined}>
                          {child.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a class="nav-link" href={href} aria-current={current === href ? 'page' : undefined}>
                  {text}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mobile-contact">
        <a
          class="btn-primary"
          href={`https://wa.me/972525836940?text=${encodeURIComponent(message)}`}
          target="_blank"
          rel="noopener noreferrer">{inquiry}</a
        >
      </div>
    </nav>
    <div class="header-tools">
      <LanguageSwitch />
      {
        showInstagramLink && (
          <a
            class="instagram-link"
            href="https://www.instagram.com/koren_yulia/"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="tabler:brand-instagram" aria-hidden="true" />
          </a>
        )
      }
      {showToggleTheme && <ToggleTheme label={labels.theme} iconClass="w-4 h-4" />}
      <a
        class="header-inquiry"
        href={`https://wa.me/972525836940?text=${encodeURIComponent(message)}`}
        target="_blank"
        rel="noopener noreferrer">{inquiry}</a
      >
    </div>
  </header>
</site-navigation>
<script>
  class SiteNavigation extends HTMLElement {
    controller?: AbortController;
    cleanup?: () => void;
    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      const { signal } = this.controller;
      const toggle = this.querySelector<HTMLButtonElement>('.menu-toggle');
      const groups = [...this.querySelectorAll<HTMLDetailsElement>('details')];
      const header = this.querySelector<HTMLElement>('.header-inner');
      const resize = new ResizeObserver(() => {
        this.style.setProperty('--navigation-header-height', `${this.getBoundingClientRect().height}px`);
      });
      resize.observe(this);
      let previousOverflow: string | undefined;
      const unlock = () => {
        if (previousOverflow !== undefined) document.body.style.overflow = previousOverflow;
        previousOverflow = undefined;
      };
      this.cleanup = () => {
        unlock();
        resize.disconnect();
      };
      const close = (restoreFocus = false) => {
        unlock();
        this.classList.remove('menu-open');
        toggle?.setAttribute('aria-expanded', 'false');
        groups.forEach((group) => {
          group.open = false;
        });
        if (restoreFocus) toggle?.focus();
      };
      toggle?.addEventListener(
        'click',
        () => {
          const open = this.classList.toggle('menu-open');
          toggle.setAttribute('aria-expanded', String(open));
          if (open) {
            previousOverflow = document.body.style.overflow;
            document.body.style.overflow = 'hidden';
          } else close();
        },
        { signal }
      );
      groups.forEach((group) =>
        group.addEventListener(
          'toggle',
          () => {
            if (group.open)
              groups.forEach((other) => {
                if (other !== group) other.open = false;
              });
          },
          { signal }
        )
      );
      this.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Tab' && this.classList.contains('menu-open')) {
            const focusable = [...(header?.querySelectorAll<HTMLElement>('a, button, summary') || [])].filter(
              (element) => element.getClientRects().length > 0
            );
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last?.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first?.focus();
            }
          }
          if (event.key !== 'Escape') return;
          const openGroup = groups.find((group) => group.open);
          if (openGroup) {
            openGroup.open = false;
            openGroup.querySelector('summary')?.focus();
          } else if (this.classList.contains('menu-open')) close(true);
        },
        { signal }
      );
      document.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Node && !this.contains(event.target)) close();
        },
        { signal }
      );
      this.addEventListener(
        'click',
        (event) => {
          if (event.target instanceof Element && event.target.closest('a')) close();
        },
        { signal }
      );
      const breakpoint = window.matchMedia('(min-width: 1100px)');
      breakpoint.addEventListener('change', () => close(), { signal });
    }
    disconnectedCallback() {
      this.cleanup?.();
      this.controller?.abort();
      this.controller = undefined;
    }
  }
  if (!customElements.get('site-navigation')) customElements.define('site-navigation', SiteNavigation);
</script>
<style>
  .site-header {
    display: block;
    z-index: 50;
    background: color-mix(in srgb, var(--aw-color-bg-page) 78%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--site-border);
  }
  .is-sticky {
    position: sticky;
    top: 0;
  }
  .header-inner {
    min-height: 88px;
    padding: 0 clamp(1.25rem, 3vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1800px;
    margin: auto;
  }
  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand :global(span) {
    display: block;
    margin: 0;
    line-height: 0;
  }
  .brand :global(img) {
    max-width: 105px;
  }
  nav {
    min-width: 0;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.15rem, 1vw, 1rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link,
  summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem 0.5rem;
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    width: 12px;
    height: 12px;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .nav-group {
    position: relative;
  }
  .nav-children {
    position: absolute;
    inset-inline-start: 0;
    top: 100%;
    min-width: 230px;
    max-width: 310px;
    padding: 0.65rem;
    margin: 0;
    background: color-mix(in srgb, var(--aw-color-bg-page) 78%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--site-border);
    border-radius: 12px;
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.06);
    list-style: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    details[open] .nav-children,
    .menu-open nav {
      animation: menu-reveal 0.25s ease-out;
    }
  }
  @keyframes menu-reveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .nav-children a {
    display: block;
    font-size: 0.9rem;
    padding: 0.7rem 0.8rem;
    border-radius: 6px;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  .nav-children a:hover,
  .nav-children a[aria-current] {
    background: var(--aw-color-accent);
    color: white;
  }
  .nav-link:hover,
  summary:hover,
  .nav-link[aria-current] {
    color: var(--aw-color-accent);
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }
  .instagram-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 6px;
    transition: color 160ms ease;
  }
  .instagram-link:hover {
    color: var(--aw-color-accent);
  }
  .instagram-link svg {
    width: 21px;
    height: 21px;
  }
  .header-inquiry {
    padding: 0.7rem 1.1rem;
    background: var(--aw-color-accent);
    color: white;
    font-size: 0.85rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  .header-inquiry:hover {
    opacity: 0.85;
  }
  .mobile-language,
  .menu-toggle,
  .mobile-contact {
    display: none;
  }
  @media (max-width: 1099px) {
    :global(body:has(site-navigation.menu-open) #scrollToTop),
    :global(body:has(site-navigation.menu-open) #whatsapp) {
      display: none;
    }
    .header-inner {
      min-height: 78px;
      gap: 0.6rem;
    }
    .brand :global(img) {
      max-width: 90px;
    }
    .header-tools {
      display: none;
    }
    .mobile-language {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      margin-inline-start: auto;
    }
    .menu-toggle {
      display: grid;
      place-items: center;
      height: 44px;
      width: 44px;
      cursor: pointer;
    }
    .menu-toggle svg {
      width: 24px;
      height: 24px;
    }
    .close-icon,
    .menu-open .menu-icon {
      display: none;
    }
    .menu-open .close-icon {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline: 0;
      height: calc(100dvh - var(--navigation-header-height, 88px) + 1px);
      overflow: auto;
      overscroll-behavior: contain;
      background: var(--aw-color-bg-page);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--site-border);
      padding: 1rem 1.5rem max(2rem, env(safe-area-inset-bottom));
      box-shadow: 0 16px 24px rgb(0 0 0 / 0.05);
    }
    .menu-open nav {
      display: flex;
      flex-direction: column;
    }
    .nav-links {
      display: block;
    }
    .nav-links > li {
      border-bottom: 1px solid var(--site-border);
    }
    .nav-link,
    summary {
      padding: 1rem 0.25rem;
      font-size: 1rem;
      justify-content: space-between;
    }
    .nav-children {
      position: static;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-radius: 0;
      min-width: 0;
      max-width: none;
      border: 0;
      box-shadow: none;
      padding: 0 0.75rem 0.75rem;
    }
    .nav-children a {
      padding: 0.7rem 0.65rem;
    }
    .mobile-contact {
      display: block;
      padding-top: 2rem;
      margin-top: auto;
    }
  }
  @media (max-width: 359px) {
    .header-inner {
      padding-inline: 0.75rem;
      gap: 0.25rem;
    }
    .brand :global(img) {
      max-width: 75px;
    }
    .mobile-language :global(a) {
      padding-inline: 0.35rem;
    }
  }
</style>
