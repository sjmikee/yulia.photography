---
import 'swiper/css/bundle';

import Image from '~/components/common/Image.astro';

const images = Astro.props.images;
---

<!-- Slider main container -->
<div class="swiper">
  <!-- Additional required wrapper -->
  <div class="swiper-wrapper">
    <!-- Slides -->
    {
      images.map((image) => (
        <div class="swiper-slide">{<Image width={image.src.width} height={image.src.height} {...image} />}</div>
      ))
    }
  </div>
</div>

<script src="/js/swiper-bundle.min.js" defer></script>
<script is:inline>
  function initSliders() {
    if (typeof Swiper === 'undefined') return;
    const sliders = document.querySelectorAll('.swiper');

    sliders.forEach((slider) => {
      if (slider.swiper) return;
      new Swiper(slider, {
        direction: 'horizontal',
        autoplay: {
          delay: 1500,
          pauseOnMouseEnter: true,
        },
        effect: 'slide',
        keyboard: {
          enabled: true,
          onlyInViewport: true,
        },
        simulateTouch: true,
        updateOnWindowResize: true,
        loop: true,
        speed: 400,
        autoHeight: true,
        slidesPerView: 2,
        spaceBetween: 10,
      });
    });
  }

  window.addEventListener('load', initSliders);
  window.addEventListener('pageshow', initSliders);
  document.addEventListener('astro:page-load', initSliders);
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll('.swiper').forEach((slider) => slider.swiper?.destroy(true, true));
  });

  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initSliders();
  }
</script>
