---
import type { ContentType as Props } from '~/types';
import Button from '~/components/ui/Button.astro';
import WidgetWrapper from '../ui/WidgetWrapper.astro';
import PhotoGallery from './PhotoGallery.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';

const {
  title,
  subTitle,
  text,
  callToAction,
  actions,
  imagesFolder = '',
  galleryImages,
  galleryLayout,

  id,
  isDark,
  classes,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
const buttons = actions ?? (callToAction ? [callToAction] : []);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <h2 class="mb-2 font-bold text-2xl md:text-3xl tracking-tight text-heading dark:text-white">
    <div set:text={title} />
  </h2>
  <h3 class="mb-2 font-bold text-lg tracking-tight text-accent dark:text-white"><div set:text={subTitle} /></h3>

  {
    galleryImages ? (
      <Gallery images={galleryImages} layout={galleryLayout} />
    ) : (
      <PhotoGallery imagesFolder={imagesFolder} />
    )
  }
  <div
    class="mx-auto px-6 sm:px-6 prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 mt-8 prose-headings:scroll-mt-[80px]"
  >
    <h3 class="mb-4 w-full text-lg font-normal text-muted dark:text-gray-200"><div set:text={text} /></h3>
    {
      buttons.length > 0 && (
        <div class="not-prose mt-4 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          {buttons.map((action) => (
            <Button variant="secondary" {...action} />
          ))}
        </div>
      )
    }
    <hr
      class="mt-10 sm:mt-20 h-px border-t-0 bg-transparent bg-linear-to-r from-transparent via-accent to-transparent opacity-50 dark:via-neutral-400"
    />
  </div>
</WidgetWrapper>
