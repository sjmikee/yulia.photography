---
import type { CallToAction } from '~/types';
import Button from '~/components/ui/Button.astro';
export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
}
const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction = await Astro.slots.render('callToAction'),
  callToAction2 = await Astro.slots.render('callToAction2'),
} = Astro.props;
---

<section
  class="page-introduction intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  {tagline && <p class="intro-context" set:html={tagline} />}
  {title && <h1 set:html={title} />}
  {subtitle && <p class="intro-description" set:html={subtitle} />}
  {
    (callToAction || callToAction2) && (
      <div class="intro-actions">
        {[callToAction, callToAction2].map(
          (action, index) =>
            action &&
            (typeof action === 'string' ? (
              <Fragment set:html={action} />
            ) : (
              <Button variant={index === 0 ? 'primary' : 'secondary'} {...action} />
            ))
        )}
      </div>
    )
  }
  {content && <div class="intro-note" set:html={content} />}
</section>
<style>
  .page-introduction {
    max-width: 1000px;
    margin: auto;
    padding: 3rem 1.5rem 1.5rem;
    text-align: center;
  }
  .intro-context {
    font-size: 0.85rem;
    color: var(--aw-color-text-muted);
    margin-bottom: 1rem;
  }
  h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.2;
    font-weight: 500;
  }
  .intro-description {
    max-width: 60ch;
    margin: 1.25rem auto 0;
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .intro-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .intro-note {
    max-width: 70ch;
    margin: 1.25rem auto 0;
    font-size: 0.9rem;
    color: var(--aw-color-text-muted);
  }
  @media (max-width: 599px) {
    .page-introduction {
      padding-top: 2rem;
    }
    .intro-actions {
      gap: 0.5rem;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .intro-actions :global(.btn) {
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
    }
  }
</style>
