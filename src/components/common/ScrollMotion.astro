<script>
  let cleanup = () => {};

  function startScrollMotion() {
    cleanup();
    const main = document.querySelector('.public-site #main-content');
    if (!main || !('IntersectionObserver' in window)) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const compact = window.matchMedia('(max-width: 699px)');
    const direction = document.documentElement.dir === 'rtl' ? -1 : 1;
    const candidates = Array.from(
      main.querySelectorAll<HTMLElement>(
        'h2, .section-intro > p, .home-about > div > p, .home-process li, #reviews blockquote, .home-cta > p, .pricing-invitation > div'
      )
    ).filter((element) => !element.querySelector('img, picture, video'));
    const candidateSet = new Set(candidates);
    const targets = candidates
      .filter((element) => {
        let parent = element.parentElement;
        while (parent && !candidateSet.has(parent)) parent = parent.parentElement;
        return !parent;
      })
      .map((element, index) => ({
        element,
        heading: element.matches('h2'),
        alternate: index % 2 === 0 ? 1 : -1,
        original: {
          translate: element.style.translate,
          rotate: element.style.rotate,
          scale: element.style.scale,
          transformOrigin: element.style.transformOrigin,
        },
        top: 0,
        left: 0,
        width: 0,
        height: 0,
      }));
    const byElement = new Map(targets.map((target) => [target.element, target]));
    const active = new Set<(typeof targets)[number]>();
    let frame = 0;

    function reset() {
      targets.forEach(({ element, original }) => Object.assign(element.style, original));
    }

    function measure() {
      // Measure the resting layout, never the previous frame's transformed box.
      // This keeps the choreography stable as images and fonts finish loading.
      reset();
      for (const target of targets) {
        const rect = target.element.getBoundingClientRect();
        target.top = rect.top + window.scrollY;
        target.left = rect.left;
        target.width = rect.width;
        target.height = rect.height;
      }
      schedule();
    }

    function update() {
      frame = 0;
      if (reducedMotion.matches) return;
      const viewportHeight = window.innerHeight;
      const viewportWidth = document.documentElement.clientWidth;
      for (const target of active) {
        const { element, heading, top, left, width, height } = target;
        if (!width || !height) continue;
        const progress = Math.max(
          -1,
          Math.min(1, (top - window.scrollY + height / 2 - viewportHeight / 2) / (viewportHeight / 2 + height / 2))
        );
        const sweep = Math.sin((progress * Math.PI) / 2);
        const center = Math.cos((progress * Math.PI) / 2);
        const rotation = heading ? -sweep * direction * (compact.matches ? 0.8 : 2) : 0;
        const radians = (Math.abs(rotation) * Math.PI) / 180;
        const rotatedWidth = width * Math.cos(radians) + height * Math.sin(radians);
        const desiredScale = heading ? 1 + center * (compact.matches ? 0.035 : 0.1) : 1;
        // Keep even long, rotated Hebrew/Russian headings inside the viewport.
        const scale = Math.min(desiredScale, (viewportWidth - 24) / rotatedWidth);
        const edge = (rotatedWidth * scale - width) / 2;
        const desiredX = heading ? sweep * direction * (compact.matches ? 22 : 72) : 0;
        const x = Math.max(12 - left + edge, Math.min(viewportWidth - 12 - left - width - edge, desiredX));
        const y = heading
          ? -center * (compact.matches ? 3 : 8)
          : sweep * target.alternate * (compact.matches ? 10 : 24);
        element.style.transformOrigin = 'center';
        element.style.translate = `${x.toFixed(2)}px ${y.toFixed(2)}px`;
        element.style.rotate = `${rotation.toFixed(3)}deg`;
        element.style.scale = scale.toFixed(4);
      }
    }

    function schedule() {
      if (!frame && !reducedMotion.matches) frame = requestAnimationFrame(update);
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const target = byElement.get(entry.target as HTMLElement);
          if (!target) continue;
          if (entry.isIntersecting) active.add(target);
          else active.delete(target);
        }
        schedule();
      },
      { rootMargin: '160px 0px' }
    );
    const resize = new ResizeObserver(measure);
    resize.observe(main);
    targets.forEach(({ element }) => {
      observer.observe(element);
      resize.observe(element);
    });
    const onPreferenceChange = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      if (reducedMotion.matches) reset();
      else measure();
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure);
    reducedMotion.addEventListener('change', onPreferenceChange);
    measure();
    cleanup = () => {
      observer.disconnect();
      resize.disconnect();
      cancelAnimationFrame(frame);
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', measure);
      reducedMotion.removeEventListener('change', onPreferenceChange);
      reset();
    };
  }

  document.addEventListener('astro:page-load', startScrollMotion);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
