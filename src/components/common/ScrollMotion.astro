<script>
  let cleanup = () => {};

  function startScrollMotion() {
    cleanup();
    const main = document.querySelector('.public-site #main-content');
    if (!main || !('IntersectionObserver' in window)) return;

    // Keep touch devices and reduced-motion browsing completely static.
    const motion = window.matchMedia(
      '(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)'
    );
    motion.addEventListener('change', startScrollMotion);
    cleanup = () => motion.removeEventListener('change', startScrollMotion);
    if (!motion.matches) return;

    // Animate only complete, outermost sections. Their text and photography
    // stay together, and nested widgets never receive a second animation.
    const sections = Array.from(main.querySelectorAll<HTMLElement>('section')).filter(
      (section) => !section.parentElement?.closest('section')
    );
    const animations = new Set<Animation>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          // Anchor navigation and keyboard focus should reveal content immediately.
          if (entry.target.contains(document.activeElement) || entry.boundingClientRect.top < 0) continue;
          const animation = entry.target.animate(
            [
              { opacity: 0.7, transform: 'scale(0.985)', transformOrigin: 'center top' },
              { opacity: 1, transform: 'scale(1)', transformOrigin: 'center top' },
            ],
            { duration: 850, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
          );
          animations.add(animation);
          animation.onfinish = () => animations.delete(animation);
        }
      },
      { threshold: 0, rootMargin: '0px 0px -48px 0px' }
    );
    // The opening view is ready immediately, including restored scroll positions.
    // Content remains visible even without JavaScript or before the observer runs.
    sections.forEach((section) => {
      if (section.getBoundingClientRect().top >= window.innerHeight) observer.observe(section);
    });
    const finishOnFocus = () => {
      animations.forEach((animation) => animation.finish());
    };
    main.addEventListener('focusin', finishOnFocus);
    cleanup = () => {
      observer.disconnect();
      animations.forEach((animation) => animation.cancel());
      animations.clear();
      main.removeEventListener('focusin', finishOnFocus);
      motion.removeEventListener('change', startScrollMotion);
    };
  }

  document.addEventListener('astro:page-load', startScrollMotion);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
