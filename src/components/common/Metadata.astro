---
import { localeFromPath, isIndexablePage, languageAlternates } from '~/i18n/routes';
import { ui } from '~/i18n/ui';
import { homeMessages } from '~/i18n/home';

import { METADATA } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const defaults = homeMessages('home', locale);
const seoProps = {
  title: title || defaults('metaTitle'),
  titleTemplate: '%s',
  canonical,
  noindex: !(robots.index ?? METADATA?.robots?.index ?? false),
  nofollow: !(robots.follow ?? METADATA?.robots?.follow ?? false),
  description: description || defaults('metaDescription'),
  openGraph: {
    ...METADATA?.openGraph,
    ...openGraph,
    url: openGraph.url || canonical,
  },
  twitter: {
    cardType: 'summary_large_image',
    ...METADATA?.twitter,
    ...twitter,
  },
};

seoProps.titleTemplate = ignoreTitleTemplate || !title ? '%s' : `%s — ${ui(locale).name}`;
seoProps.openGraph.site_name = ui(locale).name;
seoProps.openGraph.locale = locale === 'ru' ? 'ru_IL' : 'he_IL';
// Replace image arrays instead of deep-merging fields from unrelated default images.
seoProps.openGraph.images = (
  openGraph.images?.length
    ? openGraph.images
    : [
        {
          url: '~/assets/images/about_photo.jpg',
          alt: locale === 'ru' ? 'Фотограф Юлия Коренская' : 'הצלמת יוליה קורנסקי',
        },
      ]
).map((image) => ({ ...image, alt: image.alt || title || defaults('metaTitle') }));
const resolvedTitle = seoProps.titleTemplate.replace('%s', seoProps.title);
if (!isIndexablePage(Astro.url.pathname)) seoProps.noindex = true;
const alternates = languageAlternates(Astro.url.pathname);
const resolvedOpenGraph = await adaptOpenGraphImages(seoProps?.openGraph, Astro.site);
---

{alternates.map(({ language, path }) => <link rel="alternate" hreflang={language} href={String(getCanonical(path))} />)}
{/* Title with optional template */}
<title>
  {resolvedTitle}
</title>

{seoProps.description && <meta name="description" content={seoProps.description} />}
{seoProps.canonical && <link rel="canonical" href={seoProps.canonical} />}

<meta
  name="robots"
  content={`${seoProps.noindex ? 'noindex' : 'index'},${seoProps.nofollow ? 'nofollow' : 'follow'}`}
/>

{seoProps.title && <meta property="og:title" content={resolvedTitle} />}
{seoProps.description && <meta property="og:description" content={seoProps.description} />}
{resolvedOpenGraph?.url && <meta property="og:url" content={resolvedOpenGraph.url} />}
{resolvedOpenGraph?.site_name && <meta property="og:site_name" content={resolvedOpenGraph.site_name} />}
{resolvedOpenGraph?.type && <meta property="og:type" content={resolvedOpenGraph.type} />}
{resolvedOpenGraph?.locale && <meta property="og:locale" content={resolvedOpenGraph.locale} />}

{
  resolvedOpenGraph?.images?.map((image) => {
    const { url, width, height, alt } = image;

    return (
      <>
        <meta property="og:image" content={url} />
        {width && <meta property="og:image:width" content={String(width)} />}
        {height && <meta property="og:image:height" content={String(height)} />}
        {alt && <meta property="og:image:alt" content={alt} />}
      </>
    );
  })
}

{resolvedOpenGraph?.images?.[0] && <meta name="twitter:image" content={resolvedOpenGraph.images[0].url} />}
{resolvedOpenGraph?.images?.[0]?.alt && <meta name="twitter:image:alt" content={resolvedOpenGraph.images[0].alt} />}
{
  alternates
    .filter(({ language }) => language !== locale && language !== 'x-default')
    .map(({ language }) => <meta property="og:locale:alternate" content={language === 'ru' ? 'ru_IL' : 'he_IL'} />)
}
{seoProps.twitter?.cardType && <meta name="twitter:card" content={seoProps.twitter.cardType} />}
{seoProps.twitter?.site && <meta name="twitter:site" content={seoProps.twitter.site} />}
{seoProps.twitter?.handle && <meta name="twitter:creator" content={seoProps.twitter.handle} />}
{seoProps.title && <meta name="twitter:title" content={resolvedTitle} />}
{seoProps.description && <meta name="twitter:description" content={seoProps.description} />}
