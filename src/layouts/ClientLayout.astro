---
import { Icon } from 'astro-icon/components';
import Layout from './Layout.astro';
import FormBehavior from '~/components/clients/FormBehavior.astro';
import LandingHeader from '~/components/widgets/LandingHeader.astro';
import ScrollToTopButton from '~/components/widgets/ScrollToTopButton.astro';
const { title, subtitle = 'פרטי הלקוח, הצילומים וכל מה שצריך להמשך הדרך' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const sections = [
  { href: '/clients/dashboard', label: 'מה על הפרק', icon: 'tabler:calendar-event' },
  { href: '/clients/overview', label: 'תמונת מצב עסקית', icon: 'tabler:chart-bar' },
  { href: '/clients', label: 'לקוחות', icon: 'tabler:users' },
];
const activeSection = sections.find((section) => section.href === pathname)?.href ?? '/clients';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Layout metadata={{ title, robots: { index: false, follow: false } }}>
  <div id="client-loading" class="client-loading" role="status" hidden>טוענת…</div>
  <div class="client-workspace" lang="he" dir="rtl">
    <a href="#client-content" class="client-skip">דילוג לתוכן</a>
    <LandingHeader isSticky />
    <main id="client-content" class="client-area" tabindex="-1">
      <div class="client-navigation">
        <a class="client-add" href="/clients/add"><span aria-hidden="true">+</span> לקוח חדש</a>
        <nav class="client-tabs" aria-label="ניהול לקוחות">
          {
            sections.map(({ href, label, icon }) => (
              <a
                class="client-tab"
                href={href}
                aria-current={activeSection === href ? (pathname === href ? 'page' : 'location') : undefined}
              >
                <Icon name={icon} width="18" height="18" aria-hidden="true" />
                {label}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="client-page-heading">
        {
          pathname !== activeSection && (
            <a class="client-back" href="/clients">
              חזרה ללקוחות
            </a>
          )
        }
        <h1>{title}</h1>
        <p>{subtitle}</p>
      </div>
      <slot />
    </main>
    <footer class="client-footer">יוליה קורנסקי <span dir="ltr">yulia.photography</span></footer>
  </div>
  <FormBehavior />
  <ScrollToTopButton />
</Layout>
<script>
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';
  let navigation = 0;
  document.addEventListener('astro:before-preparation', (event) => {
    const indicator = document.getElementById('client-loading');
    if (!indicator) return;
    const current = ++navigation;
    const transition = event as TransitionBeforePreparationEvent;
    const loader = transition.loader;
    indicator.hidden = false;
    queueMicrotask(() => {
      if (event.defaultPrevented) indicator.hidden = true;
    });
    transition.loader = async () => {
      try {
        await loader();
      } finally {
        if (current === navigation) indicator.hidden = true;
      }
    };
  });
</script>
<style is:global>
  .client-workspace :is(button, a, input, select, textarea, summary) {
    touch-action: manipulation;
    -webkit-tap-highlight-color: rgb(35 50 55 / 15%);
  }
  .client-workspace :is(h1, h2, h3) {
    text-wrap: balance;
  }
  .client-workspace :is(p, summary, li) {
    overflow-wrap: anywhere;
  }
  .client-workspace [data-session-card] {
    font-variant-numeric: tabular-nums;
  }
  .client-workspace [data-session-history] {
    content-visibility: auto;
    contain-intrinsic-size: auto 80px;
  }
  .client-tab:hover,
  .client-back:hover {
    color: var(--studio-red);
  }
  .client-workspace {
    --studio-red: #e00004;
    --studio-ink: #262624;
    --studio-muted: #626866;
    --studio-line: #dedfdd;
    color: var(--studio-ink);
    background: #f5f5f5;
    min-height: 100vh;
    color-scheme: light;
  }
  .client-area {
    max-width: 1160px;
    margin: auto;
    padding: 0 clamp(1rem, 4vw, 2rem) 3rem;
  }
  .client-navigation {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--studio-line);
  }
  .client-tabs {
    display: flex;
    flex: 1;
    min-width: 0;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .client-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 1.2rem 0;
    min-height: 48px;
    border-bottom: 3px solid transparent;
    color: var(--studio-muted);
    font-weight: 600;
    white-space: nowrap;
  }
  .client-tab[aria-current] {
    color: var(--studio-red);
    border-color: currentColor;
  }
  .client-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--studio-red);
    color: white;
    border-radius: 9px;
    padding: 0.65rem 1rem;
    min-height: 44px;
    font-weight: 600;
    white-space: nowrap;
  }
  .client-add span {
    font-size: 1.4rem;
    line-height: 1;
  }
  .client-page-heading {
    padding: 2rem 0 1.75rem;
    text-align: start;
    position: relative;
  }
  .client-page-heading h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.25;
    overflow-wrap: anywhere;
    color: var(--studio-ink);
  }
  .client-page-heading p {
    margin-top: 0.65rem;
    color: var(--studio-muted);
    max-width: 65ch;
    line-height: 1.7;
  }
  .client-back {
    display: inline-block;
    margin-bottom: 1rem;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 0.875rem;
  }
  .client-area .panel {
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid var(--studio-line);
    border-radius: 16px;
    background: white;
    color: var(--studio-ink);
    box-shadow: none;
    margin-bottom: 1.25rem;
    min-width: 0;
  }
  .client-area input:not([type='checkbox']):not([type='radio']),
  .client-area select,
  .client-area textarea {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    border: 1px solid #b7bdbb;
    border-radius: 6px;
    padding: 0.75rem;
    background: white;
    color: var(--studio-ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  .client-area input:read-only {
    background: #f5f5f5;
  }
  /* iOS gives native date/time controls an intrinsic width and inner padding. */
  .client-area input:is([type='date'], [type='datetime-local'], [type='time'], [type='month']) {
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
    display: block;
    min-inline-size: 0;
    inline-size: 100%;
    max-inline-size: 100%;
    min-block-size: 3rem;
  }
  .client-area input::-webkit-date-and-time-value {
    min-width: 0;
    text-align: start;
  }
  .client-area input::-webkit-datetime-edit {
    padding: 0;
  }
  .client-area input[type='tel'],
  .client-area input[type='email'] {
    direction: ltr;
    text-align: start;
  }
  .client-area label {
    display: grid;
    gap: 0.5rem;
    font-weight: 500;
    min-width: 0;
  }
  .client-area .btn-secondary {
    border-color: #b7bdbb;
    background: white;
    color: #233237;
    box-shadow: none;
  }
  .client-area .btn-secondary:hover {
    border-color: #233237;
    background: #f5f5f5;
  }
  .client-area .btn-primary {
    background: var(--studio-red);
    border-color: var(--studio-red);
    color: white;
    box-shadow: none;
  }
  .client-area .btn-primary:hover,
  .client-add:hover {
    background: #bb0003;
  }
  .client-workspace :focus-visible {
    outline: 3px solid #233237;
    outline-offset: 3px;
  }
  .client-area button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .client-area summary {
    cursor: pointer;
    font-weight: 600;
    padding-block: 0.75rem;
  }
  .client-area [id] {
    scroll-margin-top: 6rem;
  }
  .client-area .legacy-form-section {
    max-width: 48rem;
    margin-inline: auto;
  }
  .client-area .legacy-form-section > form {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--studio-line);
    border-radius: 16px;
    border-top: 3px solid #233237;
    box-shadow: 0 6px 24px rgb(35 50 55 / 3%);
  }
  .client-empty {
    display: grid;
    justify-items: start;
    gap: 0.8rem;
    padding: 2rem;
    background: white;
    border: 1px dashed var(--studio-line);
    border-radius: 16px;
    color: var(--studio-muted);
  }
  .client-empty h2 {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--studio-ink);
  }
  .client-area .btn-primary,
  .client-area .btn-secondary {
    gap: 0.5rem;
    border-radius: 9px;
  }
  .client-area [data-session-history] {
    border: 1px solid var(--studio-line);
    border-radius: 12px;
    background: white;
  }
  .client-area [data-session-card] > header {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--studio-line);
  }
  .client-area [data-session-card] {
    border-top: 3px solid #233237;
  }
  .client-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1096px;
    margin: auto;
    padding: 1.5rem 1rem;
    border-top: 1px solid var(--studio-line);
    color: var(--studio-muted);
    font-size: 0.875rem;
  }
  .client-skip {
    position: fixed;
    top: -100px;
    z-index: 100;
    background: white;
    padding: 1rem;
  }
  .client-skip:focus {
    top: 1rem;
  }
  .client-loading {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 0.4rem 1rem;
    background: #233237;
    color: white;
    text-align: center;
    pointer-events: none;
  }
  @media (max-width: 600px) {
    .client-navigation {
      flex-wrap: wrap;
      gap: 0;
      padding-bottom: 0.75rem;
    }
    .client-tabs {
      order: -1;
      flex-basis: 100%;
      justify-content: flex-start;
      gap: 1rem;
      overflow-x: auto;
      font-size: 0.875rem;
    }
    .client-tab svg {
      display: none;
    }
    .client-tab {
      padding-block: 1rem;
    }
    .client-add {
      margin-top: 0.75rem;
      margin-inline-end: auto;
      font-size: 0.875rem;
    }
    .client-page-heading {
      padding-block: 1.5rem;
    }
    .client-area .btn-primary,
    .client-area .btn-secondary {
      min-height: 44px;
      padding-inline: 1rem;
    }
    .client-footer {
      flex-wrap: wrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-workspace *,
    .client-workspace *::before,
    .client-workspace *::after {
      transition: none !important;
      animation: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
