---
import Layout from './Layout.astro';
import LandingHeader from '~/components/widgets/LandingHeader.astro';
import ScrollToTopButton from '~/components/widgets/ScrollToTopButton.astro';
const { title, subtitle = 'כל הלקוחות והצילומים שלך, במקום אחד ❤️' } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const sections = [
  { href: '/clients/dashboard', label: 'מה על הפרק' },
  { href: '/clients/overview', label: 'תמונת מצב עסקית' },
  { href: '/clients', label: 'לקוחות' },
];
const activeSection = sections.find((section) => section.href === pathname)?.href ?? '/clients';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Layout metadata={{ title, robots: { index: false, follow: false } }}>
  <div id="client-loading" class="client-loading" role="status" hidden>טוענת…</div>
  <LandingHeader isSticky />
  <section class="bg-gray-50 py-16 px-6 text-center" dir="rtl">
    <h1 class="text-3xl font-bold mb-4">{title}</h1>
    <p class="text-lg text-gray-700 max-w-2xl mx-auto">{subtitle}</p>
  </section>
  <main dir="rtl" class="client-area max-w-4xl mx-auto py-10 px-6">
    <div class="client-navigation">
      <nav class="client-tabs" aria-label="ניהול לקוחות">
        {
          sections.map(({ href, label }) => (
            <a
              class="client-tab"
              href={href}
              aria-current={activeSection === href ? (pathname === href ? 'page' : 'location') : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>
      <a class="client-add" href="/clients/add"><span aria-hidden="true">+</span> לקוח חדש</a>
    </div>
    <slot />
  </main>
  <footer class="bg-footer text-white py-8 text-center">
    <p class="mb-4 font-bold">יוליה קורנסקי | yulia.photography</p>
    <p>ניהול לקוחות ❤️</p>
  </footer>
  <ScrollToTopButton />
</Layout>
<script>
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';
  let navigation = 0;
  document.addEventListener('astro:before-preparation', (event) => {
    const indicator = document.getElementById('client-loading');
    if (!indicator) return;
    const current = ++navigation;
    const transition = event as TransitionBeforePreparationEvent;
    const loader = transition.loader;
    indicator.hidden = false;
    transition.loader = async () => {
      try {
        await loader();
      } finally {
        if (current === navigation) indicator.hidden = true;
      }
    };
  });
</script>
<style>
  .client-loading {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding: 0.4rem 1rem;
    background: #262624;
    color: white;
    text-align: center;
    font-size: 0.875rem;
    pointer-events: none;
  }
  .client-navigation {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #d1d5db;
  }
  .client-tabs {
    display: flex;
    flex: 1;
    min-width: 0;
    gap: clamp(1rem, 3vw, 2rem);
    overflow-x: auto;
  }
  .client-tab {
    flex-shrink: 0;
    padding: 1rem 0.25rem;
    border-bottom: 3px solid transparent;
    color: #6b7280;
    font-weight: 600;
    white-space: nowrap;
    transition:
      color 150ms,
      border-color 150ms;
  }
  .client-tab:hover {
    color: #262624;
    border-bottom-color: #9ca3af;
  }
  .client-tab[aria-current] {
    color: #e00004;
    border-bottom-color: currentColor;
  }
  .client-tab:focus-visible {
    outline-offset: -3px;
  }
  .client-add {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
    padding: 0.625rem 0;
    color: #374151;
    font-weight: 600;
    white-space: nowrap;
  }
  .client-add span {
    font-size: 1.25rem;
    line-height: 1;
  }
  .client-add:hover {
    color: #e00004;
  }
  @media (max-width: 540px) {
    .client-navigation {
      flex-wrap: wrap;
      gap: 0.25rem;
      border-bottom: 0;
    }
    .client-tabs {
      flex-basis: 100%;
      border-bottom: 1px solid #d1d5db;
      font-size: 0.875rem;
    }
    .client-add {
      margin-inline-start: auto;
      font-size: 0.875rem;
    }
  }
  :global(.dark) .client-tab {
    color: #aeb8c8;
  }
  :global(.dark) .client-tab:hover,
  :global(.dark) .client-add {
    color: #e5ecf6;
  }
  :global(.dark) .client-tab[aria-current],
  :global(.dark) .client-add:hover {
    color: #fda4af;
  }
</style>
<style is:global>
  .client-area input,
  .client-area select,
  .client-area textarea {
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    padding: 0.75rem;
    background: white;
    color: #1f2937;
    width: 100%;
  }
  .client-area label {
    display: grid;
    gap: 0.5rem;
  }
  .client-area .panel {
    padding: clamp(1.25rem, 4vw, 2rem);
    border-radius: 1rem;
    background: white;
    color: #1f2937;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    margin-bottom: 1.5rem;
  }
  .client-area :focus-visible {
    outline: 3px solid var(--aw-color-primary);
    outline-offset: 3px;
  }
  .client-area button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .client-area summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>
