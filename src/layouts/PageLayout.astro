---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import ScrollToTopButton from '~/components/widgets/ScrollToTopButton.astro';
import WhatsAppButton from '~/components/widgets/WhatsAppButton.astro';

import { navigation } from '~/i18n/navigation';
import { localeFromPath, russianIndexingEnabled } from '~/i18n/routes';

import type { MetaData, BreadcrumbType } from '~/types';

export interface Props {
  metadata?: MetaData;
  richMetadata?: MetaData;
  breadcrumbs?: BreadcrumbType[];
}

const { metadata, richMetadata, breadcrumbs } = Astro.props;
const { pathname } = new URL(Astro.request.url);
const locale = localeFromPath(pathname);
const { header: headerData, footer: footerData } = navigation(locale);
const isContactPage = pathname === '/contact' || pathname === '/ru/contact';
---

<Layout metadata={metadata} richMetadata={richMetadata} breadcrumbs={breadcrumbs}>
  <slot name="header">
    <Header {...headerData} isSticky showToggleTheme showInstagramLink />
  </slot>
  <main>
    {
      locale === 'ru' && !russianIndexingEnabled && (
        <aside class="mx-auto max-w-6xl px-4 py-3 text-sm text-muted border-b border-gray-200">
          Русская версия готовится: сейчас доступны съёмка беременности, обычная и интимная съёмка для пары,
          индивидуальные портреты, женская, будуарная и семейная съёмка — описание, цены и галереи. Остальные разделы
          пока на иврите.
        </aside>
      )
    }
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
  <ScrollToTopButton />
  {!isContactPage && <WhatsAppButton />}
</Layout>
