---
import '~/assets/styles/tailwind.css';

import '@fontsource-variable/rubik';
import { localeFromPath } from '~/i18n/routes';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import RichSeo from '~/components/common/RichSeo.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import AppLinks from '~/components/clients/AppLinks.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import GtmHead from '~/components/common/GTMHead.astro';
import GtmBody from '~/components/common/GTMBody.astro';
import { Font } from 'astro:assets';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData, MetaData as MetaDataType, BreadcrumbType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  richMetadata?: MetaData;
  breadcrumbs?: BreadcrumbType[];
}

const { metadata = {}, richMetadata = {}, breadcrumbs = [] } = Astro.props;
const language = localeFromPath(Astro.url.pathname);
const textDirection = language === 'ru' ? 'ltr' : 'rtl';
const privatePage = Astro.url.pathname === '/clients' || Astro.url.pathname.startsWith('/clients/');
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    {!privatePage && <GtmHead />}
    <CommonMeta />
    <Favicons />
    {language === 'he' && <Font cssVariable="--font-heebo" preload />}
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <RichSeo metadata={{ ...metadata, ...richMetadata }} breadcrumbs={breadcrumbs} />
    <SiteVerification />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    {!privatePage && <GtmBody />}
    <slot />

    <BasicScripts />
    {privatePage && <AppLinks />}
  </body>
</html>
