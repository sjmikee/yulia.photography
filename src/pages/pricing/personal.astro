---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import PackageComparison from '~/components/photoshoots/PackageComparison.astro';
import PricingCards from '~/components/ui/PricingCards.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import Button from '~/components/ui/Button.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import {
  personalJourney,
  personalPackages,
  personalPricingCards,
  personalWhatsApp,
  personalService,
} from '~/lib/personal';
import { personalHeroImage as hero, personalFeaturedImages } from '~/lib/personal-gallery';
const metadata = {
  title: 'מחירון צילומי בוק אישי - יוליה קורנסקי',
  description: `כמה עולה בוק אישי? חבילות ב־${personalPackages.map((p) => p.price).join(', ')} ש״ח, עם הכוונה ועריכה מלאה. השוו זמן צילום, כמות תמונות ותנאי הזמנה לסשן אישי במרכז.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/solo_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/pricing', name: 'מחירון' },
  { url: '/pricing/personal', name: 'מחירון בוק אישי' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={personalService} />
  <LeadTracking service="personal">
    <HeroText
      tagline="הפריים שלך. החבילה שמתאימה לך."
      title="מחירון צילומי בוק אישי"
      subtitle={`צילום אישי החל מ־${personalPackages[0].price} ש״ח. למזכרת, לפרופיל חדש או כמתנה — עם הכוונה גם בפעם הראשונה מול המצלמה.`}
      content="בוחרים כמה זמן וכמה תמונות. ההכוונה האישית והעריכה המלאה כבר בפנים."
      callToAction={{ text: 'להשוואת החבילות', href: '#packages' }}
      callToAction2={{
        text: 'לעזרה בבחירה ובדיקת תאריך',
        href: personalWhatsApp(),
        target: '_blank',
        'data-lead-source': 'personal-pricing-hero',
      }}
    />
    <Breadcrumbs
      items={[{ label: 'דף הבית', href: '/' }, { label: 'מחירון', href: '/pricing' }, { label: 'מחירון בוק אישי' }]}
    />
    <Journey journey={personalJourney} current="pricing" />
    <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
      <h2 class="mb-4 text-center text-3xl font-bold">כמה עולה צילום בוק אישי?</h2>
      <p class="mb-8 text-center">
        המחיר נע בין {personalPackages[0].price} ל־{personalPackages[2].price} ש״ח. כמות התמונות מתייחסת לתמונות בעריכה מלאה;
        משך הצילום משוער.
      </p>
      <PackageComparison
        packages={[...personalPackages].reverse()}
        label="השוואת חבילות בוק אישי"
        caption="מחיר, משך צילום וכמות תמונות בעריכה מלאה"
      />
      <div class="mt-8"><PricingCards prices={personalPricingCards} /></div>
    </section>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">איזו חבילה מתאימה לך?</h2>
      <p>
        <strong>בסיס</strong> מתאימה לסשן קצר וממוקד. <strong>קלאסית</strong> נותנת יותר זמן להיכנס לקצב ולגוון בפריימים.
        <strong>פרימיום</strong> מיועדת למי שרוצים אוסף רחב יותר, עם עד שתי תלבושות והפסקות לפי הצורך.
      </p>
      <p>
        אם לוקח לך רגע להרגיש בנוח, אפשר לבחור יותר זמן לנשום בין התמונות. אם המטרה ממוקדת, יכול להיות שהבסיס מספיקה.
        אפשר לספר לי מה חשוב לך ונבחר יחד — לא צריך להזמין הפקת שער כדי לעדכן תמונת פרופיל.
      </p>
      <h2 class="text-2xl font-bold">מה כלול במחיר?</h2>
      <p>
        הכוונה לפני הצילום וטיפים ללבוש, ליווי לאורך הסשן, כמות התמונות המפורטת בחבילה בעריכה מוקפדת ומלאה וגלריה
        דיגיטלית באיכות גבוהה להורדה. התמונות נמסרות עד 14 ימי עסקים מיום הצילום.
      </p>
      <p>
        הצילום מתקיים בעיקר בחוץ במרכז הארץ. סטודיו אפשר לתאם מראש; עלות שכירות, אם נדרשת, תיבדק לפני ההזמנה. איפור,
        שיער ואלבום מודפס אינם מפורטים כחלק מהחבילות.
      </p>
      <p>
        <a class="font-semibold underline" href="/services/personal-photography"
          >איך נראה הסשן, מה לובשים ואיך מתכוננים?</a
        >
      </p>
    </section>
    <section id="booking" class="scroll-mt-28 mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">איך שומרים תאריך?</h2>
      <ol class="list-decimal space-y-4 ps-6">
        <li><strong>מתכננים.</strong> בוחרים חבילה, מקום ותאריך, ומדברים על מטרת התמונות והלבוש.</li>
        <li><strong>משריינים.</strong> מקדמה של 100 ש״ח בעת ההזמנה שומרת את המועד ביומן.</li>
        <li>
          <strong>מצטלמים.</strong> אני מכוונת במהלך הסשן ועורכת את התמונות. הגלריה תגיע עד 14 ימי עסקים מיום הצילום.
        </li>
      </ol>
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">אם התוכניות משתנות</h3><p>
          המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד. דחייה אפשרית בהודעה עד 24 שעות מראש ובתיאום מועד חלופי
          שמתאים לשני הצדדים. במקרה של גשם או מחלה, עדכנו אותי בהקדם.
        </p>
      </div>
    </section>
    <section class="mx-auto max-w-5xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">לפני שבוחרים חבילה, מכירים את הסגנון</h2>
      <Gallery images={personalFeaturedImages} />
      <Button href="/gallery/solo">לגלריית הבוק האישי המלאה</Button>
    </section>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">מתנה שלא נשארת בארון</h2>
      <p>
        שובר לבוק אישי יכול להתאים ליום הולדת, להתחלה חדשה או לאדם שכבר מזמן רוצה תמונות של עצמו. כדאי להשאיר את בחירת
        התאריך והאווירה למי שמצטלמים.
      </p>
      <Button
        variant="primary"
        href={personalWhatsApp('היי יוליה, אשמח לפרטים על שובר מתנה לצילומי בוק אישי.')}
        target="_blank"
        data-lead-source="personal-gift">לפרטים על שובר מתנה</Button
      >
    </section>
    <FAQs
      title="שאלות על המחיר ועל ההזמנה"
      columns={2}
      items={[
        {
          title: 'כמה תמונות מקבלים בכל חבילה?',
          description: `בבסיס ${personalPackages[0].photos}, בקלאסית ${personalPackages[1].photos} ובפרימיום ${personalPackages[2].photos} תמונות בעריכה מלאה. בכל חבילה מקבלים גלריה דיגיטלית באיכות גבוהה להורדה.`,
        },
        {
          title: 'הכוונה כלולה גם בחבילת הבסיס?',
          description:
            'כן. בכל חבילה כלולות הכוונה לפני הצילום, עזרה בבחירת לבוש והכוונה בזמן הסשן. אין צורך בניסיון קודם.',
        },
        {
          title: 'האם שכירת סטודיו כלולה במחיר?',
          description:
            'הצילום מתקיים בעיקר בחוץ. סטודיו אפשר לתאם מראש, ואם נדרשת שכירות נברר את עלותה לפני ההזמנה. אין להניח שהיא כלולה במחיר החבילה.',
        },
        {
          title: 'מתי מקבלים את התמונות?',
          description:
            'עד 14 ימי עסקים מיום הצילום. אם יש מועד פרסום או יום הולדת שחשוב לך להספיק אליו, כדאי לציין זאת לפני קביעת התאריך.',
        },
        {
          title: 'אפשר להחליף בגדים?',
          description:
            'חבילת הפרימיום כוללת עד שתי תלבושות והפסקות לפי הצורך. אם החלפת לבוש חשובה לך בחבילה אחרת, נתאם את האפשרויות מראש.',
        },
        {
          title: 'מה תנאי הביטול והדחייה?',
          description:
            'מקדמה של 100 ש״ח שומרת את התאריך. היא תוחזר בביטול עד 3 ימים לפני המועד. דחייה אפשרית בהודעה עד 24 שעות מראש ובתיאום מועד חלופי יחד.',
        },
      ]}
    />
    <Journey journey={personalJourney} current="pricing" cta />
  </LeadTracking>
</Layout>
