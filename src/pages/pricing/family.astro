---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import WhatssapCallToAction from '~/components/widgets/WhatssapCallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { PRICES } from '~/lib/pricing';


const metadata = {
  title: "מחירון צילומי משפחה | צילום משפחתי לייף סטייל - יוליה קורנסקי",
  description: "מחירון צילומי משפחה עד זוג + שני ילדים. צילום משפחתי טבעי ומרגש, חוויה נעימה לכל המשפחה ותמונות שנשארות לשנים.",
  ignoreTitleTemplate: true,
};

const breadcrumbs = [
    { url: "/pricing", name: "מחירון"},
    { url: "/pricing/family", name: "מחירון צילומי משפחה"},
];

const session_type = "משפחה";
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="רגעים משפחתיים אמיתיים, כמו שאתם"
    title="מחירון צילומי משפחה"
    subtitle="צילומי משפחה טבעיים ולייף סטייל, באווירה רגועה וכיפית שמתאימה גם לילדים."
    content="צילומי משפחה נועדו ללכוד חיבור, צחוק ורגעים קטנים של יחד. הסשן מותאם למשפחות עד זוג + שני ילדים, כל ילד נוסף בתוספת של 100 ₪."
  />

    <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'מחירון', href: '/pricing' },
      { label: 'מחירון צילומי משפחה'}
    ]}
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="הבחירה שלכם"
    subtitle=""
    tagline="החבילות שלי"
    prices={[
      {
        title: 'חבילת פרימיום',
        subtitle: 'חוויה משפחתית עשירה ומרגשת',
        price: PRICES[session_type][3],
        period: 'סשן משפחתי מורחב למשפחה עד זוג + שני ילדים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'כשעתיים של צילומים',
          },
          {
            description: 'עד 2 תלבושות, הפסקות לפי הצורך',
          },
          {
            description: 'לפחות 50 - 70 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גובהה להורדה',
          },
          {
            description: 'כל ילד נוסף בתוספת 100₪',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%9E%D7%A9%D7%A4%D7%97%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%A4%D7%A8%D7%99%D7%9E%D7%99%D7%95%D7%9D%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A.',
        },
      },
      {
        title: 'החבילה הקלאסית',
        subtitle: 'חוויה משפחתית מלאה',
        price: PRICES[session_type][2],
        period: 'מושלם לצילומי משפחה בטבע עד זוג + שני ילדים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'שעה וחצי של צילומים',
          },
          {
            description: 'לפחות 40 - 50 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
          {
            description: 'כל ילד נוסף בתוספת 100₪',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%9E%D7%A9%D7%A4%D7%97%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%94%D7%97%D7%91%D7%99%D7%9C%D7%94%20%D7%94%D7%9E%D7%A9%D7%AA%D7%9C%D7%9E%D7%AA%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A.',
        },
        hasRibbon: true,
        ribbonTitle: 'הכי משתלם',
      },
      {
        title: 'חבילת בסיס',
        subtitle: 'סשן משפחתי קצר',
        price: PRICES[session_type][1],
        period: 'מתאים למשפחה עד זוג + שני ילדים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: '45 דקות של צילומי משפחה',
          },
          {
            description: 'לפחות 30 - 40 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
          {
            description: 'כל ילד נוסף בתוספת 100₪',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%9E%D7%A9%D7%A4%D7%97%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%91%D7%A1%D7%99%D7%A1%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A.',
        },
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="תהליך צילומי משפחה"
    tagline="פשוט, נעים ומותאם למשפחות"
    isReversed={true}
    items={[
      {
        title: 'שיחה ראשונית',
        icon: 'tabler:number-1',
      },
      {
        title: 'סגירת חבילה ותאריך',
        icon: 'tabler:number-2',
      },
      {
        title: 'תשלום על שריון תאריך (100ש״ח)',
        icon: 'tabler:number-3',
      },
      {
        title: 'מצטלמים ונהנים 😊',
        icon: 'tabler:number-4',
      },
      {
        title: 'עריכת התמונות (עד 14 ימי עסקים)',
        icon: 'tabler:number-5',
      },
      {
        title: 'קבלת קישור לגלריה דיגיטלית להורדה',
        icon: 'tabler:number-6',
      },
      {
        title: 'נהנים מתמונות איכותיות ומרגשות 😊',
        icon: 'tabler:number-7',
      },
      {
        title: 'לא שוכחים לתייג אותי 😉',
        icon: 'tabler:number-8',
      },
    ]}
    image={{ src: '~/assets/images/pricing/couples_pricing.jpg', alt: 'צילומי משפחה צילומי משפחה מחירון' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="שאלות נפוצות על צילומי משפחה"
    subtitle="כל מה שחשוב לדעת לפני סשן צילום משפחתי"
    columns={1}
    items={[
      {
        title: 'כמה משתתפים כלולים בצילום משפחתי?',
        description: 'החבילות מתאימות למשפחה עד זוג + שני ילדים. כל ילד נוסף בתוספת של 100₪, בתיאום מראש.'
      },
      {
        title: 'מה קורה אם אחד הילדים לא משתף פעולה?',
        description: 'זה לגמרי טבעי. הסשן מתקיים בסבלנות מלאה ובהתאמה לקצב של הילד, עם הפסקות, משחק וזמן חופשי - כדי לאפשר רגעים טבעיים ואמיתיים.',
      },
      {
        title: 'איפה מתקיימים הצילומים?',
        description:
          'צילומי משפחה יכולים להתקיים בטבע או בסטודיו (בתוספת תשלום). הבחירה נעשית יחד בהתאם לגיל הילדים, לעונה ולאווירה שתרצו ליצור.',
      },
      {
        title: 'את עוזרת עם בגדים / צבעים?',
        description:
          "בוודאי! תקבלו ממני השראה והכוונה לתלבושות שיתאימו ללוקיישן ולוייב.",
      },
      {
        title: 'מה קורה אם יורד גשם או מישהו חולה?',
        description:
          'תמיד אפשר לתאם מועד חלופי - החיים קורים, ואני לגמרי מבינה. עדכנו אותי בהקדם, ונמצא מועד חדש שמתאים לשני הצדדים.',
      },
      {
        title: 'מתי כדאי לסגור תאריך?',
        description:
          'כדאי לסגור תאריך כמה שיותר מראש - במיוחד בעונות המבוקשות.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן. כדי לשמור את התאריך ביומן, יש לשלם מקדמה של ₪100 בעת ההזמנה. (המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד), במקרה של דחיה אם תודיעו עד 24 שעות מראש - נוכל למצוא יחד מועד חלופי.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <WhatssapCallToAction />
</Layout>
