---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Button from '~/components/ui/Button.astro';
import Journey from '~/components/pregnancy/Journey.astro';
import ServiceSchema from '~/components/pregnancy/ServiceSchema.astro';
import { pregnancyPackages, pregnancyWhatsApp, pregnancyChildSupplement } from '~/lib/pregnancy';
import preview from '~/assets/images/pricing/pregnancy_pricing.jpg';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { PRICES } from '~/lib/pricing';

const session_type = 'הריון';
const metadata = {
  title: `צילומי הריון מחיר: החל מ־${PRICES[session_type][1]}₪ | יוליה קורנסקי`,
  description: `כמה עולים צילומי הריון? חבילות ב־${PRICES[session_type][1]}, ${PRICES[session_type][2]} ו־${PRICES[session_type][3]} ש״ח בחולון ובמרכז. השוו זמן צילום, תמונות ערוכות ותוספות. סטודיו בתוספת תשלום.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/images/pricing/pregnancy_pricing.jpg',
        width: preview.width,
        height: preview.height,
        alt: 'צילומי הריון של יוליה קורנסקי',
      },
    ],
  },
};

const breadcrumbs = [
  { url: '/pricing', name: 'מחירון' },
  { url: '/pricing/pregnancy', name: 'מחירון צילומי הריון' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema />

  <HeroText
    tagline="יוליה קורנסקי · חולון ומרכז הארץ"
    title="צילומי הריון — מחירון וחבילות צילום"
    subtitle={`חבילות צילום החל מ־${PRICES[session_type][1]} ש״ח. צילומי הריון בחולון ובמרכז, עם הכוונה אישית וקצב שנוח לך.`}
    content="כל החבילות כוללות הכוונה לפני הצילום, תמונות בעריכה מלאה וגלריה דיגיטלית להורדה. צילום בסטודיו בתוספת תשלום ובתיאום מראש."
    callToAction={{ text: 'להשוואת החבילות', href: '#packages' }}
    callToAction2={{ text: 'לבדיקת תאריך פנוי', href: pregnancyWhatsApp(), target: '_blank' }}
  />

  <Breadcrumbs
    items={[{ label: 'דף הבית', href: '/' }, { label: 'מחירון', href: '/pricing' }, { label: 'מחירון צילומי הריון' }]}
  />
  <section class="mx-auto max-w-4xl px-4 py-8 text-right">
    <h2 class="mb-4 text-2xl font-bold">כמה עולים צילומי הריון?</h2>
    <p class="mb-4">
      <strong>מחיר צילומי הריון אצלי נע בין {PRICES[session_type][1]} ל־{PRICES[session_type][3]} ש״ח.</strong> חבילת הבסיס
      עולה {PRICES[session_type][1]} ש״ח וכוללת 45 דקות צילום; החבילה הקלאסית עולה {PRICES[session_type][2]} ש״ח וכוללת שעה
      וחצי; חבילת הפרימיום עולה {PRICES[session_type][3]} ש״ח וכוללת כשעתיים. ההבדלים בכמות התמונות ובתכולת החבילות מפורטים
      בהמשך.
    </p>
    <p class="mb-4">
      המחירים מתייחסים לצילומי חוץ. סטודיו אפשרי בתוספת תשלום ובתיאום מראש; השתתפות ילדים בצילומי ההריון היא בתוספת 100
      ש״ח לכל ילד.
    </p>

    <p class="mb-4">
      אם את רוצה מזכרת ממוקדת מההריון, חבילת הבסיס מאפשרת סשן קצר עם הכוונה לאורך הדרך. החבילות הארוכות מתאימות כשחשוב
      לך יותר זמן להתרגל למצלמה, לגוון בתמונות או לשלב רגעים זוגיים ומשפחתיים. לא צריך ניסיון בדוגמנות — אני מלווה אותך
      בבחירת הלבוש ובמהלך הצילום.
    </p>
    <p>
      לפני הבחירה, תוכלי להתרשם <a href="/gallery/pregnancy" class="font-semibold underline"
        >מגלריית צילומי ההריון שלי</a
      > ולקרוא <a href="/services/pregnancy-photography" class="font-semibold underline"
        >איך נראה סשן צילומי הריון בטבע ובים</a
      >.
    </p>
  </section>

  <Journey current="pricing" />

  <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-4 text-center text-3xl font-bold">החבילה שמתאימה לך, במבט אחד</h2>
    <p class="mb-8 text-center">כל המחירים לצילומי חוץ. בכל חבילה: הכוונה לפני הצילום, עריכה מלאה וגלריה דיגיטלית.</p>
    <p class="mb-3 text-sm md:hidden">אפשר לגלול את הטבלה לצדדים כדי לראות את כל הפרטים.</p>
    <div
      class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700"
      tabindex="0"
      role="region"
      aria-label="השוואת חבילות צילומי הריון"
    >
      <table class="w-full min-w-[560px] text-right">
        <caption class="sr-only">השוואת מחיר, משך צילום וכמות תמונות בחבילות ההריון</caption>
        <thead class="bg-gray-50 dark:bg-slate-800"
          ><tr
            ><th scope="col" class="p-4">החבילה</th><th scope="col" class="p-4">מחיר</th><th scope="col" class="p-4"
              >זמן צילום</th
            ><th scope="col" class="p-4">תמונות בעריכה מלאה</th></tr
          ></thead
        >
        <tbody
          >{
            pregnancyPackages.map((p) => (
              <tr class="border-t border-gray-200 dark:border-gray-700">
                <th scope="row" class="p-4">
                  <a href={`#${p.id}`} class="underline">
                    {p.title}
                  </a>
                </th>
                <td class="p-4 whitespace-nowrap">{p.price} ש״ח</td>
                <td class="p-4">{p.duration}</td>
                <td class="p-4">{p.photos}</td>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        pregnancyPackages.map((p) => (
          <article
            id={p.id}
            class="flex scroll-mt-24 flex-col rounded-2xl border border-gray-200 p-6 dark:border-gray-700"
          >
            <h3 class="mb-2 text-2xl font-bold">{p.title}</h3>
            <p class="mb-4">{p.fit}</p>
            <p class="mb-4 text-3xl font-bold">
              {p.price} <span class="text-lg">ש״ח</span>
            </p>
            <ul class="mb-6 list-disc space-y-3 ps-5">
              <li>{p.duration} צילום</li>
              <li>{p.photos} תמונות בעריכה מלאה</li>

              <li>הכוונה לפני הצילום וטיפים ללבוש</li>
              <li>גלריה דיגיטלית באיכות גבוהה להורדה</li>

              {p.extra && <li>{p.extra}</li>}
              <li>כל ילד בתוספת {pregnancyChildSupplement} ש״ח</li>
            </ul>
            <Button
              class="mt-auto"
              href={pregnancyWhatsApp(`היי יוליה, אשמח לפרטים ולבדיקת תאריך לצילומי הריון — ${p.title}. אני בשבוע __.`)}
              target="_blank"
            >
              לבדיקת תאריך — {p.title}
            </Button>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl space-y-5 px-4 py-8 text-right">
    <h2 class="text-2xl font-bold">איך לבחור חבילת צילומי הריון?</h2>
    <p>
      <strong>בסיס:</strong> מתאימה אם את מעדיפה 45 דקות ממוקדות ורוצה מזכרת מהתקופה בלי לפנות זמן לסשן ארוך. <strong
        >קלאסית:</strong
      > שעה וחצי שמאפשרת להתרגל למצלמה וליצור מגוון רחב יותר של תמונות. <strong>פרימיום:</strong> כשעתיים, עד שתי תלבושות
      והפסקות לפי הצורך, למי שרוצה יותר זמן וביטוי אישי.
    </p>
    <h2 class="text-2xl font-bold">מה כלול ומה בתוספת תשלום?</h2>
    <p>
      בכל חבילה תקבלי הכוונה לפני הצילום, טיפים ללבוש, תמונות בעריכה מלאה וקישור לגלריה דיגיטלית באיכות גבוהה. העריכה
      אורכת עד 14 ימי עסקים. הסטודיו אינו כלול במחיר החבילה; את התוספת נברר מראש לפי הסשן. אם תרצי לשלב ילדים, התוספת
      היא 100 ש״ח לכל ילד.
    </p>
    <p>
      למשל, חבילת הבסיס בצילומי חוץ עם ילד אחד עולה {PRICES[session_type][1] + pregnancyChildSupplement} ש״ח. כך תוכלי להשוות
      לפי הסכום שמתאים להרכב שלך, ולא רק לפי המחיר ההתחלתי.
    </p>
    <h2 class="text-2xl font-bold">צילומי הריון בחולון ובמרכז — בטבע או בסטודיו?</h2>
    <p>
      צילום בחוץ מתאים למי שאוהבת אור טבעי ומרחב פתוח. בגלריה שלי אפשר לראות צילומים בים ובין העצים ולקבל תחושה של
      הסגנון. נבחר יחד לוקיישן לפי העונה, הנוחות שלך והאווירה שאת מחפשת. אם את מעדיפה סטודיו, נתאם אותו ואת העלות הנוספת
      לפני קביעת הסשן.
    </p>
    <p>
      אפשר לתכנן צילומי הריון בלבוש מלא או לשלב בן או בת זוג. כתבי לי מי מגיע, מה שבוע ההריון שלך ואיזה סגנון אהבת,
      ונבחר יחד את החבילה המתאימה.
    </p>
  </section>

  <!-- Steps Widget ****************** -->

  <Steps
    title="תהליך צילומי הריון"
    tagline="בהקשבה, ברוגע ובקצב שלך"
    isReversed={true}
    items={[
      {
        title: 'שיחה ראשונית',
        icon: 'tabler:number-1',
      },
      {
        title: 'סגירת חבילה ותאריך',
        icon: 'tabler:number-2',
      },
      {
        title: 'תשלום על שריון תאריך (100ש״ח)',
        icon: 'tabler:number-3',
      },
      {
        title: 'מצטלמים ונהנים 😊',
        icon: 'tabler:number-4',
      },
      {
        title: 'עריכת התמונות (עד 14 ימי עסקים)',
        icon: 'tabler:number-5',
      },
      {
        title: 'קבלת קישור לגלריה דיגיטלית להורדה',
        icon: 'tabler:number-6',
      },
      {
        title: 'נהנים מתמונות איכותיות ומרגשות 😊',
        icon: 'tabler:number-7',
      },
      {
        title: 'בוחרים את התמונה האהובה. מותר יותר מאחת.',
        icon: 'tabler:number-8',
      },
    ]}
    image={{ src: '~/assets/images/pricing/pregnancy_pricing.jpg', alt: 'צילומי הריון של יוליה קורנסקי' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="שאלות נפוצות על צילומי הריון"
    subtitle="כל מה שחשוב לדעת לפני סשן צילום הריון"
    columns={1}
    items={[
      {
        title: 'כמה עולה חבילת צילומי הריון בסיסית?',
        description: `חבילת הבסיס עולה ${PRICES[session_type][1]} ש״ח וכוללת 45 דקות צילום, הכוונה לפני הצילום, לפחות 30–40 תמונות בעריכה מלאה וגלריה דיגיטלית. צילום בסטודיו בתוספת תשלום ובתיאום מראש.`,
      },
      {
        title: 'מתי ואיך מקבלים את התמונות?',
        description:
          'התמונות נמסרות עד 14 ימי עסקים מיום הצילום, בקישור לגלריה דיגיטלית באיכות גבוהה להורדה. כמות התמונות נקבעת לפי החבילה שבחרתם.',
      },
      {
        title: 'באיזה שבועות מומלץ לעשות צילומי הריון?',
        description:
          'שבועות 28–34 הם נקודת התחלה לתכנון הצילום, ולא חלון קשיח. נבחר מועד לפי ההרגשה שלך והאופן שבו תרצי לתעד את ההריון.',
      },
      {
        title: 'איפה מתקיימים הצילומים?',
        description:
          'צילומי הריון מתקיימים בצילומי חוץ או בסטודיו. צילום בסטודיו אפשרי בתוספת תשלום ובתיאום מראש. נבחר יחד את הלוקיישן והסגנון שיתאימו לך ולאווירה שתרצי ליצור.',
      },
      {
        title: 'את עוזרת עם בגדים / צבעים?',
        description: 'בוודאי! תקבלו ממני השראה והכוונה לתלבושות שיתאימו ללוקיישן ולוייב.',
      },
      {
        title: 'מה קורה אם יורד גשם או מישהו חולה?',
        description:
          'עדכני אותי בהקדם כדי שנתאם את ההמשך. דחיית סשן למועד חלופי אפשרית בהודעה עד 24 שעות מראש. תנאי החזר המקדמה מופיעים בהמשך.',
      },
      {
        title: 'מתי כדאי לסגור תאריך?',
        description: 'כדאי לסגור תאריך כמה שיותר מראש - במיוחד בעונות המבוקשות.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן. כדי לשמור את התאריך ביומן, יש לשלם מקדמה של ₪100 בעת ההזמנה. (המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד), במקרה של דחיה אם תודיעו עד 24 שעות מראש - נוכל למצוא יחד מועד חלופי.',
      },
    ]}
  />
  <section class="mx-auto max-w-3xl px-4 pb-8 text-right">
    <p>
      רוצה להבין איך נראית חוויית הצילום המלאה ומה מצפה לך ביום הצילומים?
      <a href="/services/pregnancy-photography" class="font-semibold underline"> לכל הפרטים על צילומי הריון </a>
    </p>
  </section>

  <!-- CallToAction Widget *********** -->

  <Journey current="pricing" cta />
</Layout>
