---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import PackageComparison from '~/components/photoshoots/PackageComparison.astro';
import PricingCards from '~/components/ui/PricingCards.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import {
  intimateJourney,
  intimatePackages,
  intimatePricingCards,
  intimateWhatsApp,
  intimateService,
} from '~/lib/couples-intimate';
import { couplesHeroImage as hero, couplesFeaturedImages } from '~/lib/couples-gallery';
// Keep the established pricing URL, title and H1 while improving the buying information.
const metadata = {
  title: 'מחירון צילומי זוגיות אינטימיים ולייף סטייל - יוליה קורנסקי',
  description: `חבילות צילומי זוגיות אינטימיים ב־${intimatePackages.map((p) => p.price).join(', ')} ש״ח. השוו זמן צילום ותמונות בעריכה מלאה. הכוונה אישית, גלריה פרטית וסשן בקצב ובגבולות שלכם.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/couples_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/pricing', name: 'מחירון' },
  { url: '/pricing/couples-intimate', name: 'מחירון צילומי זוגיות אינטימיים' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={intimateService} />
  <LeadTracking service="couples_intimate">
    <HeroText
      tagline="צילום זוגי אינטימי, חושני ומלא רגש"
      title="מחירון צילומי זוגיות אינטימיים"
      subtitle={`זמן להיות יחד, החל מ־${intimatePackages[0].price} ש״ח. סשן בקצב שלכם, עם הכוונה עדינה ובלי צורך לדעת להצטלם.`}
      content="כל החבילות כוללות הכנה אישית, תמונות בעריכה מוקפדת ומלאה וגלריה דיגיטלית פרטית. הלבוש ורמת הקרבה לבחירתכם, ללא חובה לעירום."
      callToAction={{ text: 'להשוואת החבילות', href: '#packages' }}
      callToAction2={{
        text: 'לשיחת ייעוץ ללא התחייבות',
        href: intimateWhatsApp(),
        target: '_blank',
        'data-lead-source': 'intimate-hero',
      }}
    />
    <Breadcrumbs
      items={[
        { label: 'דף הבית', href: '/' },
        { label: 'מחירון', href: '/pricing' },
        { label: 'מחירון צילומי זוגיות אינטימיים' },
      ]}
    />
    <section class="mx-auto max-w-4xl space-y-4 px-4 py-8">
      <h2 class="text-2xl font-bold">כמה עולים צילומי זוגיות אינטימיים?</h2>
      <p>
        <strong>מחיר הסשן נע בין {intimatePackages[0].price} ל־{intimatePackages[2].price} ש״ח.</strong> ההבדל בין החבילות
        הוא זמן הצילום וכמות התמונות בעריכה מלאה. ההכוונה, היחס האישי והפרטיות הם חלק מכל חבילה.
      </p>
      <p>
        הסשן יכול להיות רומנטי ועדין או חושני יותר, כולל צילומי לייף סטייל במרחב פרטי בתיאום. מקום הצילום נקבע יחד; אם
        נדרשת שכירת סטודיו או לוקיישן, נברר את העלות מראש.
      </p>
    </section>
    <Journey journey={intimateJourney} current="pricing" />
    <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
      <h2 class="mb-4 text-center text-3xl font-bold">בחרו את החוויה שמתאימה לכם</h2>
      <p class="mb-8 text-center">כמות התמונות מתייחסת לתמונות בעריכה מלאה. זמני הצילום משוערים לתכנון הסשן.</p>
      <PackageComparison
        packages={[...intimatePackages].reverse()}
        label="השוואת חבילות צילומי זוגיות אינטימיים"
        caption="כמות תמונות בעריכה מלאה, מחיר ומשך צילום משוער"
      />
      <div class="mt-8"><PricingCards prices={intimatePricingCards} /></div>
    </section>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
      <h2 class="text-2xl font-bold">איך בוחרים חבילה?</h2>
      <p>
        <strong>בסיס</strong> מתאימה לאוסף ממוקד של רגעי קרבה. <strong>קלאסית</strong> נותנת יותר זמן להתרגל למצלמה ולגוון.
        <strong>פרימיום</strong> כוללת את האוסף הרחב ביותר, עד שתי תלבושות והפסקות לפי הצורך. חבילה ארוכה יותר אינה אומרת
        צילום חשוף יותר — אתם בוחרים את הסגנון בכל חבילה.
      </p>
      <h2 class="text-2xl font-bold">מה כלול במחיר?</h2>
      <p>
        שיחת הכנה ותיאום ציפיות, טיפים ללבוש, הכוונה לאורך הצילום, התמונות המפורטות בחבילה בעריכה מוקפדת ומלאה וגלריה
        דיגיטלית פרטית באיכות גבוהה להורדה. התמונות נמסרות עד 14 ימי עסקים מיום הצילום.
      </p>
      <p>
        אם תרצו מקום שכור, איפור, שיער או אביזרים מיוחדים, העלו זאת בשיחת ההכנה כדי שנברר מה אפשרי ומה העלות. אלה אינם
        מפורטים כחלק מהחבילות המוצגות.
      </p>
      <h2 class="text-2xl font-bold">לפני הכול — אתם בשליטה</h2>
      <p>
        אין חובה לעירום או לתנוחה שלא נוחה לכם. מתאמים את רמת הקרבה עם שניכם, ואפשר לעצור או לשנות כיוון במהלך הצילום.
        נדבר מראש גם על כל מה שחשוב לכם בנוגע לפרטיות.
      </p>
      <p>
        רוצים להבין איך מתחילים ומה לובשים? <a
          class="font-semibold underline"
          href="/services/intimate-couples-photography">כל הפרטים על סשן זוגיות אינטימי</a
        >.
      </p>
      <h2 class="text-2xl font-bold">מהשיחה הראשונה ועד התמונות</h2>
      <p>
        מכירים, בוחרים חבילה ולוקיישן ומתאמים ציפיות. מקדמה של 100 ש״ח שומרת את התאריך. ביום הצילום מתחילים לאט
        ובהכוונה; אחריו אני עוברת לעריכה, ואתם מקבלים קישור לגלריה הפרטית שלכם.
      </p>
    </section>
    <section class="mx-auto max-w-5xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">רגעים מהגלריה</h2>
      <p>
        לפני שבוחרים חבילה, אפשר להכיר את סגנון הצילום שלי בגלריית הזוגיות. אם משהו בה מדבר אליכם, ספרו לי — נשתמש בו
        כנקודת התחלה לתכנון הסשן שלכם.
      </p>
      <Gallery images={couplesFeaturedImages} />
      <p>
        <a class="font-semibold underline" href="/gallery/couples">לגלריית צילומי הזוגיות המלאה</a> · <a
          class="underline"
          href="/about">להכיר את יוליה</a
        >
      </p>
    </section>
    <section id="reviews" class="mx-auto max-w-3xl px-4 py-10">
      <h2 class="mb-4 text-3xl font-bold">על החוויה מול המצלמה</h2>
      <p class="mb-6 text-sm text-muted">ביקורת לקוחה על חוויית הצילום עם יוליה, לא על סשן אינטימי.</p>
      <blockquote class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <p>
          ״יוליה התותחית!! סופר סבלנית ומקלילה, הצילומים היו באווירה ממש כיפית וחוויתית והתוצרים הם ליגה ורמה אחרת!״
        </p>
        <footer class="mt-4 font-semibold">אושר</footer>
      </blockquote>
    </section>
    <FAQs
      title="שאלות על המחיר ועל ההזמנה"
      columns={1}
      items={[
        {
          title: 'האם צילומי זוגיות אינטימיים כוללים עירום?',
          description:
            'אין חובה לעירום. הסגנון, הלבוש ורמת החשיפה נבחרים לפי הרצון והנוחות של שניכם, בכל אחת מהחבילות.',
        },
        {
          title: 'איפה מתקיימים הצילומים, והאם סטודיו כלול?',
          description:
            'אפשר לתאם צילומים בטבע, בלוקיישן אורבני, בסטודיו או במרחב פרטי כמו בית או צימר. אם נדרש מקום שכור, נברר מראש את העלות; אין להניח שהשכירות כלולה במחיר החבילה.',
        },
        {
          title: 'מתי מקבלים את התמונות?',
          description:
            'עד 14 ימי עסקים מיום הצילום, בקישור לגלריה דיגיטלית פרטית באיכות גבוהה להורדה. כמות התמונות בעריכה מלאה מופיעה בכל חבילה.',
        },
        {
          title: 'צריך לשלם מקדמה?',
          description:
            'כן. מקדמה של 100 ש״ח שומרת את התאריך. המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד. דחייה למועד חלופי אפשרית בהודעה עד 24 שעות מראש ובתיאום יחד.',
        },
        {
          title: 'מה קורה אם יורד גשם או מישהו חולה?',
          description:
            'עדכנו אותי בהקדם ונבדוק יחד מועד חלופי. תנאי הדחייה הם הודעה עד 24 שעות מראש ובתיאום מועד שמתאים לשני הצדדים.',
        },
        {
          title: 'את עוזרת עם בגדים וצבעים?',
          description:
            'בוודאי. ההכוונה כלולה בכל החבילות. בוחרים לבוש שמתאים ללוקיישן ושנוח לכם בו; בפרימיום אפשר לשלב עד שתי תלבושות.',
        },
        {
          title: 'מתי כדאי לסגור תאריך?',
          description:
            'כדאי לפנות מראש אם יש לכם תאריך מסוים או אירוע שתרצו לציין. אפשר לבדוק זמינות ולשאול שאלות לפני שמחליטים על חבילה.',
        },
        {
          title: 'איך מקבלים את התמונות?',
          description:
            'תקבלו קישור לגלריה דיגיטלית פרטית, עם התמונות בעריכה מלאה ובאיכות גבוהה להורדה. כך תוכלו לשמור את האוסף שלכם ולחזור אליו מתי שתרצו.',
        },
      ]}
    />
    <Journey journey={intimateJourney} current="pricing" cta />
  </LeadTracking>
</Layout>
