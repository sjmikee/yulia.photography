---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import WhatssapCallToAction from '~/components/widgets/WhatssapCallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { PRICES } from '~/lib/pricing';


const metadata = {
  title: "מחירון צילומי זוגיות אינטימיים ולייף סטייל - יוליה קורנסקי",
  description: "חבילות צילומי זוגיות אינטימיים מותאמות אישית. תיהנו מחוויית צילום כיפית ותמונות מקצועיות שישמרו את הסיפור שלכם. בדקו את המחירון והזמינו סשן עכשיו",
  ignoreTitleTemplate: true,
};

const breadcrumbs = [
    { url: "/pricing", name: "מחירון"},
    { url: "/pricing/couples-intimate", name: "מחירון צילומי זוגיות אינטימיים"},
];

const session_type = "זוגיות-אינטימי";
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="צילום זוגי אינטימי, חושני ומלא רגש"
    title="מחירון צילומי זוגיות אינטימיים"
    subtitle="סשן צילום זוגי באווירה אינטימית ובטוחה, שמאפשרת לכם להתקרב, להרגיש ולהיות אתם - ברכות, בלי לחץ ובלי פוזות."
    content="צילומי זוגיות אינטימיים נועדו ללכוד מבטים, מגעים ורגעים קטנים של קרבה. הסשן מתקיים בקצב שלכם, בלוקיישן שנעים לכם - בטבע, במקום אורבני או במרחב פרטי לבחירתכם - ויוצר חוויה זוגית עמוקה ותמונות שמרגישות אמיתיות."
  />

    <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'מחירון', href: '/pricing' },
      { label: 'מחירון צילומי זוגיות אינטימיים'}
    ]}
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="הבחירה שלכם"
    subtitle=""
    tagline="החבילות שלי"
    prices={[
      {
        title: 'חבילת פרימיום',
        subtitle: 'חוויה חושנית עמוקה ומלאת חיבור',
        price: PRICES[session_type][3],
        period: 'סשן זוגי אינטימי ומורחב, עם מקום להעמקה, קרבה וביטוי רגשי',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'כשעתיים של צילומים',
          },
          {
            description: 'עד 2 תלבושות, הפסקות לפי הצורך',
          },
          {
            description: 'לפחות 35 - 50 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית פרטית באיכות גובהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%96%D7%95%D7%92%D7%99%D7%95%D7%AA%20%D7%90%D7%99%D7%A0%D7%98%D7%99%D7%9E%D7%99%D7%99%D7%9D.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%A4%D7%A8%D7%99%D7%9E%D7%99%D7%95%D7%9D%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A'
        },
      },
      {
        title: 'החבילה הקלאסית',
        subtitle: 'חוויה זוגית אינטימית וקרובה',
        price: PRICES[session_type][2],
        period: 'מושלם לצילומי זוגיות אינטימיים בלוקיישן לבחירתכם – טבע, אורבני או מקום פרטי',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'שעה וחצי של צילומים',
          },
          {
            description: 'לפחות 20 - 35 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית פרטית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%96%D7%95%D7%92%D7%99%D7%95%D7%AA%20%D7%90%D7%99%D7%A0%D7%98%D7%99%D7%9E%D7%99%D7%99%D7%9D.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%94%D7%97%D7%91%D7%99%D7%9C%D7%94%20%D7%94%D7%9E%D7%A9%D7%AA%D7%9C%D7%9E%D7%AA%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A'
        },
        hasRibbon: true,
        ribbonTitle: 'הכי משתלם',
      },
      {
        title: 'חבילת בסיס',
        subtitle: 'רגע אחד',
        price: PRICES[session_type][1],
        period: 'מתאים לצילומי זוגיות אינטימיים קצרים, עם דגש על קרבה, מבטים ומגע עדין',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: '45 דקות של צילומי זוגיות אינטימיים וחושניים בקצב רגוע',
          },
          {
            description: 'לפחות 15 - 20 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית פרטית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%96%D7%95%D7%92%D7%99%D7%95%D7%AA%20%D7%90%D7%99%D7%A0%D7%98%D7%99%D7%9E%D7%99%D7%99%D7%9D.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%91%D7%A1%D7%99%D7%A1%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A.'
        },
      }
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="תהליך צילומי זוגיות אינטימיים וחושניים"
    tagline="איך הכל יראה"
    isReversed={true}
    items={[
      {
        title: 'שיחה ראשונית',
        icon: 'tabler:number-1',
      },
      {
        title: 'סגירת חבילה ותאריך',
        icon: 'tabler:number-2',
      },
      {
        title: 'תשלום על שריון תאריך (100ש״ח)',
        icon: 'tabler:number-3',
      },
      {
        title: 'מצטלמים ונהנים 😊',
        icon: 'tabler:number-4',
      },
      {
        title: 'עריכת התמונות (עד 14 ימי עסקים)',
        icon: 'tabler:number-5',
      },
      {
        title: 'קבלת קישור לגלריה דיגיטלית להורדה',
        icon: 'tabler:number-6',
      },
      {
        title: 'נהנים מתמונות איכותיות ומרגשות 😊',
        icon: 'tabler:number-7',
      },
      {
        title: 'לא שוכחים לתייג אותי 😉',
        icon: 'tabler:number-8',
      },
    ]}
    image={{ src: '~/assets/images/pricing/couples_intimate_pricing.jpg', alt: 'צילומי זוגיות אינטימיים צילומי זוגיות מחירון' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="שאלות נפוצות"
    subtitle="אשמח לענות על כל שאלה אחרת שיש לכם ולא מצאתם תשובה"
    columns={1}
    items={[
      {
        title: 'האם צילומי זוגיות אינטימיים כוללים עירום?',
        description:
          'רמת האינטימיות בצילומים נבחרת תמיד לפי הרצון, הגבולות והנוחות שלכם. אין חובה לעירום כלל - הכל נעשה בהקשבה מלאה, בכבוד וברגישות, ומתוך מטרה ליצור חוויה נעימה ובטוחה שמתאימה לכם.'
      },
      {
        title: 'מתי כדאי לסגור תאריך?',
        description:
          'כדאי לסגור תאריך כמה שיותר מראש - במיוחד בעונות המבוקשות.',
      },
      {
        title: 'את עוזרת עם בגדים / צבעים?',
        description:
          "בוודאי! תקבלו ממני השראה והכוונה לתלבושות שיתאימו ללוקיישן ולוייב.",
      },
      {
        title: 'מה קורה אם יורד גשם או מישהו חולה?',
        description:
          'תמיד אפשר לתאם מועד חלופי - החיים קורים, ואני לגמרי מבינה. עדכנו אותי בהקדם, ונמצא מועד חדש שמתאים לשני הצדדים.',
      },
      {
        title: 'איפה מתקיימים הצילומים?',
        description:
          'צילומי זוגיות אינטימיים יכולים להתקיים בטבע, בלוקיישן אורבני, בסטודיו או במקום פרטי לבחירתכם - בית, צימר או כל מרחב שבו אתם מרגישים בנוח. הבחירה בלוקיישן נעשית יחד, בהתאם לאווירה ולרמת האינטימיות הרצויה.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן. כדי לשמור את התאריך ביומן, יש לשלם מקדמה של ₪100 בעת ההזמנה. (המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד), במקרה של דחיה אם תודיעו עד 24 שעות מראש - נוכל למצוא יחד מועד חלופי.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <WhatssapCallToAction />
</Layout>
