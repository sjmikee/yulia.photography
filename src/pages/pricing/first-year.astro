---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import WhatssapCallToAction from '~/components/widgets/WhatssapCallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { PRICES } from '~/lib/pricing';

const session_type = 'שנה';
const metadata = {
  title: `צילומי גיל שנה מחיר: החל מ־${PRICES[session_type][1]}₪ | יוליה קורנסקי`,
  description: `כמה עולים צילומי גיל שנה? חבילות ב־${PRICES[session_type][1]}, ${PRICES[session_type][2]} ו־${PRICES[session_type][3]} ש״ח בחולון ובמרכז. השוו זמן צילום, תמונות ערוכות ותוספות. סטודיו בתוספת תשלום.`,
  ignoreTitleTemplate: true,
};

const breadcrumbs = [
  { url: '/pricing', name: 'מחירון' },
  { url: '/pricing/first-year', name: 'מחירון צילומי גיל שנה' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="יוליה קורנסקי · חולון ומרכז הארץ"
    title="צילומי גיל שנה — מחירון וחבילות צילום"
    subtitle={`חבילות צילום החל מ־${PRICES[session_type][1]} ש״ח. צילומי יום הולדת שנה בחולון ובמרכז, עם זמן למשחק, לחיבוקים ולהפסקות.`}
    content="כל החבילות כוללות הכוונה לפני הצילום, תמונות בעריכה מלאה וגלריה דיגיטלית להורדה. צילום בסטודיו בתוספת תשלום ובתיאום מראש."
    callToAction={{ text: 'להשוואת החבילות', href: '#packages' }}
    callToAction2={{ text: 'לבדיקת תאריך פנוי', href: 'https://wa.me/972525836940', target: '_blank' }}
  />

  <Breadcrumbs
    items={[{ label: 'דף הבית', href: '/' }, { label: 'מחירון', href: '/pricing' }, { label: 'מחירון צילומי גיל שנה' }]}
  />

  <section class="mx-auto max-w-4xl px-4 py-8 text-right">
    <h2 class="mb-4 text-2xl font-bold">כמה עולים צילומי גיל שנה?</h2>
    <p class="mb-4">
      <strong>מחיר צילומי גיל שנה אצלי נע בין {PRICES[session_type][1]} ל־{PRICES[session_type][3]} ש״ח.</strong> חבילת הבסיס
      עולה {PRICES[session_type][1]} ש״ח וכוללת 45 דקות צילום; החבילה הקלאסית עולה {PRICES[session_type][2]} ש״ח וכוללת שעה
      וחצי; חבילת הפרימיום עולה {PRICES[session_type][3]} ש״ח וכוללת כשעתיים. ההבדלים בכמות התמונות ובתכולת החבילות מפורטים
      בהמשך.
    </p>
    <p class="mb-4">המחירים מתייחסים לצילומי חוץ. סטודיו אפשרי בתוספת תשלום ובתיאום מראש.</p>

    <p class="mb-4">
      לבחירת החבילה, כדאי לחשוב על הקצב של הילד או הילדה ועל התמונות שתרצו לקבל. מפגש קצר מתאים למזכרת ממוקדת מיום
      ההולדת הראשון; מפגש ארוך יותר משאיר זמן להיכרות, למשחק ולתמונות משותפות. אין צורך לחכות שהילד ילך או לדרוש ממנו
      לחייך למצלמה.
    </p>
    <p>
      אני יוליה קורנסקי, ובצילומי גיל שנה אני משלבת הכוונה להורים עם מקום לרגעים טבעיים. אפשר לתכנן מראש שילוב של הורים
      ואחים. על האווירה וההכנה תוכלו לקרוא <a href="/services/first-year-photography" class="font-semibold underline"
        >בעמוד צילומי גיל שנה ויום הולדת ראשון</a
      >.
    </p>
  </section>

  <!-- Pricing Widget ******************* -->

  <Prices
    id="packages"
    title="חבילות צילומי גיל שנה: מה כלול במחיר?"
    subtitle=""
    tagline="החבילות שלי"
    prices={[
      {
        title: 'חבילת פרימיום',
        subtitle: 'חוויה חגיגית ומרגשת',
        price: PRICES[session_type][3],
        period: 'סשן גיל שנה מורחב, עם מקום לרגעים משפחתיים וחגיגה קטנה',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'כשעתיים של צילומים',
          },
          {
            description: 'עד 2 תלבושות, הפסקות לפי הצורך',
          },
          {
            description: 'לפחות 50 - 70 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%92%D7%99%D7%9C%20%D7%A9%D7%A0%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%A4%D7%A8%D7%99%D7%9E%D7%99%D7%95%D7%9D%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
      },
      {
        title: 'החבילה הקלאסית',
        subtitle: 'חוויה מלאה לגיל שנה',
        price: PRICES[session_type][2],
        period: 'מושלם לצילומי גיל שנה עם זמן, משחק ומגוון פריימים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'שעה וחצי של צילומים',
          },
          {
            description: 'לפחות 40 - 50 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%92%D7%99%D7%9C%20%D7%A9%D7%A0%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%94%D7%97%D7%91%D7%99%D7%9C%D7%94%20%D7%94%D7%9E%D7%A9%D7%AA%D7%9C%D7%9E%D7%AA%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
        hasRibbon: true,
        ribbonTitle: 'הכי משתלם',
      },
      {
        title: 'חבילת בסיס',
        subtitle: 'סשן גיל שנה קצר ומתוק',
        price: PRICES[session_type][1],
        period: 'מתאים לצילומי גיל שנה פשוטים וקצרים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: '45 דקות של צילומי גיל שנה מותאמים לפעוטות',
          },
          {
            description: 'לפחות 30 - 40 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%92%D7%99%D7%9C%20%D7%A9%D7%A0%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%91%D7%A1%D7%99%D7%A1%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
      },
    ]}
  />

  <section class="mx-auto max-w-4xl space-y-5 px-4 py-8 text-right">
    <h2 class="text-2xl font-bold">איזו חבילה מתאימה ליום ההולדת הראשון?</h2>
    <p>
      <strong>בסיס:</strong> 45 דקות למי שמחפשים מפגש קצר ותמונות ממוקדות של גיל שנה. <strong>קלאסית:</strong> שעה וחצי להיכרות,
      משחק ומגוון תמונות. <strong>פרימיום:</strong> כשעתיים ועד שתי תלבושות, עם הפסקות לפי הצורך. סשן ארוך יותר נותן מרווח;
      הוא לא אומר שהילד צריך להצטלם ברצף.
    </p>
    <h2 class="text-2xl font-bold">מה משפיע על מחיר צילומי גיל שנה?</h2>
    <p>
      במחירון שלי ההבדלים הם במשך הצילום, בכמות התמונות בעריכה מלאה ובאפשרות להחליף תלבושות בחבילת הפרימיום. כל החבילות
      כוללות הכנה וגלריה דיגיטלית להורדה. הצילום בסטודיו כרוך בתוספת תשלום, ולכן כדאי לציין מראש אם אתם מעדיפים סטודיו
      ולקבל מחיר שמתאים לבקשה שלכם.
    </p>
    <h2 class="text-2xl font-bold">צילומי גיל שנה בטבע או בסטודיו בחולון ובמרכז</h2>
    <p>
      בחוץ יש מרחב לזחול, לחקור ולשחק, והצילום משתלב בזמן שלכם יחד. סטודיו מתאים למי שמעדיפים חלל סגור, בתיאום מראש
      ובתוספת תשלום. נבחר את המקום והשעה לפי העונה ושגרת השינה של הילד או הילדה, כדי להתחיל את המפגש בנחת.
    </p>
    <h2 class="text-2xl font-bold">צילומי גיל שנה וסמאש קייק — האם זו אותה חבילה?</h2>
    <p>
      צילומי גיל שנה יכולים להיות חגיגה של משחק וחיבוקים גם בלי עוגה. סמאש קייק הוא סגנון שמעמיד במרכז את המפגש של הילד
      עם העוגה. החבילות המפורטות כאן מתארות זמן צילום, תמונות ערוכות וגלריה דיגיטלית; עוגה ותפאורת סמאש קייק אינן
      מפורטות כחלק מהן. אם זו החוויה שאתם מחפשים, כתבו לי לפני ההזמנה כדי לברר התאמה, אפשרויות ועלות.
    </p>
    <h2 class="text-2xl font-bold">מתי לקבוע כדי לקבל תמונות לפני יום ההולדת?</h2>
    <p>
      מסירת התמונות היא עד 14 ימי עסקים אחרי הצילום. אם תרצו להשתמש בהן להזמנה או לחגיגה, קבעו את הצילומים מספיק זמן
      מראש והשאירו מרווח גם להדפסה, אם אתם מתכננים כזו. ביום הצילום כדאי להביא בגדים נוחים, בגד להחלפה וצעצוע אהוב,
      ולבחור שעה שבה הילד בדרך כלל ערני.
    </p>
    <p>
      רוצים לשלב את כל המשפחה? ספרו לי מראש מי מצטרף כדי שנתכנן את הזמן והתמונות. אפשר להתרשם גם <a
        href="/services/family-photography"
        class="font-semibold underline">מסגנון צילומי המשפחה שלי</a
      >.
    </p>
  </section>

  <!-- Steps Widget ****************** -->

  <Steps
    title="תהליך צילומי גיל שנה"
    tagline="ברוגע, בסבלנות ובהמון חיוכים"
    isReversed={true}
    items={[
      {
        title: 'שיחה ראשונית',
        icon: 'tabler:number-1',
      },
      {
        title: 'סגירת חבילה ותאריך',
        icon: 'tabler:number-2',
      },
      {
        title: 'תשלום על שריון תאריך (100ש״ח)',
        icon: 'tabler:number-3',
      },
      {
        title: 'מצטלמים ונהנים 😊',
        icon: 'tabler:number-4',
      },
      {
        title: 'עריכת התמונות (עד 14 ימי עסקים)',
        icon: 'tabler:number-5',
      },
      {
        title: 'קבלת קישור לגלריה דיגיטלית להורדה',
        icon: 'tabler:number-6',
      },
      {
        title: 'נהנים מתמונות איכותיות ומרגשות 😊',
        icon: 'tabler:number-7',
      },
      {
        title: 'לא שוכחים לתייג אותי 😉',
        icon: 'tabler:number-8',
      },
    ]}
    image={{ src: '~/assets/images/pricing/first_year_pricing.jpg', alt: 'צילומי גיל שנה של יוליה קורנסקי' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="שאלות נפוצות על צילומי גיל שנה"
    subtitle="כל מה שחשוב לדעת לפני צילומי יום הולדת ראשון"
    columns={1}
    items={[
      {
        title: 'כמה עולה חבילת צילומי גיל שנה בסיסית?',
        description: `חבילת הבסיס עולה ${PRICES[session_type][1]} ש״ח וכוללת 45 דקות צילום, הכוונה לפני הצילום, לפחות 30–40 תמונות בעריכה מלאה וגלריה דיגיטלית. צילום בסטודיו בתוספת תשלום ובתיאום מראש.`,
      },
      {
        title: 'מתי ואיך מקבלים את התמונות?',
        description:
          'התמונות נמסרות עד 14 ימי עסקים מיום הצילום, בקישור לגלריה דיגיטלית באיכות גבוהה להורדה. כמות התמונות נקבעת לפי החבילה שבחרתם.',
      },
      {
        title: 'מה קורה אם הילד לא משתף פעולה?',
        description:
          'זה לגמרי טבעי בגיל הזה. הסשן מתקיים בסבלנות מלאה ובהתאמה לקצב של הילד, עם הפסקות, משחק וזמן חופשי - כדי לאפשר רגעים טבעיים ואמיתיים.',
      },
      {
        title: 'איפה מתקיימים הצילומים?',
        description:
          'צילומי גיל שנה מתקיימים בצילומי חוץ או בסטודיו. צילום בסטודיו אפשרי בתוספת תשלום ובתיאום מראש, בהתאם לאופי הסשן ולנוחות הילד.',
      },
      {
        title: 'את עוזרת עם בגדים / צבעים?',
        description: 'בוודאי! תקבלו ממני השראה והכוונה לתלבושות שיתאימו ללוקיישן ולוייב.',
      },
      {
        title: 'מה קורה אם יורד גשם או מישהו חולה?',
        description:
          'תמיד אפשר לתאם מועד חלופי - החיים קורים, ואני לגמרי מבינה. עדכנו אותי בהקדם, ונמצא מועד חדש שמתאים לשני הצדדים.',
      },
      {
        title: 'מתי כדאי לסגור תאריך?',
        description: 'כדאי לסגור תאריך כמה שיותר מראש - במיוחד בעונות המבוקשות.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן. כדי לשמור את התאריך ביומן, יש לשלם מקדמה של ₪100 בעת ההזמנה. (המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד), במקרה של דחיה אם תודיעו עד 24 שעות מראש - נוכל למצוא יחד מועד חלופי.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <WhatssapCallToAction />
</Layout>
