---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import WhatssapCallToAction from '~/components/widgets/WhatssapCallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { PRICES } from '~/lib/pricing';


const metadata = {
  title: "מחירון צילומי גיל שנה - יוליה קורנסקי",
  description: "מחירון צילומי גיל שנה (First Birthday). חבילות צילום לגיל שנה באווירה שמחה וטבעית, עם סבלנות לילדים ותמונות מרגשות לשנים קדימה."
};

const breadcrumbs = [
    { url: "/pricing", name: "מחירון"},
    { url: "/pricing/first-year", name: "מחירון צילומי גיל שנה"},
];

const session_type = "שנה";
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="חוגגים שנה ראשונה, כמו שהיא באמת"
    title="מחירון צילומי גיל שנה"
    subtitle="צילומי גיל שנה באווירה שמחה, רגועה ומותאמת לפעוטות - בלי לחץ ועם הרבה סבלנות."
    content="צילומי גיל שנה נועדו להנציח שלב מתוק ומרגש במיוחד. הסשן מותאם לקצב של הילד או הילדה, וכולל רגעים טבעיים, משחק, חיוכים וחיבוקים - ליצירת זיכרונות אמיתיים מהשנה הראשונה."
  />

    <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'מחירון', href: '/pricing' },
      { label: 'מחירון צילומי גיל שנה'}
    ]}
  />

    <section class="mx-auto max-w-4xl px-4 py-8 text-right">
    <h2 class="mb-6 text-3xl font-bold">
      כמה עולים צילומי גיל שנה ומה משפיע על המחיר?
    </h2>

    <p class="mb-4">
      מחיר צילומי גיל שנה מושפע בעיקר מאורך הסשן, כמות התמונות שתקבלו, זמן העריכה וההשקעה בכל פרט לאורך החוויה. בגיל הזה הילדים סקרנים, זזים ללא הפסקה ומשנים מצב רוח במהירות, ולכן חשוב ליצור עבורם סביבה רגועה, נעימה ומלאת סבלנות שמאפשרת לתפוס רגעים טבעיים ואמיתיים.
    </p>

    <p class="mb-4">
      כל אחת מהחבילות כוללת הכוונה לפני יום הצילום, ליווי בבחירת לבוש וצבעים, התאמה לקצב של הפעוט ועריכה מוקפדת של כל תמונה שנמסרת לכם. במידת הצורך אפשר לעצור להפסקות קצרות, לתת לילד זמן להתרגל לסביבה ולהמשיך רק כשהוא מרגיש בנוח.
    </p>

    <p class="mb-4">
      אם אתם מתלבטים איזו חבילה לבחור, כדאי לחשוב האם תרצו מגוון רחב יותר של תמונות, החלפת בגדים או זמן נוסף שיאפשר לילד להשתחרר ולהצטלם בקצב שלו. סשן ארוך יותר מעניק בדרך כלל יותר אפשרויות ומאפשר ליצור גלריה עשירה ומגוונת שתלווה אתכם לשנים רבות.
    </p>
  </section>


  <!-- Pricing Widget ******************* -->

  <Prices
    title="הבחירה שלכם"
    subtitle=""
    tagline="החבילות שלי"
    prices={[
      {
        title: 'חבילת פרימיום',
        subtitle: 'חוויה חגיגית ומרגשת',
        price: PRICES[session_type][3],
        period: 'סשן גיל שנה מורחב, עם מקום לרגעים משפחתיים וחגיגה קטנה',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'כשעתיים של צילומים',
          },
          {
            description: 'עד 2 תלבושות, הפסקות לפי הצורך',
          },
          {
            description: 'לפחות 50 - 70 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גובהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%92%D7%99%D7%9C%20%D7%A9%D7%A0%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%A4%D7%A8%D7%99%D7%9E%D7%99%D7%95%D7%9D%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
      },
      {
        title: 'החבילה הקלאסית',
        subtitle: 'חוויה מלאה לגיל שנה',
        price: PRICES[session_type][2],
        period: 'מושלם לצילומי גיל שנה עם זמן, משחק ומגוון פריימים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'שעה וחצי של צילומים',
          },
          {
            description: 'לפחות 40 - 50 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%92%D7%99%D7%9C%20%D7%A9%D7%A0%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%94%D7%97%D7%91%D7%99%D7%9C%D7%94%20%D7%94%D7%9E%D7%A9%D7%AA%D7%9C%D7%9E%D7%AA%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
        hasRibbon: true,
        ribbonTitle: 'הכי משתלם',
      },
      {
        title: 'חבילת בסיס',
        subtitle: 'סשן גיל שנה קצר ומתוק',
        price: PRICES[session_type][1],
        period: 'מתאים לצילומי גיל שנה פשוטים וקצרים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: '45 דקות של צילומי גיל שנה מותאמים לפעוטות',
          },
          {
            description: 'לפחות 30 - 40 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%92%D7%99%D7%9C%20%D7%A9%D7%A0%D7%94.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%91%D7%A1%D7%99%D7%A1%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="תהליך צילומי גיל שנה"
    tagline="ברוגע, בסבלנות ובהמון חיוכים"
    isReversed={true}
    items={[
      {
        title: 'שיחה ראשונית',
        icon: 'tabler:number-1',
      },
      {
        title: 'סגירת חבילה ותאריך',
        icon: 'tabler:number-2',
      },
      {
        title: 'תשלום על שריון תאריך (100ש״ח)',
        icon: 'tabler:number-3',
      },
      {
        title: 'מצטלמים ונהנים 😊',
        icon: 'tabler:number-4',
      },
      {
        title: 'עריכת התמונות (עד 14 ימי עסקים)',
        icon: 'tabler:number-5',
      },
      {
        title: 'קבלת קישור לגלריה דיגיטלית להורדה',
        icon: 'tabler:number-6',
      },
      {
        title: 'נהנים מתמונות איכותיות ומרגשות 😊',
        icon: 'tabler:number-7',
      },
      {
        title: 'לא שוכחים לתייג אותי 😉',
        icon: 'tabler:number-8',
      },
    ]}
    image={{ src: '~/assets/images/pricing/first_year_pricing.jpg', alt: 'צילומי גיל שנה צילומי גיל שנה מחירון' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="שאלות נפוצות על צילומי גיל שנה"
    subtitle="כל מה שחשוב לדעת לפני צילומי יום הולדת ראשון"
    columns={1}
    items={[
      {
        title: 'מה קורה אם הילד לא משתף פעולה?',
        description: 'זה לגמרי טבעי בגיל הזה. הסשן מתקיים בסבלנות מלאה ובהתאמה לקצב של הילד, עם הפסקות, משחק וזמן חופשי - כדי לאפשר רגעים טבעיים ואמיתיים.',
      },
      {
        title: 'איפה מתקיימים הצילומים?',
        description:
          'צילומי גיל שנה מתקיימים בצילומי חוץ או בסטודיו. צילום בסטודיו אפשרי בתוספת תשלום ובתיאום מראש, בהתאם לאופי הסשן ולנוחות הילד.',
      },
      {
        title: 'את עוזרת עם בגדים / צבעים?',
        description:
          "בוודאי! תקבלו ממני השראה והכוונה לתלבושות שיתאימו ללוקיישן ולוייב.",
      },
      {
        title: 'מה קורה אם יורד גשם או מישהו חולה?',
        description:
          'תמיד אפשר לתאם מועד חלופי - החיים קורים, ואני לגמרי מבינה. עדכנו אותי בהקדם, ונמצא מועד חדש שמתאים לשני הצדדים.',
      },
      {
        title: 'מתי כדאי לסגור תאריך?',
        description:
          'כדאי לסגור תאריך כמה שיותר מראש - במיוחד בעונות המבוקשות.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן. כדי לשמור את התאריך ביומן, יש לשלם מקדמה של ₪100 בעת ההזמנה. (המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד), במקרה של דחיה אם תודיעו עד 24 שעות מראש - נוכל למצוא יחד מועד חלופי.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <WhatssapCallToAction />
</Layout>
