---
import { Image } from 'astro:assets';
import { feminineFeaturedImages } from '~/lib/feminine-gallery';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import { feminineJourney, femininePackages, feminineWhatsApp, feminineService } from '~/lib/feminine';
import HeroText from '~/components/widgets/HeroText.astro';
import PackageComparison from '~/components/photoshoots/PackageComparison.astro';
import PricingCards from '~/components/ui/PricingCards.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { femininePricingCards } from '~/lib/feminine';
import preview from '~/assets/feminine_gallery/feminine_pricing.jpg';
const metadata = {
  title: `צילומי נשיות מחיר: החל מ־${femininePackages[0].price}₪ | יוליה קורנסקי`,
  description: `מחירון צילומי נשיות ובודואר בחולון ובמרכז: ${femininePackages.map((p) => p.price).join(', ')} ש״ח. השוואת תמונות בעריכה מלאה, משך צילום ומה כלול. סטודיו בתוספת תשלום.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/feminine_gallery/feminine_pricing.jpg',
        width: preview.width,
        height: preview.height,
        alt: 'צילום נשיות של יוליה קורנסקי',
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/pricing', name: 'מחירון' },
  { url: '/pricing/feminine', name: 'מחירון צילומי נשיות' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={feminineService} />
  <HeroText
    tagline="יוליה קורנסקי · חולון ומרכז הארץ"
    title="צילומי נשיות ובודואר — מחירון וחבילות"
    subtitle={`רגע שהוא כולו שלך, החל מ־${femininePackages[0].price} ש״ח. את מביאה את עצמך, אני דואגת להכוונה ולאור.`}
    content="כל החבילות כוללות הכוונה לפני הצילום, תמונות בעריכה מלאה וגלריה דיגיטלית להורדה. המחירים לצילומי חוץ; סטודיו בתוספת תשלום ובתיאום מראש."
    callToAction={{ text: 'להשוואת החבילות', href: '#packages' }}
    callToAction2={{ text: 'לבדיקת תאריך פנוי', href: feminineWhatsApp(), target: '_blank' }}
  />
  <Breadcrumbs
    items={[{ label: 'דף הבית', href: '/' }, { label: 'מחירון', href: '/pricing' }, { label: 'מחירון צילומי נשיות' }]}
  />
  <section class="mx-auto max-w-4xl space-y-5 px-4 py-8 text-right">
    <h2 class="text-2xl font-bold">כמה עולים צילומי נשיות?</h2>
    <p>
      <strong>מחיר צילומי נשיות אצלי נע בין {femininePackages[0].price} ל־{femininePackages[2].price} ש״ח.</strong> בחרי לפי
      אוסף התמונות שתרצי לקבל: {femininePackages[0].photos} תמונות בעריכה מלאה בבסיס, {femininePackages[1].photos} בקלאסית
      ו־{femininePackages[2].photos} בפרימיום. זמני הצילום בהמשך הם הערכה לתכנון היום.
    </p>
    <p>
      אפשר לבחור פורטרטים בלבוש מלא או לתכנן סשן בודואר אינטימי. הסגנון ורמת החשיפה נקבעים איתך מראש. צילום בסטודיו כרוך
      בתוספת שנברר לפני קביעת הסשן.
    </p>
    <p>
      רוצה קודם להרגיש את הסגנון? הציצי <a class="font-semibold underline" href="/gallery/feminine"
        >בגלריית צילומי הנשיות</a
      > או קראי <a class="font-semibold underline" href="/services/feminine-photography">איך נראה סשן איתי</a>.
    </p>
  </section>
  <Journey journey={feminineJourney} current="pricing" />
  <section id="packages" class="scroll-mt-28 mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-4 text-center text-3xl font-bold">החבילות שלך, במבט אחד</h2>
    <p class="mb-8 text-center">בכל חבילה: הכוונה, עריכה מלאה וגלריה דיגיטלית. המחירים לצילומי חוץ.</p>
    <PackageComparison
      packages={[...femininePackages].reverse()}
      label="השוואת חבילות צילומי נשיות"
      caption="כמות תמונות בעריכה מלאה, מחיר ומשך צילום משוער"
    />
    <div class="mt-8"><PricingCards prices={femininePricingCards} /></div>
  </section>
  <section class="mx-auto max-w-4xl space-y-5 px-4 py-10">
    <h2 class="text-2xl font-bold">איזו חבילה מתאימה לך?</h2>
    <p>
      <strong>בסיס</strong> מתאימה לאוסף ממוקד של דיוקנאות ורגעים אישיים. <strong>קלאסית</strong> נותנת לך אוסף רחב יותר של
      הבעות ותנועה. <strong>פרימיום</strong> כוללת את כמות התמונות הגדולה ביותר ועד שתי תלבושות. אם הלב רוצה גם רך וגם קצת
      דרמטי, נדבר על הדרך לשלב ביניהם.
    </p>
    <h2 class="text-2xl font-bold">מה כלול במחיר, ומה מתאמים בנפרד?</h2>
    <p>
      הכוונה לפני הצילום וטיפים ללבוש, ליווי במהלך הסשן, כמות התמונות המצוינת בחבילה בעריכה מוקפדת ומלאה וגלריה דיגיטלית
      באיכות גבוהה להורדה. התמונות נמסרות עד 14 ימי עסקים מיום הצילום.
    </p>
    <p>
      סטודיו אינו כלול במחירים המוצגים. אם תרצי לצלם בו, נתאם מראש מקום ועלות נוספת. איפור, שיער או אביזרים מיוחדים אינם
      מופיעים כחלק מהחבילות; אם משהו מהם חשוב לך, העלי אותו בשיחה כדי שנברר מה אפשרי ומה העלות.
    </p>
    <h2 class="text-2xl font-bold">איך להשוות מחירי צילומי בודואר?</h2>
    <p>
      כדאי לבדוק כמה תמונות מקבלים בעריכה מלאה, האם המחיר כולל סטודיו ומה סגנון התמונות בגלריה. מספר גדול של קבצים אינו
      בהכרח מספר התמונות הערוכות. כאן הכמות בכל חבילה מתייחסת לתמונות בעריכה מלאה, כדי שתוכלי לבחור כשכל הפרטים מולך.
    </p>
    <h2 class="text-2xl font-bold">מהשיחה הראשונה ועד התמונות</h2>
    <p>
      מדברות על הסגנון והגבולות שלך, בוחרות חבילה ולוקיישן וקובעות תאריך עם מקדמה של 100 ש״ח. ביום הצילום אני מכוונת
      אותך צעד־צעד, ואחריו עוברת לעריכת התמונות. לך נשאר לפנות להן מקום בלב. וגם בטלפון.
    </p>
  </section>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h2 class="mb-4 text-3xl font-bold">רגעים מהגלריה</h2>
    <div class="grid gap-5 sm:grid-cols-3">
      {
        feminineFeaturedImages.map(({ image, alt }) => (
          <figure>
            <Image
              src={image}
              alt={alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 310px, (min-width: 640px) 30vw, 92vw"
              loading="lazy"
              class="aspect-[4/5] w-full rounded-2xl object-cover"
            />
          </figure>
        ))
      }
    </div>
    <p class="mt-6">
      <a class="font-semibold underline" href="/gallery/feminine">לגלריית צילומי הנשיות המלאה</a> · <a
        class="underline"
        href="/about">להכיר את יוליה, הצלמת שמאחורי התמונות</a
      >
    </p>
  </section>
  <FAQs
    title="שאלות על המחיר ועל ההזמנה"
    columns={1}
    items={[
      {
        title: 'האם מחיר צילומי בודואר כולל סטודיו?',
        description:
          'לא. המחירים בעמוד הם לצילומי חוץ. סטודיו אפשרי בתוספת תשלום ובתיאום מראש; נסכם את העלות לפני קביעת הסשן.',
      },
      {
        title: 'מתי מקבלים את התמונות?',
        description:
          'עד 14 ימי עסקים מיום הצילום, בקישור לגלריה דיגיטלית באיכות גבוהה להורדה. כמות התמונות בעריכה מלאה תלויה בחבילה שבחרת.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן, מקדמה של 100 ש״ח שומרת את התאריך ביומן. המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד. דחייה למועד חלופי אפשרית בהודעה עד 24 שעות מראש ובתיאום יחד.',
      },
      {
        title: 'ומה אם אני לא יודעת להצטלם?',
        description:
          'בשביל זה אני כאן. ההכוונה כלולה בכל חבילה, מהבחירה בלבוש ועד מה לעשות עם הידיים. אין צורך בניסיון או בפוזות מוכנות.',
      },
      {
        title: 'האם חייבים להצטלם בלבוש חשוף?',
        description: 'ממש לא. אפשר להצטלם בלבוש מלא. נדבר מראש על הסגנון והגבולות שלך ונבחר יחד מה נעים לך.',
      },
      {
        title: 'איך בוחרים בין חוץ לסטודיו?',
        description:
          'בחוץ יש אור טבעי ונוף; בסטודיו אפשר לתכנן את הרקע והתאורה. אם פרטיות במקום הצילום חשובה לך, צייני זאת בשיחה כדי שנבחר מרחב מתאים.',
      },
    ]}
  />
  <Journey journey={feminineJourney} current="pricing" cta />
</Layout>
