---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import WhatssapCallToAction from '~/components/widgets/WhatssapCallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { PRICES } from '~/lib/pricing';


const metadata = {
  title: "מחירון צילומי נשיות מעצימים | צילומי בודואר מקצועיים - יוליה קורנסקי",
  description: "מחירון צילומי נשיות מעצימים ואומנותיים, כולל צילומי בודואר מקצועיים באווירה בטוחה, רגועה ומחזקת. חבילות צילום נשי ליצירת פורטרטים מלאי רגש וביטוי אישי.",
  ignoreTitleTemplate: true,
};

const breadcrumbs = [
    { url: "/pricing", name: "מחירון"},
    { url: "/pricing/feminine", name: "מחירון צילומי נשיות"},
];

const session_type = "נשיות";
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="רוך, עוצמה וביטוי אישי"
    title="מחירון צילומי נשיות וצילומי בודואר מעצימים"
    subtitle="סשן צילום נשי אומנותי או צילומי בודואר שמאפשרים לך להתחבר לעצמך, להרגיש בטוחה ולהיראות בדיוק כמו שאת."
    content="צילומי נשיות וצילומי בודואר הם חוויה אישית ומעצימה, המשלבת רגש, נוכחות ואסתטיקה אומנותית. הסשן מתקיים באווירה רגועה ומכילה, בקצב שלך, עם הכוונה עדינה שמדגישה יופי טבעי, עוצמה ורוך."
  />

    <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'מחירון', href: '/pricing' },
      { label: 'מחירון צילומי נשיות ובודואר'}
    ]}
  />
  <!-- Pricing Widget ******************* -->

  <Prices
    title="הבחירה שלכן"
    subtitle=""
    tagline="החבילות שלי"
    prices={[
      {
        title: 'חבילת פרימיום',
        subtitle: 'חוויה אומנותית מלאה',
        price: PRICES[session_type][3],
        period: 'חוויה נשית עמוקה ומלאת ביטוי אישי',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'כשעתיים של צילומים',
          },
          {
            description: 'עד 2 תלבושות, הפסקות לפי הצורך',
          },
          {
            description: 'לפחות 35 - 45 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גובהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%A0%D7%A9%D7%99%D7%95%D7%AA.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%A4%D7%A8%D7%99%D7%9E%D7%99%D7%95%D7%9D%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
      },
      {
        title: 'החבילה הקלאסית',
        subtitle: 'חוויה מעצימה',
        price: PRICES[session_type][2],
        period: 'מושלם לצילומי נשיות מעצימים ואומנותיים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: 'שעה וחצי של צילומים',
          },
          {
            description: 'לפחות 25 - 35 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%A0%D7%A9%D7%99%D7%95%D7%AA.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%94%D7%97%D7%91%D7%99%D7%9C%D7%94%20%D7%94%D7%9E%D7%A9%D7%AA%D7%9C%D7%9E%D7%AA%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
        hasRibbon: true,
        ribbonTitle: 'הכי משתלם',
      },
      {
        title: 'חבילת בסיס',
        subtitle: 'רגע אישי',
        price: PRICES[session_type][1],
        period: 'מתאים לצילומי נשיות אישיים וקצרים',
        items: [
          {
            description: 'הכוונה מלאה לפני הצילום + טיפים',
          },
          {
            description: '45 דקות של צילומים',
          },
          {
            description: 'לפחות 20 - 25 תמונות בעריכה מוקפדת ומלאה',
          },
          {
            description: 'גלריה דיגיטלית באיכות גבוהה להורדה',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'לקביעת תאריך',
          href: 'https://wa.me/972525836940?text=%D7%94%D7%99%D7%99%2C%20%D7%90%D7%A0%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%A6%D7%99%D7%9C%D7%95%D7%9E%D7%99%20%D7%A0%D7%A9%D7%99%D7%95%D7%AA.%20%D7%9E%D7%AA%D7%90%D7%99%D7%9E%D7%94%20%D7%9C%D7%99%20%D7%97%D7%91%D7%99%D7%9C%D7%AA%20%D7%94%D7%91%D7%A1%D7%99%D7%A1%20%D7%95%D7%94%D7%99%D7%99%D7%AA%D7%99%20%D7%A8%D7%95%D7%A6%D7%94%20%D7%9C%D7%A1%D7%92%D7%95%D7%A8%20%D7%AA%D7%90%D7%A8%D7%99%D7%9A',
        },
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="תהליך צילומי נשיות"
    tagline="ברגישות, בהקשבה ובקצב שלך"
    isReversed={true}
    items={[
      {
        title: 'שיחה ראשונית',
        icon: 'tabler:number-1',
      },
      {
        title: 'סגירת חבילה ותאריך',
        icon: 'tabler:number-2',
      },
      {
        title: 'תשלום על שריון תאריך (100ש״ח)',
        icon: 'tabler:number-3',
      },
      {
        title: 'מצטלמים ונהנים 😊',
        icon: 'tabler:number-4',
      },
      {
        title: 'עריכת התמונות (עד 14 ימי עסקים)',
        icon: 'tabler:number-5',
      },
      {
        title: 'קבלת קישור לגלריה דיגיטלית להורדה',
        icon: 'tabler:number-6',
      },
      {
        title: 'נהנים מתמונות איכותיות ומרגשות 😊',
        icon: 'tabler:number-7',
      },
      {
        title: 'לא שוכחים לתייג אותי 😉',
        icon: 'tabler:number-8',
      },
    ]}
    image={{ src: '~/assets/images/pricing/feminine_pricing.jpg', alt: 'צילומי נשיות וצילומי בודואר מעצימים ואומנותיים' }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="שאלות נפוצות על צילומי נשיות"
    subtitle="כל מה שחשוב לדעת לפני סשן צילום נשיות או צילומי בודואר"
    columns={1}
    items={[
      {
        title: 'האם צריך ניסיון קודם מול מצלמה?',
        description: 'ממש לא. רוב המצולמות מגיעות ללא ניסיון קודם. אני מלווה ומכוונת בעדינות לאורך כל הסשן, כך שתרגישי בטוחה, נינוחה ותתחברי לעצמך.'
      },
      {
        title: 'האם יש עירום בצילומי נשיות?',
        description: 'הכל נבחר ומוגדר מראש בהתאם לרצון ולגבולות שלך. צילומי נשיות וצילומי בודואר יכולים להיות בעירום, חשופים בעדינות או ללא עירום כלל - תמיד מתוך כבוד, הקשבה וביטחון מלא.'
      },
      {
        title: 'איפה מתקיימים הצילומים?',
        description:
          'צילומי נשיות מתקיימים בצילומי חוץ או בסטודיו. צילום בסטודיו אפשרי בתוספת תשלום ובתיאום מראש, בהתאם לאווירה ולסגנון שתרצי ליצור.',
      },
      {
        title: 'מה ההבדל בין צילומי נשיות לצילומי בודואר?',
        description: 'צילומי בודואר הם סגנון צילום אינטימי ואומנותי המדגיש ביטוי אישי, רוך ועוצמה נשית. בפועל, רבים משלבים בין צילומי נשיות לצילומי בודואר באותו הסשן, בהתאם לאווירה ולגבולות שנקבעים מראש.'
      },
      {
        title: 'את עוזרת עם בגדים / צבעים?',
        description:
          "בוודאי! תקבלו ממני השראה והכוונה לתלבושות שיתאימו ללוקיישן ולוייב.",
      },
      {
        title: 'מה קורה אם יורד גשם או מישהו חולה?',
        description:
          'תמיד אפשר לתאם מועד חלופי - החיים קורים, ואני לגמרי מבינה. עדכנו אותי בהקדם, ונמצא מועד חדש שמתאים לשני הצדדים.',
      },
      {
        title: 'מתי כדאי לסגור תאריך?',
        description:
          'כדאי לסגור תאריך כמה שיותר מראש - במיוחד בעונות המבוקשות.',
      },
      {
        title: 'צריך לשלם מקדמה?',
        description:
          'כן. כדי לשמור את התאריך ביומן, יש לשלם מקדמה של ₪100 בעת ההזמנה. (המקדמה תוחזר במקרה של ביטול עד 3 ימים לפני המועד), במקרה של דחיה אם תודיעו עד 24 שעות מראש - נוכל למצוא יחד מועד חלופי.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <WhatssapCallToAction />
</Layout>
