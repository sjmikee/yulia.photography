---
export const prerender = false;

import Layout from '~/layouts/ClientLayout.astro';

const url = new URL(Astro.url);
const success = url.searchParams.get('success') === '1';
const error = url.searchParams.get('error');
const phone = url.searchParams.get('phone');
---

<Layout title="הוספת לקוח חדש" subtitle="הפרטים הראשונים לקראת הצילומים הבאים">
  {
    success && (
      <section
        role="status"
        class="max-w-xs mx-auto py-4 px-6 mb-6 bg-green-600 text-white rounded-lg text-center font-semibold space-y-3"
      >
        <div>הלקוח נוסף בהצלחה!</div>
        {phone && (
          <a
            href={`/clients/add_session?phone=${phone}`}
            class="inline-block bg-white text-green-700 font-bold px-4 py-2 rounded-lg hover:bg-gray-100 transition"
          >
            המשך להוספת סשן
          </a>
        )}
      </section>
    )
  }

  {
    error && (
      <section
        role="alert"
        tabindex="-1"
        data-server-error
        class="max-w-xs mx-auto py-4 px-6 mb-6 bg-red-600 text-white rounded-lg text-center font-semibold"
      >
        {error}
      </section>
    )
  }
  <section class="legacy-form-section">
    <form
      method="POST"
      action="/api/add_client"
      accept-charset="UTF-8"
      class="space-y-6 bg-white p-8 rounded-2xl shadow-lg"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label
          >שם מלא<input
            type="text"
            autocomplete="name"
            name="name"
            placeholder="למשל, דנה כהן…"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          /></label
        >
        <label
          >טלפון<input
            type="tel"
            autocomplete="tel"
            name="phone"
            placeholder="050-1234567…"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          /></label
        >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label
          >מייל (לא חובה)<input
            spellcheck="false"
            type="email"
            autocomplete="email"
            name="email"
            placeholder="name@example.com…"
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          /></label
        >
      </div>

      <button
        type="submit"
        id="submit"
        class="btn-primary w-full py-3 px-6 rounded-xl bg-primary text-white font-bold hover:bg-primary-dark transition"
      >
        שמירת לקוח
      </button>
    </form>
  </section>

  <script>
    function initAddClient() {
      const form = document.querySelector<HTMLFormElement>('form[action="/api/add_client"]');
      const submitButton = document.querySelector<HTMLButtonElement>('#submit');

      if (!form || !submitButton || form.dataset.ready) return;
      form.dataset.ready = 'true';
      form.addEventListener('submit', () => {
        submitButton.disabled = true;
        submitButton.dataset.busy = 'true';
        submitButton.textContent = 'מוסיפה…';
      });
    }
    initAddClient();
    document.addEventListener('astro:page-load', initAddClient);
  </script>
</Layout>
