---
export const prerender = false;
import Layout from '~/layouts/ClientLayout.astro';
import ManagementRow from '~/components/clients/ManagementRow.astro';
import { sql } from '~/lib/db';
import { dashboardQuery } from '~/lib/management-queries';
import { managementData, israelToday, type ManagedSession, type Payment } from '~/lib/client-workflow';
const today = israelToday();
const groups = [
  ['all', 'הכול'],
  ['overdue', 'מסירה באיחור'],
  ['today', 'מסירה היום'],
  ['contracts', 'חוזים'],
  ['payments', 'תשלומים וקבלות'],
  ['editing', 'עריכה'],
  ['delivery', 'מסירה'],
  ['reviews', 'בקשות ביקורת'],
  ['calendar', 'יומן'],
];
const requested = Astro.url.searchParams.get('filter') || 'all';
const filter = groups.some(([key]) => key === requested) ? requested : 'all';
const requestedPage = Number(Astro.url.searchParams.get('page')) || 1;
const safePage = Number.isFinite(requestedPage) ? Math.max(1, Math.min(100000, Math.floor(requestedPage))) : 1;
let page = 1;
let failed = false;
let totals = { shoots_today: 0, overdue_count: 0, due_today: 0, attention_count: 0, filtered_count: 0 };
let upcoming = managementData([], [], today).upcoming;
let filtered = managementData([], [], today).attention;
try {
  const [result] = await sql.query(dashboardQuery, [today, filter, safePage]);
  totals = result as typeof totals;
  page = Number(result.page);
  const bookings = result.bookings as { section: string; session: ManagedSession; payments: Payment[] }[];
  const rowsFor = (section: string) => {
    const selected = bookings.filter((booking) => booking.section === section);
    return managementData(
      selected.map((booking) => booking.session),
      selected.flatMap((booking) => booking.payments),
      today
    );
  };
  upcoming = rowsFor('upcoming').upcoming;
  filtered = rowsFor('attention').attention;
} catch {
  failed = true;
}
---

<Layout title="מה על הפרק?" subtitle="הצילומים הקרובים, מסירת התמונות והשלב הבא לכל לקוח">
  {
    failed ? (
      <p role="alert" class="panel">
        לא ניתן לטעון את הנתונים כרגע. נסי לרענן.
      </p>
    ) : (
      <>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          {[
            ['צילומים היום', totals.shoots_today, '#upcoming'],
            ['מסירות באיחור', totals.overdue_count, '?filter=overdue#attention'],
            ['מסירות להיום', totals.due_today, '?filter=today#attention'],
            ['סשנים בטיפול', totals.attention_count, '#attention'],
          ].map(([label, count, href]) => (
            <a href={String(href)} class="rounded-xl bg-gray-50 p-4">
              <span class="block text-3xl font-bold">{count}</span>
              <span>{label}</span>
            </a>
          ))}
        </div>
        <section id="upcoming" class="panel">
          <h2 class="text-2xl font-bold">הצילומים הקרובים</h2>
          <p class="text-sm text-gray-600 mt-2">עד 10 הצילומים הקרובים, לפי המועד שנשמר במערכת.</p>
          {upcoming.length ? (
            <ul>
              {upcoming.map((row) => (
                <ManagementRow row={row} today={today} />
              ))}
            </ul>
          ) : (
            <p class="mt-4">אין צילומים קרובים עם מועד שמור.</p>
          )}
        </section>
        <section id="attention" class="panel">
          <div class="attention-heading">
            <h2 class="text-2xl font-bold">דורש טיפול</h2>
            <form id="attention-filter" method="GET" action="/clients/dashboard#attention" class="attention-filter">
              <label for="attention-category">הצגת סשנים</label>
              <select id="attention-category" name="filter">
                {groups.map(([key, label]) => (
                  <option value={key} selected={filter === key}>
                    {label}
                  </option>
                ))}
              </select>
              <button type="submit" class="filter-submit">
                הצגה
              </button>
            </form>
          </div>
          <p class="text-sm text-gray-600 mt-4">
            {totals.filtered_count} סשנים · מסירות באיחור מופיעות ראשונות. מועד המסירה: 14 ימים לאחר יום הצילומים.
          </p>
          {filtered.length ? (
            <ul>
              {filtered.map((row) => (
                <ManagementRow row={row} today={today} />
              ))}
            </ul>
          ) : (
            <p class="mt-4">אין סשנים לטיפול בקטגוריה הזו.</p>
          )}
          <nav class="flex gap-5 mt-4" aria-label="עמודי סשנים">
            {page > 1 && (
              <a class="underline" href={`?filter=${filter}&page=${page - 1}#attention`}>
                הקודם
              </a>
            )}
            {page * 20 < totals.filtered_count && (
              <a class="underline" href={`?filter=${filter}&page=${page + 1}#attention`}>
                הבא
              </a>
            )}
          </nav>
        </section>
      </>
    )
  }
</Layout>

<style>
  .attention-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .attention-filter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .attention-filter label {
    color: #6b7280;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .attention-filter select {
    width: auto;
    min-width: 11rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    cursor: pointer;
  }
  .filter-submit {
    min-height: 2.75rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 540px) {
    .attention-filter {
      width: 100%;
      flex-wrap: wrap;
    }
    .attention-filter select {
      flex: 1;
      min-width: 0;
    }
  }
</style>

<script>
  function setupAttentionFilter() {
    const form = document.querySelector<HTMLFormElement>('#attention-filter');
    const select = form?.querySelector<HTMLSelectElement>('select');
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (!form || !select || !submit || form.dataset.enhanced) return;
    form.dataset.enhanced = 'true';
    submit.hidden = true;
    select.addEventListener('change', () => form.requestSubmit());
  }
  setupAttentionFilter();
  document.addEventListener('astro:page-load', setupAttentionFilter);
</script>
