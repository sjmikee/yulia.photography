---
export const prerender = false;
import Layout from '~/layouts/ClientLayout.astro';
import { sql } from '~/lib/db';
import { overviewQuery } from '~/lib/management-queries';
import { businessSummary, israelToday } from '~/lib/client-workflow';
const requested = Astro.url.searchParams.get('month') || '';
const month = /^\d{4}-(0[1-9]|1[0-2])$/.test(requested) ? requested : israelToday().slice(0, 7);
let summary = businessSummary([], [], month);
let failed = false;
const money = (value: number) => new Intl.NumberFormat('he-IL', { style: 'currency', currency: 'ILS' }).format(value);
try {
  const [result] = await sql.query(overviewQuery, [month]);
  summary = {
    received: Number(result.received),
    outstanding: Number(result.outstanding),
    cancelledBalance: Number(result.cancelled_balance),
    completed: Number(result.completed),
    missingDates: Number(result.missing_dates),
    packages: (result.packages as [string, number][]).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])),
  };
} catch {
  failed = true;
}
---

<Layout title="תמונת מצב עסקית" subtitle="תשלומים, יתרות וצילומים — לפי הנתונים שנרשמו במערכת">
  <form class="panel grid grid-cols-1 sm:grid-cols-[minmax(0,1fr)_auto] items-end gap-4" method="GET">
    <label class="min-w-0">
      בחירת חודש<input class="min-w-0 max-w-full" type="month" name="month" value={month} required />
    </label>
    <button class="btn-secondary">הצגת החודש</button>
  </form>
  {
    failed ? (
      <p class="panel" role="alert">
        לא ניתן לטעון את הנתונים כרגע. נסי לרענן.
      </p>
    ) : (
      <>
        <div class="overview-metrics grid sm:grid-cols-2 gap-4">
          <section class="panel">
            <>
              <h2>תשלומים שהתקבלו בחודש הנבחר</h2>
              <p class="text-3xl font-bold my-3">{money(summary.received)}</p>
              <p class="text-sm text-gray-600">לפי תאריך קבלת התשלום, כולל תשלומים מסשנים שבוטלו.</p>
            </>
          </section>
          <section class="panel">
            <>
              <h2>צילומים שהסתיימו בחודש הנבחר</h2>
              <p class="text-3xl font-bold my-3">{summary.completed}</p>
              <p class="text-sm text-gray-600">לפי יום הצילומים וסימון סיום הצילומים; ללא סשנים מבוטלים.</p>
            </>
          </section>
          <section class="panel">
            <>
              <h2>יתרות פתוחות כרגע</h2>
              <p class="text-3xl font-bold my-3">{money(summary.outstanding)}</p>
              <p class="text-sm text-gray-600">כל הסשנים שלא בוטלו, בכל החודשים.</p>
            </>
          </section>
          <section class="panel">
            <>
              <h2>יתרות בסשנים מבוטלים — לבדיקה</h2>
              <p class="text-3xl font-bold my-3">{money(summary.cancelledBalance)}</p>
              <p class="text-sm text-gray-600">הביטול אינו מוחק יתרות או מבצע החזר כספי.</p>
            </>
          </section>
        </div>
        <section class="panel">
          <h2 class="text-2xl font-bold mb-4">חבילות בצילומים שהסתיימו החודש</h2>
          {summary.packages.length ? (
            <ul class="divide-y divide-gray-200">
              {summary.packages.map(([name, count]) => (
                <li class="package-row">
                  <div>
                    <span>{name}</span>
                    <strong>{count}</strong>
                  </div>
                  <div class="package-track" aria-hidden="true">
                    <span style={`width: ${(count / Math.max(...summary.packages.map(([, n]) => n), 1)) * 100}%`} />
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p>אין צילומים שהסתיימו עם מועד שמור בחודש הזה.</p>
          )}
        </section>
        <p class="text-sm text-gray-600">
          תשלומים היסטוריים שלא נרשמו במערכת אינם נכללים בסכום שהתקבל. הסכומים אינם רווח ואינם כוללים חישוב הוצאות או
          החזרים.
        </p>
        {summary.missingDates > 0 && (
          <p class="text-sm text-amber-800 mt-3">
            {summary.missingDates} סשנים סומנו כצולמו ללא מועד שמור, ולכן אינם נכללים בנתוני החודש.
          </p>
        )}
      </>
    )
  }
</Layout>

<style>
  .overview-metrics .panel {
    margin-bottom: 0;
  }
  .overview-metrics {
    margin-bottom: 1.5rem;
  }
  .overview-metrics .panel:first-child {
    border-inline-start: 4px solid #233237;
  }
  .overview-metrics h2 {
    font-weight: 600;
  }
  .overview-metrics p {
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .package-row {
    padding: 1rem 0;
  }
  .package-row > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }
  .package-track {
    height: 6px;
    border-radius: 3px;
    background: #f5f5f5;
    overflow: hidden;
  }
  .package-track span {
    display: block;
    height: 100%;
    background: #233237;
    border-radius: inherit;
  }
</style>
