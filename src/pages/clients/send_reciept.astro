---
export const prerender = false;

import { sql } from '~/lib/db';
import Layout from '~/layouts/Layout.astro';
import RichSeo from '~/components/common/RichSeo.astro';
import LandingHeader from '~/components/widgets/LandingHeader.astro';
import ScrollToTopButton from '~/components/widgets/ScrollToTopButton.astro';
import WhatsAppButton from '~/components/widgets/WhatsAppButton.astro';

const richMetadata = {
  title: 'יוליה קורנסקי - הפקת קבלה ללקוח',
  description: 'הפקת קבלה ושליחתה בוואטסאפ',
};

const paymentId = Astro.url.searchParams.get('payment_id');
if (!paymentId || !/^[0-9a-f-]{36}$/i.test(paymentId)) return Astro.redirect('/clients');
const [record] = await sql`SELECT p.*, p.paid_on::text AS paid_on, s.client_id, s.session_type, c.name, c.phone, c.email
  FROM session_payments p JOIN sessions s ON s.id = p.session_id
  JOIN clients c ON c.id = s.client_id WHERE p.id = ${paymentId}::uuid`;
if (!record) return Astro.redirect('/clients');
const metadata = {
  title: 'יוליה קורנסקי | הפקת קבלה ללקוח',
  description: 'הפקת קבלה ושליחתה בוואטסאפ',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <meta name="robots" content="noindex" />
  <div class="flex flex-col min-h-screen">
    <main class="flex-grow">
      <RichSeo metadata={richMetadata} />
      <LandingHeader isSticky />
      <ScrollToTopButton />

      <section class="bg-gray-50 py-16 px-6 text-center">
        <h1 class="text-3xl font-bold mb-4">הפקת קבלה ללקוח</h1>
        <p class="text-lg text-gray-700 max-w-2xl mx-auto">מפיקים קבלה בלחיצה ושולחים מיד בוואטסאפ 📄</p>
      </section>

      <section class="max-w-2xl mx-auto py-12 px-6">
        <a href={`/clients/${record.client_id}#session-${record.session_id}`} class="block mb-4 underline"
          >חזרה לפרופיל הלקוח</a
        >
        <form
          data-payment-id={record.id}
          data-name={record.name}
          data-email={record.email || ''}
          data-phone={record.phone}
          data-amount={record.amount}
          data-date={String(record.paid_on).slice(0, 10)}
          data-description={`${record.stage === 'deposit' ? 'סגירת תאריך' : 'יתרת תשלום'} — ${record.session_type}`}
          data-status={record.receipt_status}
          id="receiptForm"
          class="space-y-6 bg-white p-8 rounded-2xl shadow-lg"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input
              type="tel"
              id="phone"
              placeholder="טלפון לקוח"
              required
              class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
            />

            <input
              type="text"
              id="clientName"
              placeholder="שם הלקוח"
              readonly
              class="border p-3 w-full rounded-lg bg-gray-100 text-gray-600"
            />

            <input
              type="text"
              id="clientEmail"
              placeholder="מייל הלקוח"
              readonly
              class="border p-3 w-full rounded-lg bg-gray-100 text-gray-600"
            />
          </div>

          <input
            type="number"
            id="amount"
            placeholder="סכום ששולם (₪)"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          />

          <input
            type="date"
            id="paymentDate"
            placeholder="תאריך התשלום"
            required
            class="border p-3 w-full h-12 rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          />

          <select
            id="payment"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          >
            <option value="" disabled selected>בחרי אמצעי תשלום</option>
            <option value="1">מזומן</option>
            <option value="4">העברה בנקאית</option>
            <option value="10" data-app="1">Bit</option>
            <option value="10" data-app="3">PayBox</option>
          </select>

          <input
            type="text"
            id="description"
            placeholder="תיאור (לדוגמה: תשלום על סשן משפחה)"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          />
          <input
            type="text"
            id="remarks"
            placeholder="הערות (לדוגמא: תאריך הצילומים)"
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          />

          <button
            type="submit"
            id="submit"
            class="btn-primary w-full py-3 px-6 rounded-xl bg-primary text-white font-bold hover:bg-primary-dark transition"
          >
            הפקת קבלה ושליחה ללקוח
          </button>
        </form>
        <section
          id="receiptNext"
          hidden={record.receipt_status !== 'issued'}
          class="mt-6 bg-white p-8 rounded-2xl shadow-lg text-center space-y-4"
          aria-live="polite"
        >
          <p>הקבלה הופקה. שלחי אותה בוואטסאפ והמשיכי לשלב הבא.</p>
          <a class="btn-primary w-full" href={`/clients/${record.client_id}#session-${record.session_id}`}
            >{record.stage === 'deposit' ? 'המשך להוספה ליומן' : 'המשך לעריכת התמונות'}</a
          >
        </section>
      </section>
    </main>

    <footer class="bg-footer text-white py-8 text-center">
      <button
        aria-label="Footer Scroll to top"
        id="scrollToTopFooter"
        class="hidden p-3 bg-gray-800/30 w-13 text-white rounded-lg shadow-md border border-white/80 backdrop-blur-sm focus-visible:outline-hidden focus-visible:ring-3 focus-visible:ring-primary dark:focus-visible:ring-gray-200 transition ease-in duration-200"
      >
        <span class="sr-only">Footer Scroll to top</span> ↑
      </button>
      <p class="mb-4 font-bold">יוליה קורנסקי | yulia.photography</p>
      <p>הפקת קבלה ❤️</p>
    </footer>
  </div>

  <WhatsAppButton />
</Layout>

<script>
  const initializedForms = new WeakSet<HTMLFormElement>();
  function initReceiptForm() {
    const phoneInput = document.querySelector<HTMLInputElement>('#phone');
    const nameField = document.querySelector<HTMLInputElement>('#clientName');
    const emailField = document.querySelector<HTMLInputElement>('#clientEmail');

    const amount = document.querySelector<HTMLInputElement>('#amount');
    const payment = document.querySelector<HTMLSelectElement>('#payment');
    const paymentDate = document.querySelector<HTMLInputElement>('#paymentDate');
    const description = document.querySelector<HTMLInputElement>('#description');
    const remarks = document.querySelector<HTMLInputElement>('#remarks');

    const form = document.querySelector<HTMLFormElement>('#receiptForm');
    const submitButton = document.querySelector<HTMLButtonElement>('#submit');

    if (
      !phoneInput ||
      !nameField ||
      !emailField ||
      !amount ||
      !payment ||
      !paymentDate ||
      !description ||
      !remarks ||
      !form ||
      !submitButton
    )
      return;
    if (initializedForms.has(form)) return;
    initializedForms.add(form);

    phoneInput.value = form.dataset.phone || '';
    phoneInput.readOnly = true;
    nameField.value = form.dataset.name || '';
    emailField.value = form.dataset.email || '';
    amount.value = form.dataset.amount || '';
    amount.readOnly = true;
    paymentDate.value = form.dataset.date || '';
    paymentDate.readOnly = true;
    description.value = form.dataset.description || '';
    if (form.dataset.status === 'processing') {
      submitButton.disabled = true;
      submitButton.textContent = 'נדרשת בדיקת הקבלה במערכת Morning';
    }
    if (form.dataset.status === 'issued') submitButton.textContent = 'פתיחת הקבלה הקיימת בוואטסאפ';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const digits = phoneInput.value.replace(/\D/g, '');
      if (digits.length < 10) return alert('מספר טלפון לא תקין');

      submitButton.disabled = true;
      submitButton.textContent = 'שולח...';

      const popup = window.open('about:blank', '_blank');
      if (popup) popup.opener = null;
      let completed = false;
      try {
        const selectedOption = payment.options[payment.selectedIndex];
        const appType = selectedOption.dataset.app || null;

        const res = await fetch('/api/create_receipt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            payment_id: form.dataset.paymentId,
            phone: digits,
            name: nameField.value,
            email: emailField.value,
            amount: Number(amount.value),
            payment: Number(payment.value),
            appType: appType,
            paymentDate: new Date(paymentDate.value).toISOString().split('T')[0],
            description: description.value,
            remarks: remarks.value,
          }),
        });

        const data = await res.json();

        if (!res.ok) {
          popup?.close();
          alert('לא ניתן לאשר את הפקת הקבלה. בדקי בפרופיל ובמערכת Morning לפני ניסיון נוסף.');
          console.error(data);
          return;
        }

        const waPhone = digits.startsWith('0') ? '972' + digits.slice(1) : digits;

        const msg = encodeURIComponent(`היי!\n` + `הקבלה שלך מוכנה\n\n` + `לינק להורדה:\n` + `${data.url}`);
        completed = true;
        const nextStage = document.getElementById('receiptNext');
        if (nextStage) {
          nextStage.hidden = false;
          nextStage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        const target = `https://wa.me/${waPhone}?text=${msg}`;
        if (popup) popup.location.href = target;
        else window.location.href = target;
      } catch (error) {
        popup?.close();
        console.error(error);
        alert('לא ניתן לאשר אם הקבלה הופקה. בדקי במערכת הקבלות לפני ניסיון נוסף.');
      } finally {
        submitButton.disabled = !completed;
        submitButton.textContent = completed ? 'פתיחת הקבלה הקיימת בוואטסאפ' : 'חזרי לפרופיל ובדקי את מצב הקבלה';
      }
    });
  }

  document.addEventListener('astro:page-load', initReceiptForm);
  initReceiptForm();
</script>
