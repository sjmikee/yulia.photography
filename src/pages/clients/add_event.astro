---
export const prerender = false;

import Layout from '~/layouts/ClientLayout.astro';
---

<Layout title="הוספת לקוח ליומן" subtitle="קובעים צילומים בקליק אחד 🎯">
  <!-- Add Event Form -->
  <section class="legacy-form-section">
    <form id="calendarForm" class="space-y-6 bg-white p-8 rounded-2xl shadow-lg">
      <label id="booking-label" class="block" hidden>
        סשן
        <select id="booking" class="border p-3 w-full rounded-lg">
          <option value="">בחרי סשן</option>
        </select>
      </label>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label
          >טלפון לקוח<input
            type="tel"
            id="phone"
            placeholder="טלפון לקוח"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          /></label
        >
        <label
          >שם<input
            type="text"
            id="clientName"
            placeholder="שם"
            readonly
            class="border p-3 w-full rounded-lg bg-gray-100 text-gray-600"
          /></label
        >
        <label
          >מייל<input
            type="text"
            id="clientEmail"
            placeholder="מייל"
            readonly
            class="border p-3 w-full rounded-lg bg-gray-100 text-gray-600"
          /></label
        >

        <label
          >בחר תאריך<input
            type="date"
            id="date"
            placeholder="בחר תאריך"
            required
            class="border p-3 w-full h-12 rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          /></label
        >

        <label
          >בחר שעה<input
            type="time"
            id="time"
            placeholder="בחר שעה"
            required
            class="border p-3 w-full h-12 rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          /></label
        >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <label
          >סוג הצילומים<select
            id="sessionType"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          >
            <option value="" disabled selected>בחרי סוג צילומים</option>
            <option value="צילומים אישיים">צילומים אישיים</option>
            <option value="צילומי תדמית">צילומי תדמית</option>
            <option value="צילומי נשיות">צילומי נשיות</option>
            <option value="צילומי זוגיות">צילומי זוגיות</option>
            <option value="צילומי משפחה">צילומי משפחה</option>
            <option value="צילומי הריון">צילומי הריון</option>
            <option value="צילומי גיל שנה">צילומי גיל שנה</option>
            <option value="צילומי ילדים">צילומי ילדים</option>
            <option value="בוק בת מצווה">בוק בת מצווה</option>
            <option value="בוק בר מצווה">בוק בר מצווה</option>
            <option value="צילומי אירוע">צילומי אירוע</option>
          </select></label
        >

        <label
          >משך הצילומים<select
            id="duration"
            required
            class="border p-3 w-full rounded-lg focus:ring-2 focus:ring-primary focus:outline-none"
          >
            <option value="" disabled selected>בחרי משך</option>
            <option value="1">1 שעות</option>
            <option value="2">2 שעות</option>
            <option value="3">3 שעות</option>
            <option value="6">6 שעות</option>
            <option value="9">9 שעות</option>
          </select></label
        >
      </div>

      <button
        type="submit"
        class="btn-primary w-full py-3 px-6 rounded-xl bg-primary text-white font-bold hover:bg-primary-dark transition"
      >
        הוספה
      </button>
    </form>
  </section>
</Layout>
<!-- Scripts -->

<script>
  import { sessionDurationHours } from '~/lib/session-duration';
  import type { Session } from '~/lib/client-workflow';
  import { openClientApp } from '~/lib/client-app-links';
  const initializedForms = new WeakSet<HTMLFormElement>();
  function initAddEvent() {
    const phoneInput = document.querySelector<HTMLInputElement>('#phone');
    const nameField = document.querySelector<HTMLInputElement>('#clientName');
    const form = document.querySelector<HTMLFormElement>('#calendarForm');

    const emailField = document.querySelector<HTMLInputElement>('#clientEmail');
    const dateField = document.querySelector<HTMLInputElement>('#date');
    const timeField = document.querySelector<HTMLInputElement>('#time');
    const sessionField = document.querySelector<HTMLSelectElement>('#sessionType');
    const durationField = document.querySelector<HTMLSelectElement>('#duration');

    if (
      !phoneInput ||
      !nameField ||
      !form ||
      !emailField ||
      !dateField ||
      !timeField ||
      !sessionField ||
      !durationField
    )
      return;
    if (initializedForms.has(form)) return;
    initializedForms.add(form);

    const bookingField = document.querySelector<HTMLSelectElement>('#booking')!;
    const bookingLabel = document.querySelector<HTMLElement>('#booking-label')!;
    let sessions: Session[] = [];
    function applyBooking() {
      const session = sessions.find((item) => String(item.id) === bookingField.value);
      durationField!.value = session ? String(sessionDurationHours(session) ?? '') : '';
    }
    bookingField.addEventListener('change', applyBooking);
    let lastFetchedPhone = '';
    let lookupTimeout: ReturnType<typeof setTimeout>;
    let clientEmail = '';

    // Auto-format and lookup
    phoneInput?.addEventListener('input', () => {
      const digits = phoneInput.value.replace(/\D/g, '');
      let formatted = digits;
      if (digits.length > 3) formatted = digits.slice(0, 3) + '-' + digits.slice(3);
      phoneInput.value = formatted;

      sessions = [];
      bookingField.replaceChildren(new Option('בחרי סשן', ''));
      bookingLabel.hidden = true;
      durationField.value = '';
      lastFetchedPhone = '';
      clearTimeout(lookupTimeout);
      if (digits.length >= 10) lookupTimeout = setTimeout(() => lookupClient(digits), 400);
      else {
        nameField.value = '';
        emailField.value = '';
        clientEmail = '';
      }
    });

    const lookupClient = async (phoneDigits: string) => {
      if (phoneDigits === lastFetchedPhone) return;
      lastFetchedPhone = phoneDigits;

      nameField.value = 'מחפש...';
      try {
        const res = await fetch('/api/get_client_by_phone', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone: phoneDigits, include_sessions: true }),
        });
        const data = await res.json();
        if (phoneInput.value.replace(/\D/g, '') !== phoneDigits) return;
        if (!res.ok) {
          nameField.value = 'לא נמצא לקוח';
          nameField.classList.add('text-gray-400');
          emailField.value = '';
          clientEmail = '';
        } else {
          nameField.value = data.name;
          emailField.value = data.email || '';
          nameField.classList.remove('text-gray-400');
          clientEmail = data.email || '';
          sessions = data.sessions || [];
          bookingField.replaceChildren(new Option('בחרי סשן', ''));
          for (const session of sessions) {
            bookingField.add(
              new Option(`#${session.id} · ${session.session_type} · חבילה ${session.package_type}`, String(session.id))
            );
          }
          bookingLabel.hidden = sessions.length === 0;
          if (sessions.length === 1) bookingField.value = String(sessions[0].id);
          applyBooking();
        }
      } catch {
        nameField.value = 'שגיאה בחיפוש';
        nameField.classList.add('text-gray-400');
        emailField.value = '';
        clientEmail = '';
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const phone = phoneInput.value.replace(/\D/g, '');
      const name = nameField.value.trim();
      const email = clientEmail;
      const MKemail = 'sjmikee@gmail.com';
      const date = dateField.value;
      const time = timeField.value;
      const sessionType = sessionField.value;
      const duration = parseInt(durationField.value);

      if (!phone || !name || !date || !time || !sessionType || !duration) {
        alert('נא למלא את כל השדות');
        return;
      }

      if (['לא נמצא לקוח', 'שגיאה בחיפוש', 'מחפש...'].includes(name)) {
        alert('לא נמצא לקוח עבור מספר זה');
        return;
      }

      const startDate = new Date(`${date}T${time}:00`);
      const endDate = new Date(startDate.getTime() + duration * 60 * 60 * 1000);
      const formatDate = (d: Date) => d.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';

      const startStr = formatDate(startDate);
      const endStr = formatDate(endDate);

      const base = 'https://calendar.google.com/calendar/render?action=TEMPLATE';
      const text = encodeURIComponent(`${sessionType} - ${name}`);
      const details = encodeURIComponent(
        `לקוח: ${name}\nטלפון: ${phone}\nסוג צילומים: ${sessionType}\nמשך: ${duration} שעות`
      );
      const dates = `${startStr}/${endStr}`;
      const url = `${base}&text=${text}&details=${details}&dates=${dates}&add=${encodeURIComponent(email)},${encodeURIComponent(MKemail)}`;

      openClientApp(url, form);
    });
  }

  document.addEventListener('astro:page-load', initAddEvent);
  initAddEvent();
</script>
