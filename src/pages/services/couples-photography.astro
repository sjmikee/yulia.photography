---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ImageSection from '~/components/photoshoots/ImageSection.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import SessionFacts from '~/components/photoshoots/SessionFacts.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { couplesJourney, couplesPackages, couplesWhatsApp, couplesService, couplesFacts } from '~/lib/couples';
import { couplesHeroImage as hero, couplesFeaturedImages } from '~/lib/couples-gallery';
const metadata = {
  title: 'צילום זוגיות טבעי ולא מבוים | צילומי זוגות במרכז | יוליה קורנסקי',
  description: `צילום זוגיות טבעי בחולון ובמרכז, בים, בטבע או בסטודיו בתיאום. הכוונה גם למי שלא רגילים למצלמה. לאירוסין, יום נישואין או פשוט יחד. חבילות החל מ־${couplesPackages[0].price} ש״ח.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/couples_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/services', name: 'סוגי צילומים' },
  { url: '/services/couples-photography', name: 'צילומי זוגיות' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={couplesService} />
  <LeadTracking service="couples">
    <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-8 md:grid-cols-2 md:gap-12 md:py-12">
      <div>
        <p class="mb-3 font-semibold text-accent">יוליה קורנסקי · חולון ומרכז הארץ</p>
        <h1 class="mb-5 text-4xl font-bold leading-tight md:text-5xl">
          צילום זוגיות טבעי<br /><span class="text-accent">זמן לשניכם. מזכרת מהביחד.</span>
        </h1>
        <p class="mb-5 text-xl leading-relaxed">
          הליכה ליד הים, צחוק באמצע שיחה, חיבוק מוכר. לא צריך לחכות לחתונה כדי לעצור לרגע וליצור תמונות של שניכם, כמו
          שאתם היום.
        </p>
        <p class="mb-6">
          גם אם אתם לא רגילים למצלמה, לא תצטרכו לנחש מה לעשות. אני אכוון אתכם בתנועה ובמחוות פשוטות, בקצב שנעים לשניכם. <strong
            >חבילות החל מ־{couplesPackages[0].price} ש״ח.</strong
          >
        </p>
        <div class="flex flex-wrap gap-3">
          <Button
            class="w-full"
            variant="primary"
            href={couplesWhatsApp()}
            target="_blank"
            icon="tabler:brand-whatsapp"
            data-lead-source="couples-service-hero">בואו נתכנן את הסשן שלכם</Button
          >
          <Button class="w-full" href="/pricing/couples">למחירון ולחבילות</Button>
        </div>
        <p class="mt-5 text-sm">אפשר להתחיל בשאלה, בלי להתחייב לתאריך.</p>
      </div>
      <Image
        src={hero.image}
        alt={hero.alt}
        widths={[400, 640, 900, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-2xl object-cover"
      />
    </section>
    <Breadcrumbs
      items={[
        { label: 'דף הבית', href: '/' },
        { label: 'סוגי צילומים', href: '/services' },
        { label: 'צילומי זוגיות' },
      ]}
    />
    <Journey journey={couplesJourney} current="service" />
    <SessionFacts title="צילומי זוגיות — הפרטים בקצרה" facts={couplesFacts} />
    <section class="mx-auto max-w-5xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">רגעים מהסשנים הזוגיים</h2>
      <p>
        לפני שמחליטים, קחו רגע לראות אם אתם מתחברים לסגנון. אפשר לשלוח לי תמונה שאהבתם מהגלריה ולספר מה משך אתכם בה.
      </p>
      <Gallery images={couplesFeaturedImages} />
      <Button href="/gallery/couples">לגלריית צילומי הזוגיות המלאה</Button>
    </section>
    <ImageSection image={couplesFeaturedImages[1].image} alt={couplesFeaturedImages[1].alt}>
      <h2 class="text-3xl font-bold">״אבל אנחנו לא יודעים להצטלם״</h2>
      <p>
        אתם לא צריכים להגיע עם פוזות מוכנות. נתחיל בהליכה קצרה, בשיחה או בישיבה יחד. אני אעזור עם העמידה, הידיים והמבט,
        ואתם תוכלו להתרכז זה בזו.
      </p>
      <p>
        צילום טבעי לא אומר שאין הכוונה. הוא אומר שההכוונה נותנת מקום לאופי שלכם, בלי לבקש חיוך קבוע או מחווה שלא מתאימה
        לכם. אם אחד מכם מהסס, אפשר לדבר איתי לפני שמחליטים.
      </p>
      <p><a class="underline" href="/about">להכיר אותי לפני שנפגשים — יוליה, הצלמת שלכם</a></p>
    </ImageSection>
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="mb-8 text-3xl font-bold">למי מתאים סשן צילום זוגי?</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">פשוט כי אתם יחד</h3><p>
            לא צריך סיבה חגיגית. זוגיות חדשה או שנים של היכרות — אפשר לשמור מזכרת מהתקופה הזאת ולפנות זמן משותף מחוץ
            לשגרה.
          </p>
        </div>
        <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">אירוסין ו־Save the Date</h3><p>
            אם התמונות מיועדות להזמנה או להודעה על החתונה, ספרו לי מראש על הסגנון ועל מועד הפרסום. נתכנן את הצילום
            בהתחשב בזמן העריכה: עד 14 ימי עסקים.
          </p>
        </div>
        <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">יום נישואין או מתנה זוגית</h3><p>
            חוויה משותפת שאפשר לחזור אליה דרך התמונות. אפשר להפתיע ברעיון, ואז לבחור יחד תאריך, מקום ואווירה ששניכם
            אוהבים.
          </p>
        </div>
      </div>
    </section>
    <ImageSection image={couplesFeaturedImages[2].image} alt={couplesFeaturedImages[2].alt} imageFirst={false}>
      <h2 class="text-3xl font-bold">צילומי זוגיות במרכז — בים, בטבע או בסטודיו?</h2>
      <p>
        אני מצלמת בחולון ובמרכז הארץ. הים מתאים למרחב פתוח ולתנועה, טבע נותן רקע ירוק ועונתי, ובעיר אפשר לשלב רחובות
        וקירות עם אופי. בוחרים יחד לפי מה שאתם אוהבים, העונה והאור.
      </p>
      <p>
        אם אתם מעדיפים סטודיו, נתאם מקום וסגנון מראש. כשנדרשת שכירת סטודיו או לוקיישן, נברר את העלות לפני שסוגרים. אין
        צורך להגיע עם מקום מוכן — אעזור לכם לבחור.
      </p>
      <h3 class="text-xl font-bold">מה לובשים לצילומי זוגיות?</h3>
      <p>
        בגדים שאתם אוהבים על עצמכם ושנוח לכם לנוע בהם. כדאי לבחור צבעים שמשתלבים, בלי להרגיש שחייבים להתלבש אותו הדבר.
        אפשר לשלוח לי אפשרויות לפני הצילום; בחבילת פרימיום ניתן לשלב עד שתי תלבושות.
      </p>
    </ImageSection>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-12">
      <h2 class="text-3xl font-bold">איך נראה הסשן, מהשיחה ועד התמונות?</h2>
      <ol class="list-decimal space-y-4 ps-6">
        <li>
          <strong>מכירים ומתכננים.</strong> נדבר על הסיבה לצילום, המקום והסגנון, נבחר חבילה ותאריך ונתאם לבוש. מקדמה של 100
          ש״ח שומרת את התאריך.
        </li>
        <li>
          <strong>נפגשים ומצטלמים.</strong> מתחילים בפעולות פשוטות יחד, עם הכוונה לאורך הדרך. זמן הצילום נע בין 45 דקות לכשעתיים,
          לפי החבילה.
        </li>
        <li>
          <strong>מקבלים את האוסף שלכם.</strong> עד 14 ימי עסקים מיום הצילום תקבלו קישור לגלריה דיגיטלית, עם התמונות בעריכה
          מלאה ובאיכות גבוהה להורדה.
        </li>
      </ol>
    </section>
    <section id="reviews" class="mx-auto max-w-3xl px-4 py-10">
      <h2 class="mb-4 text-3xl font-bold">על החוויה עם יוליה</h2>
      <p class="mb-6 text-sm text-muted">מתוך ביקורת לקוחה על חוויית הצילום.</p>
      <blockquote class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <p>
          ״יוליה התותחית!! סופר סבלנית ומקלילה, הצילומים היו באווירה ממש כיפית וחוויתית והתוצרים הם ליגה ורמה אחרת!״
        </p><footer class="mt-4 font-semibold">אושר</footer>
      </blockquote>
    </section>
    <section class="mx-auto max-w-4xl space-y-4 px-4 py-12 text-center">
      <h2 class="text-3xl font-bold">כמה עולים צילומי זוגיות?</h2>
      <p>
        שלוש חבילות ב־{couplesPackages.map((p) => p.price).join(', ')} ש״ח. בכל חבילה כלולים הכנה, הכוונה בצילום, עריכה מלאה
        וגלריה דיגיטלית. ההבדל הוא בזמן הצילום ובכמות התמונות.
      </p>
      <Button href="/pricing/couples">להשוואת החבילות ולתנאי ההזמנה</Button>
    </section>
    <FAQs
      title="שאלות נפוצות על צילום זוגיות"
      columns={2}
      items={[
        {
          title: 'מה אם אחד מאיתנו לא אוהב להצטלם?',
          description:
            'אפשר להתחיל בשיחה ולספר לי מה מרגיש מביך או לא נוח. בזמן הצילום אתן הכוונה פשוטה ואפשר לשנות כיוון. לא צריך ניסיון, וכדאי לקבוע כששניכם רוצים בחוויה.',
        },
        {
          title: 'אפשר להצטלם לאירוסין או ל־Save the Date?',
          description:
            'כן. ספרו לי מתי אתם צריכים את התמונות ולמה הן מיועדות, כדי שנתכנן את הסשן מראש. מסירת התמונות היא עד 14 ימי עסקים; עיצוב הזמנה אינו מופיע כחלק מהחבילות.',
        },
        {
          title: 'אפשר לתכנן צילום של הצעת נישואין?',
          description:
            'כתבו לי מראש על המקום, התאריך והרגע שתרצו לתעד. נבדוק יחד זמינות ואפשרות לתכנון מתאים לפני שקובעים; אל תסתמכו על הזמנה של סשן רגיל בלי תיאום ההפתעה.',
        },
        {
          title: 'מה קורה אם יורד גשם?',
          description:
            'עדכנו אותי בהקדם ונתאם פתרון. דחייה למועד חלופי אפשרית בהודעה עד 24 שעות מראש ובתיאום מועד שמתאים לשני הצדדים.',
        },
        {
          title: 'מה ההבדל בין צילומי זוגיות לצילומים אינטימיים?',
          description:
            'סשן הזוגיות מתמקד בזמן משותף, בתנועה ובתמונות רומנטיות. סשן אינטימי נותן מקום לביטוי חושני יותר, עם תיאום אישי של הלבוש, הקרבה והפרטיות. אין צורך לבחור בסגנון אינטימי כדי לקבל תמונות מלאות רגש.',
        },
        {
          title: 'אפשר לראות עוד תמונות לפני שמחליטים?',
          description:
            'כן. גלריית הזוגיות המשותפת מקושרת כאן ומאפשרת להכיר את הסגנון. תוכלו לספר לי אילו תמונות אהבתם כדי שנחשוב יחד על הכיוון שלכם.',
        },
      ]}
    />
    <p class="mx-auto max-w-4xl px-4 text-center">
      מחפשים אווירה חושנית יותר? <a class="underline" href="/services/intimate-couples-photography"
        >כל הפרטים על צילומי זוגיות אינטימיים</a
      >.
    </p>
    <Journey journey={couplesJourney} current="service" cta />
  </LeadTracking>
</Layout>
