---
import Layout from '~/layouts/PageLayout.astro';
import ServiceCard from '~/components/widgets/ServiceCard.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';


const metadata = {
  title: "סוגי צילומים: הריון, משפחה, זוגיות, נשיות ובוק אישי | יוליה קורנסקי",
  description:
    "צילומי הריון, משפחה, זוגיות, נשיות, בוק אישי וגיל שנה. כל סשן מותאם אישית, באווירה טבעית, רגועה ומלאת אופי.",
  ignoreTitleTemplate: true,
};

const breadcrumbs = [
    { url: "/services", name: "סוגי צילומים"},
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>

  <!-- Hero -->
  <section class="max-w-4xl mx-auto px-4 pt-16 pb-10 text-center">
    <h1 class="text-3xl md:text-4xl font-semibold mb-4">
      סוגי הצילומים
    </h1>
    <p class="text-gray-600 leading-relaxed">
      כל סשן צילום מותאם אישית, בקצב נעים ועם הקשבה מלאה.
      כאן תוכלו לראות את סוגי הצילומים שאני מציעה ולעבור לעמוד שאתם מחפשים.
    </p>
  </section>

  <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'סוגי צילומים' }
    ]}
  />

  <!-- Services list -->
  <section class="max-w-6xl mx-auto px-4 pb-20 py-10">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <ServiceCard
            href="/services/pregnancy-photography"
            image={{
                src: '~/assets/images/services/pregnancy-hero.jpg',
                alt: 'צילומי הריון זוגיים בשקיעה '
            }}
        >

        <Fragment slot="title">
          צילומי הריון
        </Fragment>

        <Fragment slot="subtitle">
          צילומי הריון בטבע ובים בחולון ובמרכז. לבד או בזוג, עם הכוונה נעימה ובלי צורך בניסיון מול מצלמה. בואי להכיר את הסשן ולמצוא את הסגנון שלך.
        </Fragment>
      </ServiceCard>

      <ServiceCard
            href="/services/personal-photography"
            image={{
                src: '~/assets/images/services/personal-hero.jpg',
                alt: 'צילומי בוק אישי וצילומים אישיים בטבע',
                position: "center 15%"
            }}
        >

        <Fragment slot="title">
          צילומי בוק אישי
        </Fragment>

        <Fragment slot="subtitle">
          צילומי בוק אישי וצילומים אישיים באווירה טבעית, רגועה ומכבדת - פורטרטים אישיים בטבע, בים או בלוקיישן שקט, עם ליווי והכוונה עדינה ליצירת תמונות אותנטיות ומחמיאות, לגברים ונשים
        </Fragment>
      </ServiceCard>

      <ServiceCard
            href="/services/family-photography"
            image={{
                src: '~/assets/images/family/family-hero.jpg',
                alt: 'צילומי משפחה בטבע ובים',
                position: "center 15%"
            }}
        >

        <Fragment slot="title">
          צילומי משפחה
        </Fragment>

        <Fragment slot="subtitle">
          צילומי משפחה טבעיים, רגועים ומלאי חיבור - בטבע, בים או בלוקיישן שמתאים בדיוק לכם ולילדים.
        </Fragment>
      </ServiceCard>

      <ServiceCard
            href="/services/couples-photography"
            image={{
                src: '~/assets/images/services/couples-hero.jpg',
                alt: 'צילומי זוגיות במרכז צילומי זוגיות בטבע',
                position: "center 15%"
            }}
        >

        <Fragment slot="title">
          צילומי זוגיות
        </Fragment>

        <Fragment slot="subtitle">
          צילום זוגיות טבעי, מרגש ולא מבוים לזוגות. סשן זוגי רגוע בסטודיו או בלוקיישן חוץ במרכז הארץ - מתאים לזוגיות, אירוסין ורגעים של יחד.
        </Fragment>
      </ServiceCard>

      <ServiceCard
        href="/services/feminine-photography"
        image={{
          src: '~/assets/feminine_gallery/feminine_pricing.jpg',
          alt: 'צילומי נשיות וצילומי בודואר באווירה אומנותית',
        }}
      >
        <Fragment slot="title">צילומי נשיות ובודואר</Fragment>
        <Fragment slot="subtitle">
          צילומי נשיות ובודואר בחולון ובמרכז, בלבוש ובקצב שלך. הכירי את ההכנה והחוויה, צפי בגלריה והשווי חבילות צילום.
        </Fragment>
      </ServiceCard>

      <ServiceCard
        href="/services/intimate-couples-photography"
        image={{
          src: '~/assets/images/pricing/couples_intimate_pricing_2.jpg',
          alt: 'צילומי זוגיות אינטימיים וחושניים',
        }}
      >
        <Fragment slot="title">צילומי זוגיות אינטימיים</Fragment>
        <Fragment slot="subtitle">
          סשן זוגי קרוב, עדין ומלא רגש — עם דיסקרטיות, הקשבה מלאה וללא פוזות מאולצות.
        </Fragment>
      </ServiceCard>

      <ServiceCard
        href="/services/first-year-photography"
        image={{
          src: '~/assets/images/pricing/first_year_pricing.jpg',
          alt: 'צילומי גיל שנה טבעיים ומשפחתיים',
        }}
      >
        <Fragment slot="title">צילומי גיל שנה</Fragment>
        <Fragment slot="subtitle">
          חוגגים את השנה הראשונה בקצב של הקטנטנים — עם משחק, סבלנות ורגעים משפחתיים אמיתיים.
        </Fragment>
      </ServiceCard>
    </div>
  </section>
</Layout>
