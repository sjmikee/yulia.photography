---
import Layout from '~/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ImageSection from '~/components/photoshoots/ImageSection.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { feminineJourney, femininePackages, feminineWhatsApp, feminineService } from '~/lib/feminine';
import { feminineGalleryImages } from '~/lib/feminine-gallery';
const hero = feminineGalleryImages[4];
const metadata = {
  title: 'צילומי נשיות ובודואר בחולון ובמרכז | יוליה קורנסקי',
  description: `צילומי נשיות ובודואר עם יוליה קורנסקי: הכוונה אישית, לבוש וגבולות לבחירתך, בחוץ או בסטודיו בתיאום. חבילות החל מ־${femininePackages[0].price} ש״ח. הכירי את החוויה והגלריה.`,
  ignoreTitleTemplate: true,
};
const breadcrumbs = [
  { url: '/services', name: 'סוגי צילומים' },
  { url: '/services/feminine-photography', name: 'צילומי נשיות ובודואר' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={feminineService} />
  <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-8 md:grid-cols-2 md:gap-12 md:py-12">
    <div>
      <p class="mb-3 font-semibold text-accent">יוליה קורנסקי · חולון ומרכז הארץ</p>
      <h1 class="mb-5 text-4xl font-bold leading-tight md:text-5xl">
        צילומי נשיות ובודואר<br /><span class="text-accent">את, באור שלך.</span>
      </h1>
      <p class="mb-5 text-xl leading-relaxed">
        לא צריך לדעת מה לעשות עם הידיים. גם לא להגיע עם ביטחון של כוכבת קולנוע. נתחיל בשיחה, נמצא אור יפה, ונשאיר מקום
        למבט שקט, לתנועה ולקצת צחוק.
      </p>
      <p class="mb-6">
        פורטרטים בלבוש מלא, אווירה רכה או סשן בודואר אמנותי — נבחר יחד מה מרגיש לך נכון. <strong
          >חבילות החל מ־{femininePackages[0].price} ש״ח.</strong>
      </p>
      <div class="flex flex-wrap gap-3">
        <Button variant="primary" class="w-full" href={feminineWhatsApp()} target="_blank" icon="tabler:brand-whatsapp"
          >בואי נבדוק תאריך</Button
        >
        <Button class="w-full" href="/gallery/feminine">לראות את התמונות</Button>
      </div>
      <p class="mt-5">
        <a href="/pricing/feminine" class="underline underline-offset-4">למחירון ולכל מה שכלול בחבילות</a>
      </p>
    </div>
    <Image
      src={hero.image}
      alt={hero.alt}
      widths={[400, 640, 900, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-2xl object-cover"
    />
  </section>
  <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'סוגי צילומים', href: '/services' },
      { label: 'צילומי נשיות ובודואר' },
    ]}
  />
  <Journey journey={feminineJourney} current="service" />
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="mb-8 text-3xl font-bold">איך נראה סשן איתי?</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">קודם נכיר</h3><p>
          נדבר על התמונות שאת אוהבת, על מה שנעים לך ועל מה שפחות. נבחר מקום ולבוש, ונתאם ציפיות לפני שהמצלמה יוצאת
          מהתיק.
        </p>
      </div>
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">בצילום, אני איתך</h3><p>
          אכוון אותך בתנוחות ובתנועה ואעזור לך למצוא את הקצב שלך. אפשר להרגיש קצת נבוכה בהתחלה. גם לחיוך לוקח לפעמים רגע
          להתחמם.
        </p>
      </div>
      <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
        <h3 class="mb-3 text-xl font-bold">ואחר כך, האוסף שלך</h3><p>
          תקבלי תמונות בעריכה מוקפדת ומלאה בגלריה דיגיטלית להורדה, עד 14 ימי עסקים מיום הצילום. הכמות תלויה בחבילה
          שבחרת.
        </p>
      </div>
    </div>
    <p class="mt-6"><a href="/about" class="underline">קצת עליי ועל הדרך שבה אני מצלמת</a></p>
  </section>
  <ImageSection image={feminineGalleryImages[0].image} alt={feminineGalleryImages[0].alt}>
    <h2 class="text-3xl font-bold">צילומי נשיות או בודואר — מה ההבדל?</h2>
    <p>
      צילומי נשיות הם סשן אישי שמתמקד בך: בהבעה, בתנועה ובאופן שבו תרצי לראות את עצמך. אפשר ליצור דיוקן עדין, תמונה עם
      נוכחות דרמטית או רגע חופשי בחוץ.
    </p>
    <p>
      בודואר הוא כיוון אינטימי יותר, שבו משחקים באור, בבד ובאווירה. הוא יכול להיות חושני בלי עירום, ואפשר לבחור גם בלבוש
      מלא. אין רשימת חובה של בגדים או תנוחות.
    </p>
    <p>
      רמת החשיפה והגבולות שלך הם חלק מהשיחה לפני הסשן. גם במהלך הצילום אפשר לומר שמשהו פחות מתאים, לעצור או לבחור כיוון
      אחר.
    </p>
  </ImageSection>
  <ImageSection image={feminineGalleryImages[1].image} alt={feminineGalleryImages[1].alt} imageFirst={false}>
    <h2 class="text-3xl font-bold">בחוץ או בסטודיו: איפה נוח לך להיות?</h2>
    <p>
      אני מצלמת בחולון ובמרכז. צילומי נשיות בטבע מאפשרים תנועה, אור שמש וקצת רוח בשיער. נבחר לוקיישן לפי העונה, הסגנון
      והנוחות שלך.
    </p>
    <p>
      סטודיו מאפשר רקע ותאורה מתוכננים, ומתאים גם למי שמעדיפה סביבה סגורה. צילום בסטודיו אפשרי בתוספת תשלום ובתיאום
      מראש. אם חשובה לך פרטיות במקום הצילום, נדבר על כך כבר בבחירת הלוקיישן.
    </p>
    <a href="/gallery/feminine" class="inline-block font-semibold underline">לגלריית הפורטרטים בסטודיו ובחוץ</a>
  </ImageSection>
  <section id="preparation" class="scroll-mt-28 mx-auto max-w-4xl space-y-5 px-4 py-12">
    <h2 class="text-3xl font-bold">מה לובשים לצילומי נשיות?</h2>
    <p>
      מתחילים מבגד שאת אוהבת על עצמך: ג׳ינס וחולצה, שמלה, ז׳קט או בד רך. אם בחרת בודואר, אפשר לחשוב יחד גם על פריטים
      אינטימיים שנוח לך בהם. אין צורך לצאת למסע קניות כדי להרגיש את.
    </p>
    <ul class="list-disc space-y-2 ps-6">
      <li>בדקי שנוח לך לשבת ולנוע בבגד, ולא רק לעמוד מול המראה.</li>
      <li>שלחי לי מראש התלבטויות בין צבעים או פריטים; ההכוונה ללבוש כלולה בחבילה.</li>
      <li>הביאי מים ונעליים נוחות למעבר בין נקודות הצילום בחוץ.</li>
      <li>אפשר לבחור תמונה מהגלריה כהשראה. לא צריך לשחזר אותה, רק להבין מה אהבת.</li>
    </ul>
    <p>מספר התלבושות והזמן מתוכננים בהתאם לחבילה. בפרימיום אפשר לשלב עד שתי תלבושות והפסקות לפי הצורך.</p>
  </section>
  <section class="mx-auto max-w-4xl space-y-4 px-4 py-12 text-center">
    <h2 class="text-3xl font-bold">כמה עולה הרגע שלך מול המצלמה?</h2>
    <p>
      חבילות צילומי החוץ נעות בין {femininePackages[0].price} ל־{femininePackages[2].price} ש״ח. כולן כוללות הכוונה, תמונות
      בעריכה מלאה וגלריה דיגיטלית. במחירון תמצאי את מספר התמונות, משך הצילום המשוער ותנאי ההזמנה. סטודיו בתוספת תשלום.
    </p>
    <Button href="/pricing/feminine">להשוואת חבילות צילומי נשיות ובודואר</Button>
  </section>
  <FAQs
    title="עוד כמה דברים שאולי רצית לשאול"
    columns={2}
    items={[
      {
        title: 'זה מתאים גם אם זו הפעם הראשונה שלי?',
        description: 'כן. אין צורך בניסיון מול מצלמה. אני מסבירה ומכוונת לאורך הסשן ומשאירה מקום גם לרגעים טבעיים.',
      },
      {
        title: 'חייבים להצטלם בעירום?',
        description:
          'לא. אפשר להצטלם בלבוש מלא או לבחור סגנון אינטימי יותר. הלבוש, התנוחות ורמת החשיפה נבחרים לפי הרצון והגבולות שלך.',
      },
      {
        title: 'צריך סיבה מיוחדת לקבוע צילומי נשיות?',
        description:
          'אפשר לציין יום הולדת, שינוי בחיים או פשוט לפנות זמן לעצמך. לא צריך לחכות לאירוע מיוחד כדי לרצות תמונות שאת אוהבת.',
      },
      {
        title: 'מה כדאי לברר לגבי פרטיות?',
        description:
          'ספרי לי מראש מה חשוב לך בנוגע למקום הצילום, למי שנוכח בו ולשימוש בתמונות. נדבר על הפרטים לפני קביעת הסשן כדי שתגיעי עם ציפיות ברורות.',
      },
    ]}
  />
  <Journey journey={feminineJourney} current="service" cta />
</Layout>
