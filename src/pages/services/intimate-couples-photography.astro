---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ImageSection from '~/components/photoshoots/ImageSection.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import SessionFacts from '~/components/photoshoots/SessionFacts.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import {
  intimateJourney,
  intimatePackages,
  intimateWhatsApp,
  intimateService,
  intimateFacts,
} from '~/lib/couples-intimate';
import { couplesHeroImage as hero, couplesFeaturedImages } from '~/lib/couples-gallery';
const metadata = {
  title: 'צילומי זוגיות אינטימיים וחושניים | יוליה קורנסקי',
  description: `צילומי זוגיות אינטימיים בחולון ובמרכז, בקצב ובגבולות שלכם. הכוונה אישית, תשומת לב לפרטיות וללא חובה לעירום. חבילות החל מ־${intimatePackages[0].price} ש״ח.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/couples_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/services', name: 'סוגי צילומים' },
  { url: '/services/intimate-couples-photography', name: 'צילומי זוגיות אינטימיים' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={intimateService} />
  <LeadTracking service="couples_intimate">
    <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-8 md:grid-cols-2 md:gap-12 md:py-12">
      <div>
        <p class="mb-3 font-semibold text-accent">יוליה קורנסקי · חולון ומרכז הארץ</p>
        <h1 class="mb-5 text-4xl font-bold leading-tight md:text-5xl">
          צילומי זוגיות אינטימיים<br /><span class="text-accent">קרוב, בקצב שלכם.</span>
        </h1>
        <p class="mb-5 text-xl leading-relaxed">
          מבט שרק אתם מבינים, חיבוק שמתארך, צחוק קטן באמצע. זמן להיות יחד וליצור תמונות שמרגישות כמו הקשר שלכם.
        </p>
        <p class="mb-6">
          לא צריך לדעת להצטלם, ואין חובה לעירום. נבחר יחד את הלבוש, המקום ורמת הקרבה שנעימים לשניכם. <strong
            >חבילות החל מ־{intimatePackages[0].price} ש״ח.</strong
          >
        </p>
        <div class="flex flex-wrap gap-3">
          <Button
            class="w-full"
            variant="primary"
            href={intimateWhatsApp()}
            target="_blank"
            icon="tabler:brand-whatsapp"
            data-lead-source="intimate-hero">נדבר ונבדוק אם זה מתאים לכם</Button
          >
          <Button class="w-full" href="/pricing/couples-intimate">למחירון ולחבילות</Button>
        </div>
        <p class="mt-5 text-sm">הנוחות והגבולות של שניכם מלווים כל שלב בסשן.</p>
      </div>
      <figure>
        <Image
          src={hero.image}
          alt={hero.alt}
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-2xl object-cover"
        />
        <figcaption class="mt-3 text-sm text-muted">
          מתוך גלריית הזוגיות הרגילה — להיכרות עם סגנון הצילום שלי.
        </figcaption>
      </figure>
    </section>
    <Breadcrumbs
      items={[
        { label: 'דף הבית', href: '/' },
        { label: 'סוגי צילומים', href: '/services' },
        { label: 'צילומי זוגיות אינטימיים' },
      ]}
    />
    <Journey journey={intimateJourney} current="service" />
    <SessionFacts title="לפני שמחליטים — הפרטים בקצרה" facts={intimateFacts} />
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="mb-8 text-3xl font-bold">סשן זוגי בקצב שלכם</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">קודם מדברים</h3><p>
            מה הייתם רוצים לזכור מהתקופה הזאת? איזה סגנון אהבתם, ומה פחות מתאים? מתאמים ציפיות וגבולות עם שניכם ובוחרים
            מקום ולבוש.
          </p>
        </div>
        <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">מתחילים פשוט</h3><p>
            לא מגיעים ישר לרגע הכי חשוף. מתחילים בנוכחות יחד, בתנועה ובמבט. אני מכוונת בעדינות, ואתם יכולים לבקש הפסקה,
            לשנות כיוון או לוותר על תמונה.
          </p>
        </div>
        <div class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">האוסף נשאר שלכם</h3><p>
            אחרי הצילום אני עורכת את התמונות. תקבלו גלריה דיגיטלית פרטית להורדה עד 14 ימי עסקים, עם כמות התמונות שבחבילה
            שבחרתם.
          </p>
        </div>
      </div>
      <p class="mt-6"><a href="/about" class="underline">להכיר אותי לפני שנפגשים — יוליה, הצלמת שלכם</a></p>
    </section>
    <ImageSection image={couplesFeaturedImages[1].image} alt={couplesFeaturedImages[1].alt}>
      <h2 class="text-3xl font-bold">מה הופך צילום זוגי לאינטימי?</h2>
      <p>
        האינטימיות יכולה להיות במבט, במגע או בדרך שבה אתם נשענים זה על זו. אפשר להישאר בלבוש מלא וליצור סשן עדין
        ורומנטי, או לבחור כיוון חושני ואמנותי יותר.
      </p>
      <p>
        אם אתם מחפשים צילומי בודואר זוגי, נדבר על האור, הלבוש והאווירה שאתם מדמיינים. רמת החשיפה אינה יעד שצריך להגיע
        אליו, והיא לא משתנה לפי מחיר החבילה.
      </p>
      <p>
        רוצים בעיקר טיול מצולם ותמונות זוגיות בחוץ? <a
          class="font-semibold underline"
          href="/services/couples-photography">הכירו גם את צילומי הזוגיות הרגילים</a
        >.
      </p>
    </ImageSection>
    <section id="privacy" class="scroll-mt-28 mx-auto max-w-4xl space-y-5 px-4 py-12">
      <h2 class="text-3xl font-bold">פרטיות ודיסקרטיות בצילומים</h2>
      <p>
        לפני הסשן נדבר על מה שחשוב לכם בנוגע לפרטיות, על הגבולות של כל אחד ועל האווירה שתרצו ליצור. אפשר לשאול גם את
        השאלות שקצת מביך לשאול — המטרה היא שתגיעו כשאתם יודעים למה לצפות ומרגישים בנוח איתי.
      </p>
      <p>
        פרטיות חשובה גם בזמן הצילום. לפני שבוחרים לוקיישן נדבר על מי עשוי להיות במקום, על נוחות בהחלפת בגדים ועל המרחב
        שתרצו לעצמכם. מקום ציבורי בחוץ אינו מרחב פרטי; אם זה חשוב לכם, נתכנן מקום סגור ומתאים.
      </p>
      <Button href="/gallery/couples">להיכרות עם הסגנון בגלריית הזוגיות</Button>
    </section>
    <ImageSection image={couplesFeaturedImages[2].image} alt={couplesFeaturedImages[2].alt} imageFirst={false}>
      <h2 class="text-3xl font-bold">סטודיו, חוץ או מרחב פרטי?</h2>
      <p>
        אני מצלמת בחולון ובמרכז הארץ. בחוץ אפשר לשלב אור טבעי ונוף; בבית או במרחב פרטי אפשר לתכנן אווירה אישית יותר.
        סטודיו מתאים למי שמעדיפים רקע ותאורה מתוכננים.
      </p>
      <p>
        הבחירה נעשית מראש לפי האווירה ורמת הפרטיות שנחוצות לשניכם. אם נדרשת שכירת סטודיו או מקום אחר, נברר את העלות לפני
        שסוגרים.
      </p>
      <h3 class="text-xl font-bold">ומה לובשים?</h3>
      <p>
        התחילו מבגדים שנוח לכם לשבת ולנוע בהם ושאתם אוהבים על עצמכם. אפשר לשלוח לי התלבטויות ולקבל הכוונה. לא צריך לקנות
        מלתחה חדשה או לבחור לבוש חשוף כדי להגיע.
      </p>
    </ImageSection>
    <section class="mx-auto max-w-4xl space-y-4 px-4 py-12 text-center">
      <h2 class="text-3xl font-bold">מחיר צילומי זוגיות אינטימיים</h2>
      <p>
        שלוש חבילות ב־{intimatePackages.map((p) => p.price).join(', ')} ש״ח. בכל חבילה: הכנה אישית, הכוונה בצילום, תמונות
        בעריכה מלאה וגלריה דיגיטלית פרטית. בוחרים לפי כמות התמונות והזמן שתרצו לפנות לעצמכם.
      </p>
      <Button href="/pricing/couples-intimate">להשוואת החבילות ולתנאי ההזמנה</Button>
    </section>
    <FAQs
      title="מה עוד הייתם רוצים לדעת?"
      columns={2}
      items={[
        {
          title: 'האם חייבים להצטלם בעירום?',
          description:
            'לא. אפשר להצטלם בלבוש מלא. הגבולות, התנוחות ורמת החשיפה נקבעים לפי הנוחות של שניכם, ואפשר לשנות כיוון גם במהלך הסשן.',
        },
        {
          title: 'מה אם אחד מאיתנו מתלהב והשני מהסס?',
          description:
            'מתחילים בשיחה, בלי להתחייב לצילום. כדאי שכל אחד יגיד מה מסקרן אותו ומה לא מתאים לו. קובעים רק כששניכם רוצים, ובוחרים את מה שנעים לשניכם.',
        },
        {
          title: 'אנחנו לא יודעים להצטלם. זה מתאים לנו?',
          description: 'כן. ההכוונה כלולה בכל חבילה. אין צורך להכין פוזות; נתחיל בפעולות פשוטות ובתנועה טבעית יחד.',
        },
        {
          title: 'אפשר לתכנן את זה כמתנת יום נישואים?',
          description:
            'אפשר להציע זמן זוגי משותף ולבחור יחד את הסשן. כדאי לדבר על הרעיון מראש, כדי שהצילום ורמת האינטימיות יהיו רצון משותף.',
        },
        {
          title: 'אפשר לראות את סגנון הצילום לפני שמחליטים?',
          description:
            'כן. גלריית הזוגיות משותפת לשני השירותים ומאפשרת להכיר את סגנון הצילום שלי. אפשר לספר לי מה אהבתם בה, ונחשוב יחד איך להתאים את הסשן אליכם.',
        },
        {
          title: 'איפה מתקיים הסשן?',
          description:
            'בחוץ, בסטודיו או במרחב פרטי בתיאום מראש בחולון ובמרכז. בוחרים יחד לפי האווירה והפרטיות הרצויות, ומבררים מראש עלויות לוקיישן אם נדרשות.',
        },
      ]}
    />
    <Journey journey={intimateJourney} current="service" cta />
  </LeadTracking>
</Layout>
