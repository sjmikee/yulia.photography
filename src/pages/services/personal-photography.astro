---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ImageSection from '~/components/photoshoots/ImageSection.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import SessionFacts from '~/components/photoshoots/SessionFacts.astro';
import ServiceSchema from '~/components/photoshoots/ServiceSchema.astro';
import LeadTracking from '~/components/photoshoots/LeadTracking.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { personalJourney, personalPackages, personalWhatsApp, personalService, personalFacts } from '~/lib/personal';
import { personalHeroImage as hero, personalFeaturedImages } from '~/lib/personal-gallery';
const metadata = {
  title: 'צילום אישי מקצועי, בוק אישי ופורטרטים | יוליה קורנסקי',
  description: `צילום אישי לנשים ולגברים במרכז: בוק אישי, פורטרטים ותמונות פרופיל עם הכוונה לעמידה, ללבוש ולמבט. חבילות החל מ־${personalPackages[0].price} ש״ח. גם בלי ניסיון מול המצלמה.`,
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: `~/assets/solo_gallery/${hero.filename}`,
        width: hero.image.width,
        height: hero.image.height,
        alt: hero.alt,
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/services', name: 'סוגי צילומים' },
  { url: '/services/personal-photography', name: 'בוק אישי' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <ServiceSchema service={personalService} />
  <LeadTracking service="personal">
    <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-8 md:grid-cols-2 md:gap-12 md:py-12">
      <div>
        <p class="mb-3 font-semibold text-accent">יוליה קורנסקי · צילום אישי במרכז הארץ</p>
        <h1 class="mb-5 text-4xl font-bold leading-tight md:text-5xl">
          צילום אישי מקצועי<br /><span class="text-accent">כל הפריים שלך.</span>
        </h1>
        <p class="mb-5 text-xl leading-relaxed">
          בוק אישי, תמונת פרופיל חדשה או מזכרת ממי שהפכת להיות. ניצור פורטרטים עם אופי, באור מחמיא ובקצב שלך.
        </p>
        <p class="mb-6">
          אני מביאה את העין המקצועית, את האור ואת ההכוונה. שלך נשאר להביא את האופי. יחד נבחר לבוש ולוקיישן שיתנו לו
          מקום. <strong>חבילות החל מ־{personalPackages[0].price} ש״ח.</strong>
        </p>
        <div class="flex flex-wrap gap-3">
          <Button
            class="w-full"
            variant="primary"
            href={personalWhatsApp()}
            target="_blank"
            icon="tabler:brand-whatsapp"
            data-lead-source="personal-service-hero">בואו נמצא את הפריים שלך</Button
          >
          <Button class="w-full" href="/pricing/personal">למחירון ולחבילות</Button>
        </div>
        <p class="mt-5 text-sm">אפשר להתחיל בשאלה. אין צורך להגיע עם קונספט או לבחור חבילה מראש.</p>
      </div>
      <Image
        src={hero.image}
        alt={hero.alt}
        widths={[400, 640, 900, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-2xl object-cover"
      />
    </section>
    <Breadcrumbs
      items={[{ label: 'דף הבית', href: '/' }, { label: 'סוגי צילומים', href: '/services' }, { label: 'בוק אישי' }]}
    />
    <Journey journey={personalJourney} current="service" />
    <SessionFacts title="צילומי בוק אישי — הפרטים בקצרה" facts={personalFacts} />
    <section class="mx-auto max-w-5xl space-y-5 px-4 py-10">
      <h2 class="text-3xl font-bold">אנשים שונים. מקום לאופי של כל אחד.</h2>
      <p>
        אור רך ליד הים, רחוב עם אופי או פורטרט בסטודיו. הנה טעימה מהסגנון שלי — אפשר לשלוח לי תמונה שאהבת ולספר מה תפס
        אותך בה.
      </p>
      <Gallery images={personalFeaturedImages} />
      <Button href="/gallery/solo">לגלריית צילומי הבוק האישי</Button>
    </section>
    <ImageSection image={personalFeaturedImages[2].image} alt={personalFeaturedImages[2].alt}>
      <h2 class="text-3xl font-bold">״אני לא פוטוגני״ זה לא תנאי קבלה</h2>
      <p>
        אין צורך לדעת לדגמן. נתחיל בשיחה ובתנועה, נמצא את הזוויות שמתאימות לך וננסה כמה כיוונים. יש מקום למבט רציני,
        לחיוך קטן וגם לרגע ספונטני שמשנה את כל הפריים.
      </p>
      <p>
        אני מתכננת את האור, הרקע וזווית הצילום לפי האדם שמולי. כך אפשר ליצור תמונות מחמיאות ולתת מקום גם לשקט, גם לחיוך
        וגם לצד השובב שלך.
      </p>
      <p><a href="/about" class="underline">להכיר אותי לפני שנפגשים — יוליה, הצלמת שלך</a></p>
    </ImageSection>
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="mb-8 text-3xl font-bold">למי מתאים צילום אישי?</h2>
      <div class="grid gap-6 md:grid-cols-3">
        <article class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">פשוט בשבילך</h3><p>
            יום הולדת, התחלה חדשה או רצון לתמונות שאוהבים באמת. בוק אישי לנשים ולגברים שרוצים לעצור רגע ולתעד את עצמם,
            בלי לחכות לאירוע חגיגי.
          </p>
        </article>
        <article class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">לפרופיל עם אישיות</h3><p>
            לרשתות החברתיות או לאתרי היכרויות: פורטרטים שמראים אותך בבירור ונותנים מקום לאופי שלך. נתכנן מראש את האווירה
            והשימוש בתמונות. הסלפי מהמעלית יכול לנוח.
          </p>
        </article>
        <article class="rounded-2xl bg-gray-50 p-6 dark:bg-slate-800">
          <h3 class="mb-3 text-xl font-bold">לנוכחות מקצועית</h3><p>
            תמונה ללינקדאין, לעמוד ״אודות״ או לפרופיל של עצמאים ויוצרים. נדבר על המסר, הלבוש והרקע. אם יש דרישות למידות,
            לחיתוך או לשימוש מסחרי, נתאם אותן לפני ההזמנה.
          </p>
        </article>
      </div>
    </section>
    <ImageSection image={personalFeaturedImages[1].image} alt={personalFeaturedImages[1].alt} imageFirst={false}>
      <h2 class="text-3xl font-bold">איפה מצטלמים ומה לובשים?</h2>
      <p>
        הצילומים מתקיימים בעיקר בחוץ במרכז הארץ. ים נותן מרחב ותנועה, טבע מוסיף צבע עונתי, ורחוב יכול להכניס אופי
        אורבני. נבחר מקום לפי הסגנון שלך, העונה ושעת האור.
      </p>
      <p>
        אפשר לתאם גם סטודיו. אם נדרשת שכירת מקום, נברר את העלות לפני שסוגרים. בבחירת הלבוש נתחיל מפריטים שנעים לך בהם,
        ונכוון צבעים וגזרות לרקע ולמטרת הצילום. אין צורך לקנות ארון חדש בשביל פריים אחד.
      </p>
      <p>
        בחבילת הפרימיום אפשר לשלב עד שתי תלבושות. איפור ושיער אינם מפורטים כחלק מהחבילות; אם הם חשובים לך, נדבר על כך
        מראש.
      </p>
    </ImageSection>
    <section class="mx-auto max-w-4xl space-y-5 px-4 py-12">
      <h2 class="text-3xl font-bold">מהשיחה הראשונה לתמונה החדשה שלך</h2>
      <ol class="list-decimal space-y-4 ps-6">
        <li>
          <strong>מגדירים כיוון.</strong> מספרים לי למה התמונות מיועדות ומה נעים לך מול מצלמה. בוחרים חבילה, לבוש, מקום ותאריך.
        </li>
        <li><strong>נפגשים ומתחילים לזוז.</strong> 45 דקות עד כשעתיים, בהתאם לחבילה, עם הכוונה לאורך הצילום.</li>
        <li>
          <strong>מקבלים את האוסף.</strong> התמונות בעריכה מוקפדת ומלאה נמסרות עד 14 ימי עסקים, בגלריה דיגיטלית באיכות גבוהה
          להורדה.
        </li>
      </ol>
      <Button href="/pricing/personal"
        >חבילות ב־{personalPackages.map((p) => p.price).join(', ')} ש״ח — להשוואה ולתנאי ההזמנה</Button
      >
    </section>
    <FAQs
      title="שאלות נפוצות על צילום אישי"
      columns={2}
      items={[
        {
          title: 'האם צריך ניסיון או לדעת לעשות פוזות?',
          description:
            'לא. הכוונה לפני הצילום ובמהלכו כלולה בכל חבילה. אני מלווה את הצילום בהנחיות ברורות, ומתאימה את הקצב והסגנון לכל אדם.',
        },
        {
          title: 'האם הסשן מתאים לנשים ולגברים?',
          description:
            'כן. הסגנון נבנה לפי האדם, מטרת התמונות והאווירה שאוהבים. אפשר לבחור בוק אישי יצירתי, פורטרטים רגועים או תמונות פרופיל.',
        },
        {
          title: 'אפשר להצטלם ללינקדאין או לאתרי היכרויות?',
          description:
            'כן, כדאי לציין מראש היכן התמונות יופיעו. נתכנן את הלבוש, הרקע וסוגי הפריימים בהתאם. אם יש דרישות מקצועיות מסוימות, נבדוק אותן לפני שסוגרים.',
        },
        {
          title: 'מה ההבדל בין בוק אישי לצילומי נשיות?',
          description:
            'בוק אישי מתמקד בפורטרטים, בסגנון האישי ובשימושים שלך בתמונות. צילומי נשיות ובודואר מתמקדים בביטוי נשי וחושני. אפשר להתייעץ איתי לגבי הכיוון שנעים לך.',
        },
        {
          title: 'אפשר לקנות סשן במתנה?',
          description:
            'כן. אפשר לפנות לגבי שובר מתנה לבוק אישי. כדאי לתת למי שמקבל את המתנה לבחור את התאריך ואת הסגנון שנוח לו או לה.',
        },
        {
          title: 'כמה עולה בוק אישי ומתי מקבלים תמונות?',
          description: `החבילות עולות ${personalPackages.map((p) => p.price).join(', ')} ש״ח, בהתאם למשך הצילום ולכמות התמונות. בכל חבילה כלולות הכוונה, עריכה מלאה וגלריה דיגיטלית. המסירה עד 14 ימי עסקים מיום הצילום.`,
        },
      ]}
    />
    <p class="mx-auto max-w-4xl px-4 text-center">
      לכיוון נשי וחושני יותר: <a class="underline" href="/services/feminine-photography">צילומי נשיות ובודואר</a>.
    </p>
    <Journey journey={personalJourney} current="service" cta />
  </LeadTracking>
</Layout>
