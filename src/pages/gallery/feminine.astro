---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import Gallery from '~/components/photoshoots/Gallery.astro';
import Journey from '~/components/photoshoots/Journey.astro';
import Button from '~/components/ui/Button.astro';
import { feminineJourney, femininePackages } from '~/lib/feminine';
import { feminineGalleryImages } from '~/lib/feminine-gallery';
import preview from '~/assets/feminine_gallery/feminine_pricing.jpg';
const metadata = {
  title: 'גלריית צילומי נשיות — פורטרטים בסטודיו ובטבע | יוליה קורנסקי',
  description:
    'גלריית צילומי נשיות של יוליה קורנסקי: פורטרטים בלבוש מלא, אור טבעי, סטודיו ושחור לבן. מצאי את האווירה שלך והכירי את חבילות הצילום בחולון ובמרכז.',
  ignoreTitleTemplate: true,
  openGraph: {
    images: [
      {
        url: '~/assets/feminine_gallery/feminine_pricing.jpg',
        width: preview.width,
        height: preview.height,
        alt: 'צילום נשיות של יוליה קורנסקי',
      },
    ],
  },
};
const breadcrumbs = [
  { url: '/services/feminine-photography', name: 'צילומי נשיות' },
  { url: '/gallery/feminine', name: 'גלריית צילומי נשיות' },
];
---

<Layout metadata={metadata} richMetadata={metadata} breadcrumbs={breadcrumbs}>
  <section class="mx-auto max-w-4xl px-4 pt-12 pb-6 text-center">
    <p class="mb-3 font-semibold text-accent">יוליה קורנסקי · רגעים מול המצלמה</p>
    <h1 class="mb-5 text-4xl font-bold md:text-5xl">גלריית צילומי נשיות</h1>
    <p class="mb-5 text-xl leading-relaxed">
      מבט קרוב בשחור לבן, אור בין העצים וקצת צבע בסטודיו. כל אחת מביאה לפריים משהו משלה — וזה בדיוק מה שמעניין בו.
    </p>
    <Button href="/pricing/feminine">לחבילות הצילום — החל מ־{femininePackages[0].price} ש״ח</Button>
  </section>
  <Breadcrumbs
    items={[
      { label: 'דף הבית', href: '/' },
      { label: 'צילומי נשיות', href: '/services/feminine-photography' },
      { label: 'גלריה' },
    ]}
  />
  <Journey journey={feminineJourney} current="gallery" />
  <section class="mx-auto max-w-6xl px-4 py-8" aria-label="גלריית פורטרטים נשיים בסטודיו ובחוץ">
    <p class="mb-5 text-center text-sm">לחצי על תמונה להגדלה ולדפדוף בגלריה.</p>
    <Gallery images={feminineGalleryImages} />
  </section>
  <Journey journey={feminineJourney} current="gallery" cta />
</Layout>
