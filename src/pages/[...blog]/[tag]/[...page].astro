---
import { localeFromPath } from '~/i18n/routes';
const locale = localeFromPath(Astro.url.pathname);
const isRussian = locale === 'ru';
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, getStaticPathsBlogTag } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import WhatssapCallToAction from '~/components/widgets/WhatssapCallToAction.astro';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `${isRussian ? 'Статьи по теме' : 'פוסטים לפי תג'}: ${tag.title}${currentPage > 1 ? ` — ${isRussian ? 'Страница' : 'עמוד'} ${currentPage}` : ''}`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>{isRussian ? 'Тема' : 'תג'}: {tag.title}</Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
  <WhatssapCallToAction
    title={isRussian ? 'Хотите обсудить съёмку?' : undefined}
    subtitle={isRussian ? 'Напишите мне — помогу выбрать подходящий вариант.' : undefined}
    href={isRussian
      ? 'https://wa.me/972525836940?text=' +
        encodeURIComponent('Здравствуйте, Юлия! Прочитали вашу статью и хотим обсудить фотосессию.')
      : undefined}
  />
</Layout>
